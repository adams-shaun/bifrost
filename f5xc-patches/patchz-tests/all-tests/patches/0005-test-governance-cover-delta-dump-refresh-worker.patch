+func TestDumpRateLimits_NegativeDelta_RebaseOnly(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	rl := seedRateLimit(t, cs, "rl1", 10000, 500, 1000, 50)
+	gs := newStoreWithFakeCS(t, cs, nil, []configstoreTables.TableRateLimit{rl})
+
+	// Force a local reset on the token side only — request counter still
+	// matches baseline so request delta is zero (not negative).
+	raw, _ := gs.rateLimits.Load("rl1")
+	clone := *raw.(*configstoreTables.TableRateLimit)
+	clone.TokenCurrentUsage = 10
+	clone.RequestCurrentUsage = 50
