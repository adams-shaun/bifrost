+package governance
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/maximhq/bifrost/framework/configstore"
+	configstoreTables "github.com/maximhq/bifrost/framework/configstore/tables"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+// =============================================================================
+// Test fixture: a minimal ConfigStore backed by an in-memory SQLite DB.
+//
+// Embeds the configstore.ConfigStore interface so anything unimplemented panics
+// (the patched dump/refresh paths exercise only GetBudgets, GetRateLimits,
+// ExecuteTransaction). Two LocalGovernanceStore instances wired to the same
+// fakeConfigStore faithfully simulate two pods sharing one Postgres / SQLite.
+// =============================================================================
+
+type fakeConfigStore struct {
+	configstore.ConfigStore // panics on any method we don't override
+
+	db *gorm.DB
+
+	mu      sync.Mutex
+	txCount int
+
+	// Atomic so concurrent goroutines can flip it.
+	deadlockNext atomic.Bool
+	// errorNext lets a single call return an arbitrary error instead of
+	// running the transaction. The error message is plain (no "deadlock"
+	// substring) so it surfaces as a real failure path rather than the
+	// retry-next-tick path.
+	errorNext atomic.Bool
+	errorMsg  string
+}
+
+func newFakeConfigStore(t *testing.T) *fakeConfigStore {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{
+		Logger: gormlogger.Default.LogMode(gormlogger.Silent),
+	})
+	require.NoError(t, err, "open sqlite")
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	// One connection so the in-memory DB is shared across all goroutines.
+	sqlDB.SetMaxOpenConns(1)
+	sqlDB.SetMaxIdleConns(1)
+
+	require.NoError(t, db.AutoMigrate(
+		&configstoreTables.TableBudget{},
+		&configstoreTables.TableRateLimit{},
+	), "automigrate")
+
+	return &fakeConfigStore{db: db}
+}
+
+func (f *fakeConfigStore) GetBudgets(ctx context.Context) ([]configstoreTables.TableBudget, error) {
+	var out []configstoreTables.TableBudget
+	if err := f.db.WithContext(ctx).Find(&out).Error; err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func (f *fakeConfigStore) GetRateLimits(ctx context.Context) ([]configstoreTables.TableRateLimit, error) {
+	var out []configstoreTables.TableRateLimit
+	if err := f.db.WithContext(ctx).Find(&out).Error; err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func (f *fakeConfigStore) ExecuteTransaction(ctx context.Context, fn func(*gorm.DB) error) error {
+	if f.errorNext.Swap(false) {
+		msg := f.errorMsg
+		if msg == "" {
+			msg = "fake config store error"
+		}
+		return errors.New(msg)
+	}
+	if f.deadlockNext.Swap(false) {
+		// Postgres-style SQLSTATE the patched code recognises.
+		return errors.New("pq: deadlock detected (SQLSTATE 40P01)")
+	}
+	f.mu.Lock()
+	f.txCount++
+	f.mu.Unlock()
+	return f.db.WithContext(ctx).Transaction(fn)
+}
+
+func (f *fakeConfigStore) TxCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.txCount
+}
+
+func (f *fakeConfigStore) seedBudget(t *testing.T, b *configstoreTables.TableBudget) {
+	t.Helper()
+	require.NoError(t, f.db.Create(b).Error)
+}
+
+func (f *fakeConfigStore) seedRateLimit(t *testing.T, r *configstoreTables.TableRateLimit) {
+	t.Helper()
+	require.NoError(t, f.db.Create(r).Error)
+}
+
+func (f *fakeConfigStore) dbBudget(t *testing.T, id string) configstoreTables.TableBudget {
+	t.Helper()
+	var b configstoreTables.TableBudget
+	require.NoError(t, f.db.First(&b, "id = ?", id).Error)
+	return b
+}
+
+func (f *fakeConfigStore) dbRateLimit(t *testing.T, id string) configstoreTables.TableRateLimit {
+	t.Helper()
+	var r configstoreTables.TableRateLimit
+	require.NoError(t, f.db.First(&r, "id = ?", id).Error)
+	return r
+}
+
+// updateDBBudgetUsage simulates a peer pod writing to the DB out-of-band so the
+// next refresh sees a different value than this pod's LastDBUsages tracks.
+func (f *fakeConfigStore) updateDBBudgetUsage(t *testing.T, id string, usage float64) {
+	t.Helper()
+	require.NoError(t, f.db.Model(&configstoreTables.TableBudget{}).
+		Where("id = ?", id).
+		Session(&gorm.Session{SkipHooks: true}).
+		Update("current_usage", usage).Error)
+}
+
+func (f *fakeConfigStore) updateDBBudgetLastReset(t *testing.T, id string, when time.Time) {
+	t.Helper()
+	require.NoError(t, f.db.Model(&configstoreTables.TableBudget{}).
+		Where("id = ?", id).
+		Session(&gorm.Session{SkipHooks: true}).
+		Update("last_reset", when).Error)
+}
+
+func (f *fakeConfigStore) updateDBRateLimitTokenLastReset(t *testing.T, id string, when time.Time) {
+	t.Helper()
+	require.NoError(t, f.db.Model(&configstoreTables.TableRateLimit{}).
+		Where("id = ?", id).
+		Session(&gorm.Session{SkipHooks: true}).
+		Update("token_last_reset", when).Error)
+}
+
+func (f *fakeConfigStore) updateDBRateLimitUsage(t *testing.T, id string, tokenUsage, requestUsage int64) {
+	t.Helper()
+	require.NoError(t, f.db.Model(&configstoreTables.TableRateLimit{}).
+		Where("id = ?", id).
+		Session(&gorm.Session{SkipHooks: true}).
+		Updates(map[string]interface{}{
+			"token_current_usage":   tokenUsage,
+			"request_current_usage": requestUsage,
+		}).Error)
+}
+
+// =============================================================================
+// Wiring helper: build a LocalGovernanceStore seeded from the in-memory config
+// path (so LastDBUsages baselines start equal to the budget's CurrentUsage),
+// then inject the fakeConfigStore so dump/refresh exercise real DB I/O.
+// =============================================================================
+
+func newStoreWithFakeCS(t *testing.T, cs *fakeConfigStore, budgets []configstoreTables.TableBudget, rateLimits []configstoreTables.TableRateLimit) *LocalGovernanceStore {
+	t.Helper()
+	store, err := NewLocalGovernanceStore(context.Background(), NewMockLogger(), nil, &configstore.GovernanceConfig{
+		Budgets:    budgets,
+		RateLimits: rateLimits,
+	}, nil)
+	require.NoError(t, err)
+	store.configStore = cs
+	return store
+}
+
+// budgetWithUsage / rateLimitWithUsage seed both the in-memory store and the DB
+// to the same starting value. After NewLocalGovernanceStore loads from config
+// memory, LastDBUsages* equals CurrentUsage, so the test starts in a "we have
+// fully dumped, no pending delta" state.
+func seedBudget(t *testing.T, cs *fakeConfigStore, id string, maxLimit, currentUsage float64, resetDuration string) configstoreTables.TableBudget {
+	t.Helper()
+	b := configstoreTables.TableBudget{
+		ID:            id,
+		MaxLimit:      maxLimit,
+		CurrentUsage:  currentUsage,
+		ResetDuration: resetDuration,
+		LastReset:     time.Now(),
+	}
+	cs.seedBudget(t, &b)
+	return b
+}
+
+func seedRateLimit(t *testing.T, cs *fakeConfigStore, id string, tokenMax, tokenUsage, requestMax, requestUsage int64) configstoreTables.TableRateLimit {
+	t.Helper()
+	duration := "1m"
+	r := configstoreTables.TableRateLimit{
+		ID:                   id,
+		TokenMaxLimit:        &tokenMax,
+		TokenCurrentUsage:    tokenUsage,
+		TokenResetDuration:   &duration,
+		TokenLastReset:       time.Now(),
+		RequestMaxLimit:      &requestMax,
+		RequestCurrentUsage:  requestUsage,
+		RequestResetDuration: &duration,
+		RequestLastReset:     time.Now(),
+	}
+	cs.seedRateLimit(t, &r)
+	return r
+}
+
+// Helpers to inspect in-memory state from tests.
+
+func budgetCurrentUsage(t *testing.T, gs *LocalGovernanceStore, id string) float64 {
+	t.Helper()
+	raw, ok := gs.budgets.Load(id)
+	require.True(t, ok, "budget %s not in memory", id)
+	return raw.(*configstoreTables.TableBudget).CurrentUsage
+}
+
+func rateLimitCurrentUsage(t *testing.T, gs *LocalGovernanceStore, id string) (int64, int64) {
+	t.Helper()
+	raw, ok := gs.rateLimits.Load(id)
+	require.True(t, ok, "rate limit %s not in memory", id)
+	rl := raw.(*configstoreTables.TableRateLimit)
+	return rl.TokenCurrentUsage, rl.RequestCurrentUsage
+}
+
+func budgetLastDB(gs *LocalGovernanceStore, id string) float64 {
+	gs.LastDBUsagesBudgetsMu.RLock()
+	defer gs.LastDBUsagesBudgetsMu.RUnlock()
+	return gs.LastDBUsagesBudgets[id]
+}
+
+func rateLimitLastDB(gs *LocalGovernanceStore, id string) (int64, int64) {
+	gs.LastDBUsagesRateLimitsTokensMu.RLock()
+	gs.LastDBUsagesRateLimitsRequestsMu.RLock()
+	defer gs.LastDBUsagesRateLimitsTokensMu.RUnlock()
+	defer gs.LastDBUsagesRateLimitsRequestsMu.RUnlock()
+	return gs.LastDBUsagesTokensRateLimits[id], gs.LastDBUsagesRequestsRateLimits[id]
+}
+
