+// DumpBudgets — patch 0001 (SET → INCREMENT)
+// =============================================================================
+
+func TestDumpBudgets_NilConfigStore_NoOp(t *testing.T) {
+	gs, err := NewLocalGovernanceStore(context.Background(), NewMockLogger(), nil, &configstore.GovernanceConfig{
+		Budgets: []configstoreTables.TableBudget{*buildBudgetWithUsage("b1", 100, 25, "1h")},
+	}, nil)
+	require.NoError(t, err)
+	// configStore is nil → dump must return cleanly without panicking.
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+}
+
+func TestDumpBudgets_BasicIncrement(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 0, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	// Simulate request-path activity.
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 30))
+	assert.Equal(t, 30.0, budgetCurrentUsage(t, gs, "b1"))
+	assert.Equal(t, 0.0, budgetLastDB(gs, "b1"), "baseline starts at DB value (0)")
+
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+
+	assert.Equal(t, 30.0, cs.dbBudget(t, "b1").CurrentUsage, "DB incremented by delta")
+	assert.Equal(t, 30.0, budgetLastDB(gs, "b1"), "baseline advanced to snapshot")
+}
+
+func TestDumpBudgets_ZeroDelta_NoOp(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 50, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+	// No bumps. CurrentUsage == LastDB == 50.
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+
+	assert.Equal(t, 50.0, cs.dbBudget(t, "b1").CurrentUsage, "DB unchanged on zero-delta dump")
+	assert.Equal(t, 0, cs.TxCount(), "no transaction issued for zero-delta")
+}
+
+func TestDumpBudgets_NegativeDelta_RebaseOnly(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 80, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+	// Simulate a local reset that moves CU below the baseline (e.g., an
+	// inline Bump-with-reset). We force the in-memory state directly.
+	raw, _ := gs.budgets.Load("b1")
+	clone := *raw.(*configstoreTables.TableBudget)
+	clone.CurrentUsage = 5
+	gs.budgets.Store("b1", &clone)
+
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+
+	assert.Equal(t, 80.0, cs.dbBudget(t, "b1").CurrentUsage, "DB not touched for negative delta")
+	assert.Equal(t, 5.0, budgetLastDB(gs, "b1"), "baseline rebased to snapshot so next delta is just post-reset activity")
+	assert.Equal(t, 0, cs.TxCount(), "no transaction issued when only rebasing")
+}
+
+func TestDumpBudgets_SequentialDumps_OnlyNewDeltas(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 0, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 20))
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, 20.0, cs.dbBudget(t, "b1").CurrentUsage)
+	assert.Equal(t, 20.0, budgetLastDB(gs, "b1"))
+
+	// Second cycle — only the NEW 15 should be incremented.
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 15))
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, 35.0, cs.dbBudget(t, "b1").CurrentUsage, "DB = 20 + 15")
+	assert.Equal(t, 35.0, budgetLastDB(gs, "b1"))
+
+	// Third cycle with no activity — no-op.
+	txBefore := cs.TxCount()
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, txBefore, cs.TxCount(), "zero-delta cycle issues no transaction")
+}
+
+func TestDumpBudgets_TwoPods_ConcurrentDump_NoLoss(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 1000, 0, "1h")
+	podA := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+	podB := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	require.NoError(t, podA.BumpBudgetUsage(context.Background(), "b1", 50))
+	require.NoError(t, podB.BumpBudgetUsage(context.Background(), "b1", 70))
+
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() { defer wg.Done(); _ = podA.DumpBudgets(context.Background()) }()
+	go func() { defer wg.Done(); _ = podB.DumpBudgets(context.Background()) }()
+	wg.Wait()
+
+	assert.Equal(t, 120.0, cs.dbBudget(t, "b1").CurrentUsage,
+		"DB = 50 + 70 (row-level UPDATE serialises both increments — no last-writer-wins loss)")
+}
+
+func TestDumpBudgets_HighContention_ManyPods(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100000, 0, "1h")
+
+	const pods = 8
+	const bumpsPerPod = 25
+	const costPerBump = 1.0
+
+	stores := make([]*LocalGovernanceStore, pods)
+	for i := 0; i < pods; i++ {
+		stores[i] = newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+	}
+
+	var wg sync.WaitGroup
+	for i := 0; i < pods; i++ {
+		wg.Add(1)
+		go func(podIdx int) {
+			defer wg.Done()
+			s := stores[podIdx]
+			for j := 0; j < bumpsPerPod; j++ {
+				_ = s.BumpBudgetUsage(context.Background(), "b1", costPerBump)
+				if j%5 == 0 {
+					_ = s.DumpBudgets(context.Background())
+				}
+			}
+			// Final flush.
+			_ = s.DumpBudgets(context.Background())
+		}(i)
+	}
+	wg.Wait()
+
+	want := float64(pods * bumpsPerPod) // 200
+	assert.Equal(t, want, cs.dbBudget(t, "b1").CurrentUsage,
+		"sum of all per-pod increments equals total work — no contribution lost")
+}
+
+func TestDumpBudgets_Deadlock_PreservesBaseline(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 0, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 40))
+	cs.deadlockNext.Store(true)
+
+	require.NoError(t, gs.DumpBudgets(context.Background()), "deadlock must surface as nil, not error (will retry next cycle)")
+	assert.Equal(t, 0.0, cs.dbBudget(t, "b1").CurrentUsage, "DB unchanged on deadlock")
+	assert.Equal(t, 0.0, budgetLastDB(gs, "b1"), "baseline NOT advanced on deadlock — next dump will retry same delta")
+
+	// Next dump succeeds and writes the same 40.
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, 40.0, cs.dbBudget(t, "b1").CurrentUsage)
+	assert.Equal(t, 40.0, budgetLastDB(gs, "b1"))
+}
+
+func TestDumpBudgets_RealError_ReturnsError(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 0, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 40))
+	cs.errorMsg = "underlying disk failure"
+	cs.errorNext.Store(true)
+
+	err := gs.DumpBudgets(context.Background())
+	require.Error(t, err, "non-deadlock errors must surface to the caller")
+	assert.Contains(t, err.Error(), "underlying disk failure")
+	assert.Equal(t, 0.0, budgetLastDB(gs, "b1"), "baseline NOT advanced on error")
+}
+
+func TestDumpBudgets_MultipleBudgets_SortedByID(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	// IDs intentionally out of order to confirm we sort before issuing
+	// UPDATEs (consistent lock-acquisition order across pods avoids cross-row
+	// deadlock).
+	b1 := seedBudget(t, cs, "zzz", 100, 0, "1h")
+	b2 := seedBudget(t, cs, "aaa", 100, 0, "1h")
+	b3 := seedBudget(t, cs, "mmm", 100, 0, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b1, b2, b3}, nil)
+
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "zzz", 10))
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "aaa", 20))
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "mmm", 30))
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+
+	assert.Equal(t, 10.0, cs.dbBudget(t, "zzz").CurrentUsage)
+	assert.Equal(t, 20.0, cs.dbBudget(t, "aaa").CurrentUsage)
+	assert.Equal(t, 30.0, cs.dbBudget(t, "mmm").CurrentUsage)
+}
