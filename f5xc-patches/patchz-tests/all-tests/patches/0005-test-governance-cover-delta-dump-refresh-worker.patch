+func TestStressDumpRefresh_4Pods_ManyRows_NoLoss(t *testing.T) {
+	if testing.Short() {
+		t.Skip("stress test")
+	}
+	cs := newFakeConfigStore(t)
+
+	const numBudgets = 5
+	budgets := make([]configstoreTables.TableBudget, 0, numBudgets)
+	for i := 0; i < numBudgets; i++ {
+		budgets = append(budgets, seedBudget(t, cs, fmt.Sprintf("b%d", i), 1000000, 0, "1h"))
+	}
+
+	const pods = 4
+	const bumpsPerPod = 100
+	const costPerBump = 0.1
+
+	stores := make([]*LocalGovernanceStore, pods)
+	for i := 0; i < pods; i++ {
+		stores[i] = newStoreWithFakeCS(t, cs, budgets, nil)
+	}
+
+	var wg sync.WaitGroup
+	for podIdx := 0; podIdx < pods; podIdx++ {
+		wg.Add(1)
