+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	// Simulate local reset: usage 0, LastReset = now (newer than DB).
+	raw, _ := gs.budgets.Load("b1")
+	clone := *raw.(*configstoreTables.TableBudget)
+	clone.CurrentUsage = 0
+	localReset := time.Now()
+	clone.LastReset = localReset
+	gs.budgets.Store("b1", &clone)
+
+	require.NoError(t, gs.RefreshAllFromDB(context.Background()))
+
+	raw, _ = gs.budgets.Load("b1")
+	got := raw.(*configstoreTables.TableBudget)
+	assert.Equal(t, 0.0, got.CurrentUsage,
+		"local reset must hold; refresh must not re-inflate from stale dbValue")
+	assert.WithinDuration(t, localReset, got.LastReset, time.Second,
+		"local LastReset preserved")
