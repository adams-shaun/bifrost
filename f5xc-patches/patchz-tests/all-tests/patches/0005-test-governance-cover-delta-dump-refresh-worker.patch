+func TestTwoPods_DumpRefreshLifecycle_ConvergesToClusterTotal(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 1000000, 0, "1h")
+	rl := seedRateLimit(t, cs, "rl1", 1000000, 0, 100000, 0)
+
+	podA := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, []configstoreTables.TableRateLimit{rl})
+	podB := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, []configstoreTables.TableRateLimit{rl})
+
+	const requestsPerPod = 50
+	var wg sync.WaitGroup
+
+	work := func(s *LocalGovernanceStore, costEach float64, tokensEach int64) {
+		defer wg.Done()
+		for i := 0; i < requestsPerPod; i++ {
+			_ = s.BumpBudgetUsage(context.Background(), "b1", costEach)
+			_ = s.BumpRateLimitUsage(context.Background(), "rl1", tokensEach, true, true)
+			if i%5 == 0 {
+				_ = s.DumpBudgets(context.Background())
+				_ = s.DumpRateLimits(context.Background())
+			}
+			if i%17 == 0 {
+				_ = s.RefreshAllFromDB(context.Background())
+			}
+		}
+		_ = s.DumpBudgets(context.Background())
+		_ = s.DumpRateLimits(context.Background())
+	}
+	wg.Add(2)
+	go work(podA, 0.50, 10)
+	go work(podB, 0.75, 15)
+	wg.Wait()
+
+	gotBudget := cs.dbBudget(t, "b1")
+	wantBudget := float64(requestsPerPod)*0.50 + float64(requestsPerPod)*0.75
+	assert.InDelta(t, wantBudget, gotBudget.CurrentUsage, 0.0001,
+		"DB budget = sum of every pod's contributions")
+
+	gotRL := cs.dbRateLimit(t, "rl1")
+	wantTokens := int64(requestsPerPod * (10 + 15))
+	wantRequests := int64(2 * requestsPerPod)
+	assert.Equal(t, wantTokens, gotRL.TokenCurrentUsage)
+	assert.Equal(t, wantRequests, gotRL.RequestCurrentUsage)
+
+	// After a final refresh, each pod's in-memory CurrentUsage equals the
+	// cluster total (no pending delta after the final dump).
+	require.NoError(t, podA.RefreshAllFromDB(context.Background()))
+	require.NoError(t, podB.RefreshAllFromDB(context.Background()))
+	assert.InDelta(t, wantBudget, budgetCurrentUsage(t, podA, "b1"), 0.0001)
+	assert.InDelta(t, wantBudget, budgetCurrentUsage(t, podB, "b1"), 0.0001)
+}
