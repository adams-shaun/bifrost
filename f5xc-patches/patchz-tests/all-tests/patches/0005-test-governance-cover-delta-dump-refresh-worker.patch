+			defer wg.Done()
+			s := stores[idx]
+			for j := 0; j < bumpsPerPod; j++ {
+				bID := fmt.Sprintf("b%d", j%numBudgets)
+				_ = s.BumpBudgetUsage(context.Background(), bID, costPerBump)
+				if j%7 == 0 {
+					_ = s.DumpBudgets(context.Background())
+				}
+				if j%23 == 0 {
+					_ = s.RefreshAllFromDB(context.Background())
+				}
+			}
+			_ = s.DumpBudgets(context.Background())
+		}(podIdx)
+	}
+	wg.Wait()
+
+	var got float64
+	for i := 0; i < numBudgets; i++ {
+		got += cs.dbBudget(t, fmt.Sprintf("b%d", i)).CurrentUsage
+	}
+	want := float64(pods*bumpsPerPod) * costPerBump
