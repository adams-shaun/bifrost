+	raw, _ = gs.rateLimits.Load("rl1")
+	got := raw.(*configstoreTables.TableRateLimit)
+	assert.Equal(t, int64(0), got.TokenCurrentUsage,
+		"token counter must hold its local reset; not re-inflated from stale dbValue")
+	assert.Equal(t, int64(50), got.RequestCurrentUsage,
+		"request counter rebased from DB independently of token-side stale-DB state")
+}
+
+// Locks the B2 ABBA fix: Cleanup stops the resetWorker (close done +
+// wg.Wait) BEFORE running the final flush. If a refresh tick fired during
+// Cleanup with the old code, refreshRateLimitFromDB (requests→tokens) would
+// race the final DumpRateLimits (tokens→requests) on the LastDBUsages*
+// mutexes — a hard hang on shutdown. This test exercises a typical
+// shutdown sequence and asserts it completes within a short timeout.
+func TestCleanup_StopsWorkersBeforeFinalFlush(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 0, "1h")
+	rl := seedRateLimit(t, cs, "rl1", 10000, 0, 1000, 0)
+	gs := newStoreWithFakeCS(t, cs,
+		[]configstoreTables.TableBudget{b},
+		[]configstoreTables.TableRateLimit{rl})
+
+	tracker := NewUsageTracker(context.Background(), gs, nil, cs, NewMockLogger())
+
+	// Generate some in-memory pending state so the final flush has work to do.
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 7))
+	require.NoError(t, gs.BumpRateLimitUsage(context.Background(), "rl1", 11, true, true))
+
+	done := make(chan error, 1)
+	go func() { done <- tracker.Cleanup() }()
+
+	select {
+	case err := <-done:
+		require.NoError(t, err, "Cleanup must return without deadlock")
+	case <-time.After(5 * time.Second):
+		t.Fatal("Cleanup hung — workers likely still running during final flush (B2 regression)")
+	}
+
+	// Final flush actually ran: pending bumps landed in the DB.
+	assert.Equal(t, 7.0, cs.dbBudget(t, "b1").CurrentUsage,
+		"final budget flush should persist pre-shutdown pending delta")
+	assert.Equal(t, int64(11), cs.dbRateLimit(t, "rl1").TokenCurrentUsage,
+		"final rate-limit flush should persist pre-shutdown pending delta")
+}
+
+// Locks the deadlock-rebase-starve self-correction note: when a dump cycle
+// returns early due to deadlock, rebaseOnly rows skip their baseline advance
+// that cycle. The next clean cycle then computes the SAME negative delta,
+// recognizes it as rebaseOnly again, and advances the baseline — so the
+// system self-corrects without operator intervention.
+func TestDumpBudgets_AfterDeadlock_RebaseOnly_SelfCorrects(t *testing.T) {
+	cs := newFakeConfigStore(t)
+	b := seedBudget(t, cs, "b1", 100, 0, "1h")
+	gs := newStoreWithFakeCS(t, cs, []configstoreTables.TableBudget{b}, nil)
+
+	// Bump then dump to establish a baseline of 25.
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 25))
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, 25.0, cs.dbBudget(t, "b1").CurrentUsage)
+
+	// Simulate a local period reset: CurrentUsage goes to 0, baseline stays
+	// 25 → next dump sees a negative delta = rebaseOnly.
+	raw, _ := gs.budgets.Load("b1")
+	clone := *raw.(*configstoreTables.TableBudget)
+	clone.CurrentUsage = 0
+	gs.budgets.Store("b1", &clone)
+
+	// First dump: completes cleanly, baseline advances to 0.
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+
+	// Second dump after a fresh bump: must see ONLY the new delta, not 0+8 vs
+	// the original 25 baseline. If self-correction didn't run on the previous
+	// cycle, this would emit a -17 delta and re-trigger rebaseOnly.
+	require.NoError(t, gs.BumpBudgetUsage(context.Background(), "b1", 8))
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+
+	assert.Equal(t, 33.0, cs.dbBudget(t, "b1").CurrentUsage,
+		"baseline self-corrected after the rebaseOnly cycle: 25 (initial) + 8 (post-reset bump)")
+}
