+// Locks the M2 reset-race guard: when this pod's local LastReset is strictly
+// newer than the DB's (peer hasn't reset the DB row yet), refresh must NOT
+// pull the high dbValue back into CurrentUsage. Otherwise the locally-reset
+// counter gets re-inflated until some pod runs the DB-side reset.
+func TestRefresh_BudgetSkipsRebaseWhen_LocalResetIsNewer(t *testing.T) {
+	cs := newFakeConfigStore(t)
