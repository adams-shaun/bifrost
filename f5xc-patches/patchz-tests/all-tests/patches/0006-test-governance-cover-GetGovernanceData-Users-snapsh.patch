From 27e99389a39a5c1f926fcc39ee9654b8d723f840 Mon Sep 17 00:00:00 2001
From: sadams <s.adams@f5.com>
Date: Mon, 8 Jun 2026 20:39:21 +0000
Subject: [PATCH] test(governance): cover GetGovernanceData Users snapshot fill

Asserts the aggregate snapshot populates Users (RateLimitID + BudgetIDs) from
the gs.users cache and agrees with GetUserGovernance; empty-but-non-nil with no
users. Mutation-checked: removing the fill fails the test.

Ref: https://jira.f5net.com/browse/XC-24346
---
 .../governance/governance_data_users_test.go  | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 plugins/governance/governance_data_users_test.go

diff --git a/plugins/governance/governance_data_users_test.go b/plugins/governance/governance_data_users_test.go
new file mode 100644
index 000000000..19842afc7
--- /dev/null
+++ b/plugins/governance/governance_data_users_test.go
@@ -0,0 +1,68 @@
+package governance
+
+import (
+	"context"
+	"testing"
+
+	configstoreTables "github.com/maximhq/bifrost/framework/configstore/tables"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// GetGovernanceData declares a Users map but historically never populated it —
+// the aggregate snapshot was blind to users even though the gs.users cache is
+// filled on reload. These tests pin the fill: range gs.users into the snapshot's
+// lightweight UserGovernance view (RateLimitID + BudgetIDs). Deleting the fill
+// makes the snapshot's Users map nil and fails TestGetGovernanceData_FillsUsers.
+
+func TestGetGovernanceData_FillsUsersFromCache(t *testing.T) {
+	b := buildBudget("b1", 100, "1h")
+	rl := buildRateLimit("rl1", 10000, 1000)
+
+	// user with a budget + rate limit, and a second bare user (no budgets/RL)
+	u1 := buildUserWithBudget("u1", "alice", b)
+	u1.RateLimitID = &rl.ID
+	u1.RateLimit = rl
+	u2 := buildUser("u2", "bob", "bob@example.com")
+
+	gs := newStoreWithUsers(t,
+		[]configstoreTables.TableUser{*u1, *u2},
+		[]configstoreTables.TableBudget{*b},
+		[]configstoreTables.TableRateLimit{*rl},
+	)
+
+	data := gs.GetGovernanceData(context.Background())
+	require.NotNil(t, data)
+	require.NotNil(t, data.Users, "snapshot Users map must be populated, not nil")
+	require.Len(t, data.Users, 2)
+
+	// u1: budget + rate limit surfaced
+	got1, ok := data.Users["u1"]
+	require.True(t, ok, "u1 must be present in the snapshot")
+	require.NotNil(t, got1)
+	require.Len(t, got1.BudgetIDs, 1)
+	assert.Equal(t, "b1", got1.BudgetIDs[0])
+	require.NotNil(t, got1.RateLimitID)
+	assert.Equal(t, "rl1", *got1.RateLimitID)
+
+	// u2: present, no budgets, no rate limit
+	got2, ok := data.Users["u2"]
+	require.True(t, ok, "u2 must be present in the snapshot")
+	require.NotNil(t, got2)
+	assert.Empty(t, got2.BudgetIDs)
+	assert.Nil(t, got2.RateLimitID)
+
+	// snapshot view must agree with the single-user accessor
+	single, exists := gs.GetUserGovernance(context.Background(), "u1")
+	require.True(t, exists)
+	assert.Equal(t, single.BudgetIDs, got1.BudgetIDs)
+	assert.Equal(t, single.RateLimitID, got1.RateLimitID)
+}
+
+func TestGetGovernanceData_NoUsers_EmptyNotNil(t *testing.T) {
+	gs := newStoreWithUsers(t, nil, nil, nil)
+	data := gs.GetGovernanceData(context.Background())
+	require.NotNil(t, data)
+	require.NotNil(t, data.Users, "Users map must be non-nil even with no users")
+	assert.Empty(t, data.Users)
+}
