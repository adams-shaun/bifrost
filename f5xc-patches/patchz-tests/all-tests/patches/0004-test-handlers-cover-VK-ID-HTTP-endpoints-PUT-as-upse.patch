+// =============================================================================
+// POST /api/governance/virtual-keys with caller-supplied ID (patch2 0001)
+// =============================================================================
+
+func TestCreateVirtualKey_GeneratesUUID_WhenIDOmitted(t *testing.T) {
+	h, cs, _ := newVKHandler(t)
+	ctx := vkReqCtx("POST", `{"name":"vk-no-id"}`)
+	h.createVirtualKey(ctx)
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+
+	got := extractVKFromResponse(t, ctx.Response.Body())
+	assert.NotEmpty(t, got.ID, "server-generated UUID expected when ID omitted")
+	assert.Len(t, got.ID, 36, "UUID should be 36 chars (8-4-4-4-12)")
+	// VK value is server-generated; should have the sk-bf- prefix.
+	assert.True(t, strings.HasPrefix(got.Value, governance.VirtualKeyPrefix),
+		"created VK should have %q prefix, got %q", governance.VirtualKeyPrefix, got.Value)
+
+	// Persisted under the generated ID.
+	persisted, err := cs.GetVirtualKey(context.Background(), got.ID)
+	require.NoError(t, err)
+	assert.Equal(t, "vk-no-id", persisted.Name)
+}
+
+func TestCreateVirtualKey_HonorsCallerSuppliedID(t *testing.T) {
+	h, cs, _ := newVKHandler(t)
+	deterministicID := "tenant-x:ns-y:hash-12345"
+	body := `{"id":"` + deterministicID + `","name":"vk-deterministic"}`
+	ctx := vkReqCtx("POST", body)
+	h.createVirtualKey(ctx)
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+
+	got := extractVKFromResponse(t, ctx.Response.Body())
+	assert.Equal(t, deterministicID, got.ID,
+		"server must use caller-supplied ID instead of generating a UUID")
+	// Persisted under the caller's ID.
+	persisted, err := cs.GetVirtualKey(context.Background(), deterministicID)
+	require.NoError(t, err)
+	assert.Equal(t, "vk-deterministic", persisted.Name)
+}
+
+func TestCreateVirtualKey_WithBudget_AndCallerSuppliedID(t *testing.T) {
+	h, cs, _ := newVKHandler(t)
+	body := `{
+		"id": "deterministic-id-1",
+		"name": "vk-budgeted",
+		"budgets": [{"max_limit": 25.0, "reset_duration": "1h"}]
+	}`
+	ctx := vkReqCtx("POST", body)
+	h.createVirtualKey(ctx)
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+
+	persisted, err := cs.GetVirtualKey(context.Background(), "deterministic-id-1")
+	require.NoError(t, err)
+	require.Len(t, persisted.Budgets, 1)
+	assert.Equal(t, 25.0, persisted.Budgets[0].MaxLimit)
+	require.NotNil(t, persisted.Budgets[0].VirtualKeyID)
+	assert.Equal(t, "deterministic-id-1", *persisted.Budgets[0].VirtualKeyID)
+}
+
+func TestCreateVirtualKey_MissingName_Rejected(t *testing.T) {
+	h, _, mgr := newVKHandler(t)
+	ctx := vkReqCtx("POST", `{"id":"abc"}`)
+	h.createVirtualKey(ctx)
+	assert.Equal(t, 400, ctx.Response.StatusCode())
+	assert.Contains(t, string(ctx.Response.Body()), "name is required")
+	assert.Empty(t, mgr.reloaded)
+}
