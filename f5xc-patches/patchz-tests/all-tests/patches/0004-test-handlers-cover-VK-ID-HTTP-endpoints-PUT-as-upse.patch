+// =============================================================================
+// PUT /api/governance/virtual-keys/{vk_id} — upsert (patch2 0001)
+// =============================================================================
+
+func TestUpsertVirtualKey_Create_WhenIDMissing(t *testing.T) {
+	h, cs, mgr := newVKHandler(t)
+
+	body := `{"name":"vk-via-put-create"}`
+	ctx := vkReqCtx("PUT", body)
+	ctx.SetUserValue("vk_id", "put-id-not-yet-existing")
+	h.upsertVirtualKey(ctx)
+
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+	got := extractVKFromResponse(t, ctx.Response.Body())
+	assert.Equal(t, "put-id-not-yet-existing", got.ID,
+		"upsert must use the URL's vk_id even on the create branch")
+	assert.Equal(t, "vk-via-put-create", got.Name)
+
+	persisted, err := cs.GetVirtualKey(context.Background(), "put-id-not-yet-existing")
+	require.NoError(t, err)
+	assert.Equal(t, "vk-via-put-create", persisted.Name)
+
+	require.NotEmpty(t, mgr.reloaded, "VK reload must run on the create branch")
+	assert.Equal(t, "put-id-not-yet-existing", mgr.reloaded[0])
+}
+
+func TestUpsertVirtualKey_Update_WhenIDExists(t *testing.T) {
+	h, cs, mgr := newVKHandler(t)
+
+	// Pre-seed a VK.
+	active := true
+	preexisting := &configstoreTables.TableVirtualKey{
+		ID:       "put-id-existing",
+		Name:     "original-name",
+		Value:    "sk-bf-original",
+		IsActive: &active,
+	}
+	require.NoError(t, cs.CreateVirtualKey(context.Background(), preexisting))
+
+	// PUT with UpdateVirtualKeyRequest shape — description-only patch.
+	body := `{"description":"updated via PUT"}`
+	ctx := vkReqCtx("PUT", body)
+	ctx.SetUserValue("vk_id", "put-id-existing")
+	h.upsertVirtualKey(ctx)
+
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+
+	persisted, err := cs.GetVirtualKey(context.Background(), "put-id-existing")
+	require.NoError(t, err)
+	assert.Equal(t, "original-name", persisted.Name, "update-branch must preserve untouched fields")
+	assert.Equal(t, "updated via PUT", persisted.Description)
+	assert.Equal(t, "sk-bf-original", persisted.Value, "PUT must NOT rotate the VK value")
+
+	require.NotEmpty(t, mgr.reloaded, "VK reload must run on the update branch")
+	assert.Equal(t, "put-id-existing", mgr.reloaded[len(mgr.reloaded)-1])
+}
+
+func TestUpsertVirtualKey_MissingVKID_Rejected(t *testing.T) {
+	h, _, _ := newVKHandler(t)
+	ctx := vkReqCtx("PUT", `{"name":"x"}`)
+	ctx.SetUserValue("vk_id", "") // empty
+	h.upsertVirtualKey(ctx)
+	assert.Equal(t, 400, ctx.Response.StatusCode())
+	assert.Contains(t, string(ctx.Response.Body()), "vk_id is required")
+}
+
+func TestUpsertVirtualKey_Create_BodyOverridesIDAreIgnored(t *testing.T) {
+	h, cs, _ := newVKHandler(t)
+	// Body claims one ID; URL says another. The URL wins.
+	body := `{"id":"body-supplied-id","name":"vk-overridden"}`
+	ctx := vkReqCtx("PUT", body)
+	ctx.SetUserValue("vk_id", "url-supplied-id")
+	h.upsertVirtualKey(ctx)
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+
+	// VK is persisted under the URL's id, not the body's.
+	_, err := cs.GetVirtualKey(context.Background(), "url-supplied-id")
+	assert.NoError(t, err, "VK must be stored under URL's vk_id")
+	_, err = cs.GetVirtualKey(context.Background(), "body-supplied-id")
+	assert.Error(t, err, "body's id field must NOT win over URL's vk_id on upsert-create")
+}
+
+func TestUpsertVirtualKey_Idempotent_TwoPUTsWithSameID(t *testing.T) {
+	h, cs, mgr := newVKHandler(t)
+
+	// First PUT: create.
+	first := vkReqCtx("PUT", `{"name":"first-name"}`)
+	first.SetUserValue("vk_id", "stable-id")
+	h.upsertVirtualKey(first)
+	require.Equal(t, 200, first.Response.StatusCode(), "first PUT body: %s", first.Response.Body())
+
+	// Second PUT: should treat as update.
+	second := vkReqCtx("PUT", `{"description":"second-call"}`)
+	second.SetUserValue("vk_id", "stable-id")
+	h.upsertVirtualKey(second)
+	require.Equal(t, 200, second.Response.StatusCode(), "second PUT body: %s", second.Response.Body())
+
+	persisted, err := cs.GetVirtualKey(context.Background(), "stable-id")
+	require.NoError(t, err)
+	assert.Equal(t, "first-name", persisted.Name, "second PUT (update branch) must preserve name")
+	assert.Equal(t, "second-call", persisted.Description, "description set by second PUT")
+
+	// Reload observed on both calls — F5XC reconcile loop relies on this.
+	assert.GreaterOrEqual(t, len(mgr.reloaded), 2, "expected reload on both PUTs")
+}
+
+func TestUpsertVirtualKey_InvalidJSON_OnCreateBranch_Rejected(t *testing.T) {
+	h, _, _ := newVKHandler(t)
+	ctx := vkReqCtx("PUT", `not-json`)
+	ctx.SetUserValue("vk_id", "new-id-but-bad-body")
+	h.upsertVirtualKey(ctx)
+	assert.Equal(t, 400, ctx.Response.StatusCode())
+	assert.Contains(t, string(ctx.Response.Body()), "Invalid JSON")
+}
