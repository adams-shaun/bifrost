+// =============================================================================
+// Lifecycle: F5XC's reconcile loop pattern
+// =============================================================================
+
+func TestUpsertVirtualKey_FullReconcileLifecycle(t *testing.T) {
+	h, cs, mgr := newVKHandler(t)
+	deterministicID := "tenant:ns:user:hash"
+
+	// First reconcile: VK doesn't exist yet → create.
+	ctx1 := vkReqCtx("PUT", `{"name":"reconciled-vk","description":"initial"}`)
+	ctx1.SetUserValue("vk_id", deterministicID)
+	h.upsertVirtualKey(ctx1)
+	require.Equal(t, 200, ctx1.Response.StatusCode())
+
+	// Subsequent reconcile: same ID → update.
+	ctx2 := vkReqCtx("PUT", `{"description":"updated description"}`)
+	ctx2.SetUserValue("vk_id", deterministicID)
+	h.upsertVirtualKey(ctx2)
+	require.Equal(t, 200, ctx2.Response.StatusCode())
+
+	// Third reconcile: tweak again.
+	ctx3 := vkReqCtx("PUT", `{"description":"final description"}`)
+	ctx3.SetUserValue("vk_id", deterministicID)
+	h.upsertVirtualKey(ctx3)
+	require.Equal(t, 200, ctx3.Response.StatusCode())
+
+	persisted, err := cs.GetVirtualKey(context.Background(), deterministicID)
+	require.NoError(t, err)
+	assert.Equal(t, "reconciled-vk", persisted.Name)
+	assert.Equal(t, "final description", persisted.Description)
+	// VK value must not have rotated across reconciles.
+	val1 := persisted.Value
+	assert.True(t, strings.HasPrefix(val1, governance.VirtualKeyPrefix))
+
+	// Reload was called on every reconcile.
+	assert.Equal(t, 3, len(mgr.reloaded))
+}
+
+// Locks the upsert update-branch strict-decode: PUT to an existing VK with
+// a body carrying an unknown field must 400 under DisallowUnknownFields,
+// not silently drop. CreateVirtualKeyRequest and UpdateVirtualKeyRequest
+// happen to share their top-level JSON tags today, so this guards against
+// typo / malformed payloads rather than a Create-vs-Update shape mismatch.
+func TestUpsertVirtualKey_UpdateBranch_RejectsUnknownField(t *testing.T) {
+	h, cs, _ := newVKHandler(t)
+	active := true
+	preexisting := &configstoreTables.TableVirtualKey{
+		ID:       "put-shape-mismatch",
+		Name:     "original-name",
+		Value:    "sk-bf-original",
+		IsActive: &active,
+	}
+	require.NoError(t, cs.CreateVirtualKey(context.Background(), preexisting))
+
+	body := `{"description":"ok","not_a_real_field":true}`
+	ctx := vkReqCtx("PUT", body)
+	ctx.SetUserValue("vk_id", "put-shape-mismatch")
+	h.upsertVirtualKey(ctx)
+
+	assert.Equal(t, 400, ctx.Response.StatusCode(),
+		"unknown field on PUT must 400 under DisallowUnknownFields")
+	assert.Contains(t, string(ctx.Response.Body()), "Invalid update body")
+
+	persisted, err := cs.GetVirtualKey(context.Background(), "put-shape-mismatch")
+	require.NoError(t, err)
+	assert.Equal(t, "original-name", persisted.Name, "rejected body must NOT have touched the row")
+}
