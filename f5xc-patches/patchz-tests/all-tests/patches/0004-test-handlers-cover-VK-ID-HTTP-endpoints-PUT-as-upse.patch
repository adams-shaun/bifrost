+// vkTestConfigStore is an in-memory SQLite-backed mock for VK CRUD. Embeds the
+// ConfigStore interface so unimplemented methods panic.
+type vkTestConfigStore struct {
+	configstore.ConfigStore
+	db *gorm.DB
+}
+
+func newVKTestConfigStore(t *testing.T) *vkTestConfigStore {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{
+		Logger: gormlogger.Default.LogMode(gormlogger.Silent),
+	})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(1)
+	sqlDB.SetMaxIdleConns(1)
+	require.NoError(t, db.AutoMigrate(
+		&configstoreTables.TableVirtualKey{},
+		&configstoreTables.TableVirtualKeyProviderConfig{},
+		&configstoreTables.TableVirtualKeyMCPConfig{},
+		&configstoreTables.TableBudget{},
+		&configstoreTables.TableRateLimit{},
+		&configstoreTables.TableProvider{},
+	))
+	return &vkTestConfigStore{db: db}
+}
+
+func (s *vkTestConfigStore) ExecuteTransaction(_ context.Context, fn func(*gorm.DB) error) error {
+	// See governance_user_test.go for why we use background-context here.
+	return s.db.Transaction(fn)
+}
+
+func (s *vkTestConfigStore) GetVirtualKey(_ context.Context, id string) (*configstoreTables.TableVirtualKey, error) {
+	var vk configstoreTables.TableVirtualKey
+	if err := s.db.Session(&gorm.Session{}).
+		Preload("Budgets").
+		Preload("RateLimit").
+		Preload("ProviderConfigs").
+		Preload("MCPConfigs").
+		Where("id = ?", id).
+		First(&vk).Error; err != nil {
+		if err == gorm.ErrRecordNotFound {
+			return nil, configstore.ErrNotFound
+		}
+		return nil, err
+	}
+	return &vk, nil
+}
+
+func (s *vkTestConfigStore) CreateVirtualKey(_ context.Context, vk *configstoreTables.TableVirtualKey, tx ...*gorm.DB) error {
+	db := s.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.Session(&gorm.Session{}).Create(vk).Error
+}
+
+func (s *vkTestConfigStore) UpdateVirtualKey(_ context.Context, vk *configstoreTables.TableVirtualKey, tx ...*gorm.DB) error {
+	db := s.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.Session(&gorm.Session{}).Save(vk).Error
+}
+
+func (s *vkTestConfigStore) CreateBudget(_ context.Context, b *configstoreTables.TableBudget, tx ...*gorm.DB) error {
+	db := s.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.Session(&gorm.Session{}).Create(b).Error
+}
+
+func (s *vkTestConfigStore) CreateRateLimit(_ context.Context, rl *configstoreTables.TableRateLimit, tx ...*gorm.DB) error {
+	db := s.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.Session(&gorm.Session{}).Create(rl).Error
+}
+
+func (s *vkTestConfigStore) GetProviders(_ context.Context) ([]configstoreTables.TableProvider, error) {
+	var out []configstoreTables.TableProvider
+	if err := s.db.Session(&gorm.Session{}).Find(&out).Error; err != nil {
+		return nil, err
+	}
+	return out, nil
+}
