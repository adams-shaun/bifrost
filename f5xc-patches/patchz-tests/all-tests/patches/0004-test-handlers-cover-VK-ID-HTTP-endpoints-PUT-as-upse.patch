+// vkTrackingGovernanceManager records ReloadVirtualKey calls and returns the
+// VK from the supplied configStore.
+type vkTrackingGovernanceManager struct {
+	GovernanceManager
+	cs        *vkTestConfigStore
+	reloaded  []string
+	reloadErr error
+}
+
+func (m *vkTrackingGovernanceManager) ReloadVirtualKey(ctx context.Context, id string) (*configstoreTables.TableVirtualKey, error) {
+	m.reloaded = append(m.reloaded, id)
+	if m.reloadErr != nil {
+		return nil, m.reloadErr
+	}
+	return m.cs.GetVirtualKey(ctx, id)
+}
+
+func (m *vkTrackingGovernanceManager) GetGovernanceData(_ context.Context) *governance.GovernanceData {
+	return nil
+}
+
+// =============================================================================
+// Helpers
+// =============================================================================
+
+func newVKHandler(t *testing.T) (*GovernanceHandler, *vkTestConfigStore, *vkTrackingGovernanceManager) {
+	t.Helper()
+	SetLogger(&mockLogger{})
+	cs := newVKTestConfigStore(t)
+	mgr := &vkTrackingGovernanceManager{cs: cs}
+	h, err := NewGovernanceHandler(mgr, cs)
+	require.NoError(t, err)
+	return h, cs, mgr
+}
+
+func vkReqCtx(method, body string) *fasthttp.RequestCtx {
+	ctx := &fasthttp.RequestCtx{}
+	// Init wires up ctx.s to fakeServer so ctx.Done() doesn't panic when
+	// gorm dispatches a query that calls ctx.Done() under the hood. We
+	// build the request first, then Init copies it back in.
+	req := &fasthttp.Request{}
+	req.Header.SetMethod(method)
+	req.Header.SetContentType("application/json")
+	req.SetBody([]byte(body))
+	ctx.Init(req, nil, nil)
+	return ctx
+}
+
+func extractVKFromResponse(t *testing.T, body []byte) configstoreTables.TableVirtualKey {
+	t.Helper()
+	var wrap struct {
+		Message    string                            `json:"message"`
+		VirtualKey configstoreTables.TableVirtualKey `json:"virtual_key"`
+	}
+	require.NoError(t, json.Unmarshal(body, &wrap))
+	return wrap.VirtualKey
+}
