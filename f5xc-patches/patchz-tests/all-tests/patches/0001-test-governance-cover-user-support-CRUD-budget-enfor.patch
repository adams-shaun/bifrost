+func buildUserWithRateLimit(id, name string, rl *configstoreTables.TableRateLimit) *configstoreTables.TableUser {
+	u := buildUser(id, name, name+"@example.com")
+	if rl != nil {
+		u.RateLimitID = &rl.ID
+		u.RateLimit = rl
+	}
+	return u
+}
