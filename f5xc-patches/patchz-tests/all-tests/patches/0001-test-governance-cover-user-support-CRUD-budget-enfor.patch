+func TestUser_GovernanceConfigLoad_PopulatesCache(t *testing.T) {
+	b := buildBudget("b1", 100, "1h")
+	rl := buildRateLimit("rl1", 10000, 1000)
+	u := buildUserWithBudget("u1", "alice", b)
+	u.RateLimitID = &rl.ID
+	u.RateLimit = rl
+
+	gs := newStoreWithUsers(t,
+		[]configstoreTables.TableUser{*u},
+		[]configstoreTables.TableBudget{*b},
+		[]configstoreTables.TableRateLimit{*rl},
+	)
+
+	g, exists := gs.GetUserGovernance(context.Background(), "u1")
+	require.True(t, exists, "user should be loaded into in-memory cache")
+	require.Len(t, g.BudgetIDs, 1)
+	assert.Equal(t, "b1", g.BudgetIDs[0])
+	require.NotNil(t, g.RateLimitID)
+	assert.Equal(t, "rl1", *g.RateLimitID)
+}
+
+func TestUser_GetUserGovernance_NotFound(t *testing.T) {
+	gs := newStoreWithUsers(t, nil, nil, nil)
+	g, exists := gs.GetUserGovernance(context.Background(), "missing")
+	assert.False(t, exists)
+	assert.Nil(t, g)
+}
