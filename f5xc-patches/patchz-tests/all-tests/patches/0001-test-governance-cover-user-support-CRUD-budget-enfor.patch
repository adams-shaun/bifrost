+// =============================================================================
+// fakeConfigStore — User CRUD extension
+//
+// dump_refresh_test.go defines the fakeConfigStore type and seeds budgets +
+// rate limits via in-memory SQLite. This file adds User-related methods +
+// helpers so user_governance_test.go can exercise the patch1/user-support
+// store path end-to-end. The two files share the same type because Go allows
+// methods on a type to be split across files in the same package.
+// =============================================================================
+
+func (f *fakeConfigStore) migrateUserTables(t *testing.T) {
+	t.Helper()
+	require.NoError(t, f.db.AutoMigrate(
+		&configstoreTables.TableUser{},
+		&configstoreTables.TableVirtualKey{},
+	), "automigrate user tables")
+}
+
+func (f *fakeConfigStore) GetUser(ctx context.Context, id string) (*configstoreTables.TableUser, error) {
+	var u configstoreTables.TableUser
+	if err := f.db.WithContext(ctx).
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Where("id = ?", id).
+		First(&u).Error; err != nil {
+		if err == gorm.ErrRecordNotFound {
+			return nil, configstore.ErrNotFound
+		}
+		return nil, err
+	}
+	// Computed VK count (mirrors RDBConfigStore.GetUser).
+	if err := f.db.WithContext(ctx).
+		Model(&configstoreTables.TableVirtualKey{}).
+		Where("user_id = ?", id).
+		Count(&u.VirtualKeyCount).Error; err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
+
+func (f *fakeConfigStore) GetUsers(ctx context.Context) ([]configstoreTables.TableUser, error) {
+	var out []configstoreTables.TableUser
+	if err := f.db.WithContext(ctx).
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Order("created_at ASC").
+		Find(&out).Error; err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func (f *fakeConfigStore) GetUsersPaginated(ctx context.Context, params configstore.UsersQueryParams) ([]configstoreTables.TableUser, int64, error) {
+	q := f.db.WithContext(ctx).Model(&configstoreTables.TableUser{})
+	if params.TeamID != "" {
+		q = q.Where("team_id = ?", params.TeamID)
+	}
+	if params.Search != "" {
+		s := "%" + params.Search + "%"
+		q = q.Where("LOWER(name) LIKE LOWER(?) OR LOWER(email) LIKE LOWER(?)", s, s)
+	}
+	var total int64
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, err
+	}
+	limit := params.Limit
+	if limit <= 0 {
+		limit = 50
+	}
+	var out []configstoreTables.TableUser
+	if err := q.Preload("Team").Preload("Budgets").Preload("RateLimit").
+		Order("created_at DESC").
+		Limit(limit).Offset(params.Offset).
+		Find(&out).Error; err != nil {
+		return nil, 0, err
+	}
+	return out, total, nil
+}
