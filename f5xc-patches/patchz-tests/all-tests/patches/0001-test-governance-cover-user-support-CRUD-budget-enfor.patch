+func TestRDBUser_DeleteUser_CascadesBudgetsAndClearsVKUserID(t *testing.T) {
+	cs := newFakeConfigStoreWithUsers(t)
+
+	// Setup: user with budget, rate limit, and a VK pointing at the user.
+	rl := &configstoreTables.TableRateLimit{
+		ID:                   "rl-1",
+		TokenMaxLimit:        ptrInt64(1000),
+		TokenResetDuration:   ptrStr("1m"),
+		TokenLastReset:       time.Now(),
+		RequestMaxLimit:      ptrInt64(100),
+		RequestResetDuration: ptrStr("1m"),
+		RequestLastReset:     time.Now(),
+	}
+	require.NoError(t, cs.CreateRateLimit(context.Background(), rl))
+	u := buildUser("u1", "alice", "alice@example.com")
+	u.RateLimitID = &rl.ID
+	require.NoError(t, cs.CreateUser(context.Background(), u))
+	b := &configstoreTables.TableBudget{
+		ID:            "b-1",
+		MaxLimit:      500,
+		ResetDuration: "1h",
+		LastReset:     time.Now(),
+		UserID:        &u.ID,
+	}
+	require.NoError(t, cs.CreateBudget(context.Background(), b))
+	vk := &configstoreTables.TableVirtualKey{
+		ID:     "vk-1",
+		Name:   "test-vk",
+		Value:  "sk-bf-test",
+		UserID: &u.ID,
+	}
+	require.NoError(t, cs.db.Create(vk).Error)
+
+	require.NoError(t, cs.DeleteUser(context.Background(), "u1"))
+
+	// User row gone.
+	_, err := cs.GetUser(context.Background(), "u1")
+	assert.Equal(t, configstore.ErrNotFound, err)
+	// Budget cascade.
+	var budgetCount int64
+	require.NoError(t, cs.db.Model(&configstoreTables.TableBudget{}).Where("id = ?", "b-1").Count(&budgetCount).Error)
+	assert.Equal(t, int64(0), budgetCount, "user budget should cascade-delete")
+	// Rate limit deleted.
+	var rlCount int64
+	require.NoError(t, cs.db.Model(&configstoreTables.TableRateLimit{}).Where("id = ?", "rl-1").Count(&rlCount).Error)
+	assert.Equal(t, int64(0), rlCount, "user-owned rate limit should be deleted")
+	// VK survives with nulled user_id.
+	var vkRow configstoreTables.TableVirtualKey
+	require.NoError(t, cs.db.First(&vkRow, "id = ?", "vk-1").Error)
+	assert.Nil(t, vkRow.UserID, "VK that referenced the user should have user_id nulled")
+}
