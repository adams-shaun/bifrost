+func buildUserWithBudget(id, name string, budget *configstoreTables.TableBudget) *configstoreTables.TableUser {
+	u := buildUser(id, name, name+"@example.com")
+	if budget != nil {
+		budget.UserID = &u.ID
+		u.Budgets = []configstoreTables.TableBudget{*budget}
+	}
+	return u
+}
