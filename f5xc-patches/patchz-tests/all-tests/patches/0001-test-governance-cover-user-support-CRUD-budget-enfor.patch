+
+func TestUser_UpdateUserInMemory_ReplacesEntry(t *testing.T) {
+	gs := newStoreWithUsers(t, nil, nil, nil)
+	gs.CreateUserInMemory(context.Background(), buildUser("u1", "alice", "alice@example.com"))
+
+	// Update: attach a rate limit.
+	rl := buildRateLimit("rl1", 10000, 1000)
+	gs.UpsertRateLimitConfig(context.Background(), "rl1", rl)
+	updated := buildUserWithRateLimit("u1", "alice", rl)
+	gs.UpdateUserInMemory(context.Background(), updated)
+
+	g, exists := gs.GetUserGovernance(context.Background(), "u1")
+	require.True(t, exists)
+	require.NotNil(t, g.RateLimitID)
+	assert.Equal(t, "rl1", *g.RateLimitID)
+}
+
+func TestUser_DeleteUserInMemory_Removes(t *testing.T) {
+	gs := newStoreWithUsers(t, nil, nil, nil)
+	gs.CreateUserInMemory(context.Background(), buildUser("u1", "alice", "alice@example.com"))
+	gs.DeleteUserInMemory(context.Background(), "u1")
+
+	_, exists := gs.GetUserGovernance(context.Background(), "u1")
+	assert.False(t, exists)
