+func TestRDBUser_CreateWithBudgetAndRateLimit_AllCommitted(t *testing.T) {
+	cs := newFakeConfigStoreWithUsers(t)
+
+	// Simulate the createUser handler: insert rate limit, user, then budget
+	// all in one transaction.
+	var user configstoreTables.TableUser
+	require.NoError(t, cs.ExecuteTransaction(context.Background(), func(tx *gorm.DB) error {
+		rl := &configstoreTables.TableRateLimit{
+			ID:                   "rl-1",
+			TokenMaxLimit:        ptrInt64(10000),
+			TokenResetDuration:   ptrStr("1m"),
+			TokenLastReset:       time.Now(),
+			RequestMaxLimit:      ptrInt64(1000),
+			RequestResetDuration: ptrStr("1m"),
+			RequestLastReset:     time.Now(),
+		}
+		if err := cs.CreateRateLimit(context.Background(), rl, tx); err != nil {
+			return err
+		}
+		user = configstoreTables.TableUser{
+			ID:          "u1",
+			Name:        "alice",
+			Email:       "alice@example.com",
+			RateLimitID: &rl.ID,
+		}
+		if err := cs.CreateUser(context.Background(), &user, tx); err != nil {
+			return err
+		}
+		budget := &configstoreTables.TableBudget{
+			ID:            "b-1",
