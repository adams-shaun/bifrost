+func (f *fakeConfigStore) CreateUser(ctx context.Context, user *configstoreTables.TableUser, tx ...*gorm.DB) error {
+	db := f.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.WithContext(ctx).Create(user).Error
+}
+
+func (f *fakeConfigStore) UpdateUser(ctx context.Context, user *configstoreTables.TableUser, tx ...*gorm.DB) error {
+	db := f.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.WithContext(ctx).Save(user).Error
+}
+
+func (f *fakeConfigStore) DeleteUser(ctx context.Context, id string) error {
+	return f.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var u configstoreTables.TableUser
+		if err := tx.WithContext(ctx).Where("id = ?", id).First(&u).Error; err != nil {
+			if err == gorm.ErrRecordNotFound {
+				return configstore.ErrNotFound
+			}
+			return err
+		}
+		rateLimitID := u.RateLimitID
+		// Budgets owned by the user cascade via the FK constraint in the
+		// schema; SQLite's foreign-keys pragma needs the FK to be set during
+		// migration. Our AutoMigrate emits the constraint, but for parity
+		// with RDBConfigStore.DeleteUser we also delete budgets explicitly
+		// here so the test outcome matches Postgres semantics.
+		if err := tx.WithContext(ctx).
+			Where("user_id = ?", id).
+			Delete(&configstoreTables.TableBudget{}).Error; err != nil {
+			return err
+		}
+		if err := tx.WithContext(ctx).Delete(&configstoreTables.TableUser{}, "id = ?", id).Error; err != nil {
+			return err
+		}
+		if rateLimitID != nil {
+			if err := tx.WithContext(ctx).Delete(&configstoreTables.TableRateLimit{}, "id = ?", *rateLimitID).Error; err != nil {
+				return err
+			}
+		}
+		if err := tx.WithContext(ctx).
+			Model(&configstoreTables.TableVirtualKey{}).
+			Where("user_id = ?", id).
+			Update("user_id", nil).Error; err != nil {
+			return err
+		}
+		return nil
+	})
+}
