+func TestUser_BudgetAllocation_BumpDumpRefresh_Lifecycle(t *testing.T) {
+	cs := newFakeConfigStoreWithUsers(t)
+
+	// Seed user + budget directly in DB and in the in-memory store so the
+	// store sees the same state the reload path would produce after a
+	// createUser HTTP request followed by ReloadUser.
+	u := buildUser("u1", "alice", "alice@example.com")
+	b := &configstoreTables.TableBudget{
+		ID:            "b-1",
+		MaxLimit:      10,
+		ResetDuration: "1h",
+		LastReset:     time.Now(),
+		UserID:        &u.ID,
+	}
+	require.NoError(t, cs.CreateUser(context.Background(), u))
+	require.NoError(t, cs.CreateBudget(context.Background(), b))
+	// Sync into memory + wire the configStore so dumps land in our SQLite.
+	gs := newStoreWithUsers(t, []configstoreTables.TableUser{
+		{ID: u.ID, Name: u.Name, Email: u.Email, Budgets: []configstoreTables.TableBudget{*b}},
+	}, []configstoreTables.TableBudget{*b}, nil)
+	gs.configStore = cs
+
+	// Sub-limit usage allowed.
+	d, err := gs.CheckUserBudget(context.Background(), "u1", &EvaluationRequest{}, nil)
+	require.NoError(t, err)
+	assert.Equal(t, DecisionAllow, d)
+
+	// Accumulate usage on the user's budget.
+	for i := 0; i < 4; i++ {
+		require.NoError(t, gs.UpdateUserBudgetUsageInMemory(context.Background(), "u1", 2.0))
+	}
+	assert.Equal(t, 8.0, budgetCurrentUsage(t, gs, "b-1"))
+
+	// Dump → DB persists the delta as an increment.
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, 8.0, cs.dbBudget(t, "b-1").CurrentUsage)
+
+	// One more bump pushes the user to (or above) the limit.
+	require.NoError(t, gs.UpdateUserBudgetUsageInMemory(context.Background(), "u1", 5.0))
+	d, err = gs.CheckUserBudget(context.Background(), "u1", &EvaluationRequest{}, nil)
+	require.Error(t, err, "user budget should now be exhausted")
+	assert.Equal(t, DecisionBudgetExceeded, d)
+
+	// Final dump records the over-limit usage too.
+	require.NoError(t, gs.DumpBudgets(context.Background()))
+	assert.Equal(t, 13.0, cs.dbBudget(t, "b-1").CurrentUsage)
+}
