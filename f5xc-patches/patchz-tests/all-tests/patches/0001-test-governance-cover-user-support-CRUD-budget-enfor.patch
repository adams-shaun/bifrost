+func TestUser_CreateUserInMemory_Stores(t *testing.T) {
+	gs := newStoreWithUsers(t, nil, nil, nil)
+	u := buildUser("u1", "alice", "alice@example.com")
+	gs.CreateUserInMemory(context.Background(), u)
+
+	g, exists := gs.GetUserGovernance(context.Background(), "u1")
+	assert.True(t, exists)
