+func TestUser_TwoPods_DumpRefresh_SharedUserBudget(t *testing.T) {
+	cs := newFakeConfigStoreWithUsers(t)
+	u := buildUser("u1", "alice", "alice@example.com")
+	b := &configstoreTables.TableBudget{
+		ID:            "b-1",
+		MaxLimit:      1000,
+		ResetDuration: "1h",
+		LastReset:     time.Now(),
+		UserID:        &u.ID,
+	}
+	require.NoError(t, cs.CreateUser(context.Background(), u))
+	require.NoError(t, cs.CreateBudget(context.Background(), b))
+
+	build := func() *LocalGovernanceStore {
+		gs := newStoreWithUsers(t, []configstoreTables.TableUser{
+			{ID: u.ID, Name: u.Name, Email: u.Email, Budgets: []configstoreTables.TableBudget{*b}},
+		}, []configstoreTables.TableBudget{*b}, nil)
+		gs.configStore = cs
+		return gs
+	}
+	podA, podB := build(), build()
+
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 50; i++ {
+			_ = podA.UpdateUserBudgetUsageInMemory(context.Background(), "u1", 1)
+			if i%10 == 0 {
+				_ = podA.DumpBudgets(context.Background())
+			}
+		}
+		_ = podA.DumpBudgets(context.Background())
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 50; i++ {
+			_ = podB.UpdateUserBudgetUsageInMemory(context.Background(), "u1", 1)
+			if i%10 == 0 {
+				_ = podB.DumpBudgets(context.Background())
+			}
+		}
+		_ = podB.DumpBudgets(context.Background())
+	}()
+	wg.Wait()
+
+	assert.Equal(t, 100.0, cs.dbBudget(t, "b-1").CurrentUsage,
+		"two-pod user-level budget tracking must converge to the sum of every bump")
+
+	// After refresh, each pod sees the cluster total.
+	require.NoError(t, podA.RefreshAllFromDB(context.Background()))
+	require.NoError(t, podB.RefreshAllFromDB(context.Background()))
+	assert.Equal(t, 100.0, budgetCurrentUsage(t, podA, "b-1"))
+	assert.Equal(t, 100.0, budgetCurrentUsage(t, podB, "b-1"))
+}
