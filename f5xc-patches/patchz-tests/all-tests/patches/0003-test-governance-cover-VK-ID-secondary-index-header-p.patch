+package governance
+
+import (
+	"context"
+	"testing"
+
+	"github.com/maximhq/bifrost/framework/configstore"
+	configstoreTables "github.com/maximhq/bifrost/framework/configstore/tables"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/valyala/fasthttp"
+)
+
+// =============================================================================
+// patch2/vk-id-header — VK ID secondary index + trusted-header parser.
+//
+// Covers:
+//   - GetVirtualKeyByID against the virtualKeysByID secondary index, including
+//     the lifecycle (create / update / delete keep the secondary index in sync
+//     with the primary virtualKeys map).
+//   - ParseVirtualKeyFromFastHTTPRequest header precedence:
+//     X-Bifrost-VK-ID > x-bf-vk > Authorization: Bearer > x-api-key > x-goog-api-key.
+//   - VKIDHeader constant pinned to the agreed wire-protocol value.
+// =============================================================================
+
+func buildVKWithID(id, value string) *configstoreTables.TableVirtualKey {
+	active := true
+	return &configstoreTables.TableVirtualKey{
+		ID:       id,
+		Name:     "vk-" + id,
+		Value:    value,
+		IsActive: &active,
+	}
+}
+
+func newStoreWithVKs(t *testing.T, vks []configstoreTables.TableVirtualKey) *LocalGovernanceStore {
+	t.Helper()
+	gs, err := NewLocalGovernanceStore(context.Background(), NewMockLogger(), nil, &configstore.GovernanceConfig{
+		VirtualKeys: vks,
+	}, nil)
+	require.NoError(t, err)
+	return gs
+}
+
+// =============================================================================
+// VKIDHeader constant
+// =============================================================================
+
+func TestVKIDHeader_PinnedToWireProtocolValue(t *testing.T) {
+	assert.Equal(t, "X-Bifrost-VK-ID", VKIDHeader,
+		"changing this header name is a wire-protocol break with Envoy; require an explicit rollover")
+}
+
+// =============================================================================
+// GetVirtualKeyByID
+// =============================================================================
+
+func TestGetVirtualKeyByID_NotFound(t *testing.T) {
+	gs := newStoreWithVKs(t, nil)
+	vk, ok := gs.GetVirtualKeyByID(context.Background(), "missing")
+	assert.False(t, ok)
+	assert.Nil(t, vk)
+}
+
+func TestGetVirtualKeyByID_Found_LoadFromConfig(t *testing.T) {
+	vk := buildVKWithID("vk-id-1", "sk-bf-test1")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	got, ok := gs.GetVirtualKeyByID(context.Background(), "vk-id-1")
+	require.True(t, ok)
+	require.NotNil(t, got)
+	assert.Equal(t, "vk-id-1", got.ID)
+	assert.Equal(t, "sk-bf-test1", got.Value)
+}
+
+func TestGetVirtualKey_ByValueStillWorks_AfterIDLoaded(t *testing.T) {
+	vk := buildVKWithID("vk-id-1", "sk-bf-test1")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	// Both indices serve the same pointer.
+	byID, okID := gs.GetVirtualKeyByID(context.Background(), "vk-id-1")
+	byVal, okVal := gs.GetVirtualKey(context.Background(), "sk-bf-test1")
+	require.True(t, okID)
+	require.True(t, okVal)
+	assert.Equal(t, byID.ID, byVal.ID,
+		"primary virtualKeys (by value) and virtualKeysByID must reference the same VK")
+	assert.Equal(t, byID.Value, byVal.Value)
+}
+
+func TestGetVirtualKeyByID_MultipleKeys_DisjointIDs(t *testing.T) {
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{
+		*buildVKWithID("vk-a", "sk-bf-a"),
+		*buildVKWithID("vk-b", "sk-bf-b"),
+		*buildVKWithID("vk-c", "sk-bf-c"),
+	})
+	for _, id := range []string{"vk-a", "vk-b", "vk-c"} {
+		got, ok := gs.GetVirtualKeyByID(context.Background(), id)
+		require.True(t, ok, "id %s should resolve", id)
+		assert.Equal(t, id, got.ID)
+	}
+}
+
+func TestGetVirtualKeyByID_AfterCreateInMemory(t *testing.T) {
+	gs := newStoreWithVKs(t, nil)
+	gs.CreateVirtualKeyInMemory(context.Background(), buildVKWithID("vk-new", "sk-bf-new"))
+
+	got, ok := gs.GetVirtualKeyByID(context.Background(), "vk-new")
+	require.True(t, ok)
+	assert.Equal(t, "vk-new", got.ID)
+	// Reverse lookup also works.
+	byVal, okVal := gs.GetVirtualKey(context.Background(), "sk-bf-new")
+	require.True(t, okVal)
+	assert.Equal(t, "vk-new", byVal.ID)
+}
+
+func TestGetVirtualKeyByID_AfterDeleteInMemory(t *testing.T) {
+	vk := buildVKWithID("vk-1", "sk-bf-1")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	gs.DeleteVirtualKeyInMemory(context.Background(), "vk-1")
+	_, ok := gs.GetVirtualKeyByID(context.Background(), "vk-1")
+	assert.False(t, ok, "secondary index entry must be deleted in sync with primary")
+	_, okVal := gs.GetVirtualKey(context.Background(), "sk-bf-1")
+	assert.False(t, okVal, "primary index entry must also be deleted")
+}
+
+func TestGetVirtualKeyByID_AfterUpdateInMemory_PreservesIndex(t *testing.T) {
+	vk := buildVKWithID("vk-1", "sk-bf-old")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	// Update name + value via the in-memory update path.
+	updated := buildVKWithID("vk-1", "sk-bf-new")
+	updated.Name = "renamed"
+	gs.UpdateVirtualKeyInMemory(context.Background(), updated, nil, nil, nil)
+
+	got, ok := gs.GetVirtualKeyByID(context.Background(), "vk-1")
+	require.True(t, ok)
+	assert.Equal(t, "renamed", got.Name)
+	assert.Equal(t, "sk-bf-new", got.Value, "secondary index points at the post-update VK")
+}
+
+// =============================================================================
+// ParseVirtualKeyFromFastHTTPRequest
+// =============================================================================
+
+// reqWithHeaders is a small builder for fasthttp.RequestCtx with the supplied
+// request headers set. Empty values are skipped.
+func reqWithHeaders(headers map[string]string) *fasthttp.RequestCtx {
+	ctx := &fasthttp.RequestCtx{}
+	for k, v := range headers {
+		if v == "" {
+			continue
+		}
+		ctx.Request.Header.Set(k, v)
+	}
+	return ctx
+}
+
+func TestParseVirtualKeyFromFastHTTP_NoHeaders_ReturnsNil(t *testing.T) {
+	ctx := &fasthttp.RequestCtx{}
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	assert.Nil(t, vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_VKIDHeader_TakesPrecedence(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{
+		"X-Bifrost-VK-ID": "vk-from-envoy",
+		// Value-based headers should be ignored when ID is present.
+		"x-bf-vk":         "sk-bf-ignored",
+		"Authorization":   "Bearer sk-bf-ignored",
+		"x-api-key":       "sk-bf-ignored",
+		"x-goog-api-key":  "sk-bf-ignored",
+	})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	assert.Nil(t, vkValue, "vkValue must NOT be set when trusted ID header is present")
+	assert.Equal(t, "vk-from-envoy", vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_XBfVkHeader(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{"x-bf-vk": "sk-bf-direct"})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-direct", *vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_AuthorizationBearer(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{"Authorization": "Bearer sk-bf-bearer"})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-bearer", *vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_AuthorizationBearer_CaseInsensitivePrefix(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{"Authorization": "bearer sk-bf-lowercase"})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-lowercase", *vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_AuthorizationBearer_NonVKValue_NoMatch(t *testing.T) {
+	// Bearer that isn't a VK-format token should be ignored, not promoted.
+	ctx := reqWithHeaders(map[string]string{"Authorization": "Bearer eyJjustaJWT"})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	assert.Nil(t, vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_XApiKey(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{"x-api-key": "sk-bf-xapi"})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-xapi", *vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_XGoogApiKey(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{"x-goog-api-key": "sk-bf-goog"})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-goog", *vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_Precedence_XBfVk_Beats_Authorization(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{
+		"x-bf-vk":       "sk-bf-from-x-bf-vk",
+		"Authorization": "Bearer sk-bf-from-auth",
+	})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-from-x-bf-vk", *vkValue)
+	assert.Empty(t, vkID)
+}
+
+func TestParseVirtualKeyFromFastHTTP_Precedence_Authorization_Beats_XApiKey(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{
+		"Authorization": "Bearer sk-bf-from-auth",
+		"x-api-key":     "sk-bf-from-x-api-key",
+	})
+	vkValue, _ := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-from-auth", *vkValue)
+}
+
+func TestParseVirtualKeyFromFastHTTP_Precedence_XApiKey_Beats_XGoogApiKey(t *testing.T) {
+	ctx := reqWithHeaders(map[string]string{
+		"x-api-key":      "sk-bf-from-x-api",
+		"x-goog-api-key": "sk-bf-from-x-goog",
+	})
+	vkValue, _ := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.NotNil(t, vkValue)
+	assert.Equal(t, "sk-bf-from-x-api", *vkValue)
+}
+
+func TestParseVirtualKeyFromFastHTTP_NonVKPrefix_Ignored(t *testing.T) {
+	// None of these match VirtualKeyPrefix → all dropped.
+	cases := map[string]string{
+		"x-bf-vk":        "not-a-vk-token",
+		"x-api-key":      "openai-style-key",
+		"x-goog-api-key": "AIzaSomething",
+	}
+	for header, value := range cases {
+		t.Run(header, func(t *testing.T) {
+			ctx := reqWithHeaders(map[string]string{header: value})
+			vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+			assert.Nil(t, vkValue, "non-VK-prefix tokens must be ignored on %s", header)
+			assert.Empty(t, vkID)
+		})
+	}
+}
+
+// =============================================================================
+// Resolution path integration: ID lookup short-circuits value-based path
+// =============================================================================
+
+func TestVKResolution_IDPath_FindsVKEvenIfValueIsUnknown(t *testing.T) {
+	// VK is loaded into the store. Caller supplies only the ID; the value
+	// path is never consulted.
+	vk := buildVKWithID("vk-deterministic", "sk-bf-secret-value")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	got, ok := gs.GetVirtualKeyByID(context.Background(), "vk-deterministic")
+	require.True(t, ok)
+	require.NotNil(t, got)
+	// The trusted-ID path returns the same VK regardless of the value the
+	// client would have used — Envoy can resolve identity without leaking
+	// sk-bf-* values downstream.
+	assert.Equal(t, "sk-bf-secret-value", got.Value)
+}
+
+func TestVKResolution_ValuePath_StillWorks_WhenIDPathHasNoMatch(t *testing.T) {
+	vk := buildVKWithID("vk-a", "sk-bf-a")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	// Querying by a bogus ID gives nothing.
+	_, ok := gs.GetVirtualKeyByID(context.Background(), "wrong-id")
+	assert.False(t, ok)
+	// The value-based path is still reachable for the real value.
+	got, okVal := gs.GetVirtualKey(context.Background(), "sk-bf-a")
+	require.True(t, okVal)
+	assert.Equal(t, "vk-a", got.ID)
+}
+
+// Locks the trust contract: when X-Bifrost-VK-ID is set, the parser drops
+// any value-based header (no secret read) and the store resolves by ID
+// without checking the held secret. Ingress Envoy is the only thing
+// stopping a client-supplied header from reaching this path.
+func TestVKIDHeader_TrustAssumption_NoSecretCheckOnIDPath(t *testing.T) {
+	vk := buildVKWithID("vk-trusted", "sk-bf-real-secret")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+
+	// Client sends ID + a wrong secret. Wrong secret must NOT block the
+	// request — Envoy already validated JWT/OAuth and injected the ID.
+	ctx := reqWithHeaders(map[string]string{
+		"X-Bifrost-VK-ID": "vk-trusted",
+		"Authorization":   "Bearer sk-bf-WRONG",
+	})
+	vkValue, vkID := ParseVirtualKeyFromFastHTTPRequest(ctx)
+	require.Nil(t, vkValue, "ID path must skip value-based lookup")
+	require.Equal(t, "vk-trusted", vkID)
+
+	got, ok := gs.GetVirtualKeyByID(context.Background(), vkID)
+	require.True(t, ok, "trusted-ID path must resolve without secret check")
+	assert.Equal(t, "sk-bf-real-secret", got.Value,
+		"store holds the real secret; resolver never compared against it")
+}
+
+// Locks the rebuild-clears-virtualKeysByID fix: a VK present before a full
+// reload but absent from the new dataset must NOT remain resolvable by ID.
+// Otherwise deleted/rotated VKs stay live on the inference path until process
+// restart (auth stale-grant).
+func TestRebuildInMemoryStructures_ClearsVirtualKeysByID(t *testing.T) {
+	vk := buildVKWithID("vk-stale", "sk-bf-stale")
+	gs := newStoreWithVKs(t, []configstoreTables.TableVirtualKey{*vk})
+	_, ok := gs.GetVirtualKeyByID(context.Background(), "vk-stale")
+	require.True(t, ok, "VK initially resolvable by ID")
+
+	// Simulate a config reload that no longer contains vk-stale.
+	gs.rebuildInMemoryStructures(context.Background(), nil, nil, nil, nil, nil, nil, nil, nil, nil)
+
+	_, ok = gs.GetVirtualKeyByID(context.Background(), "vk-stale")
+	assert.False(t, ok, "stale VK must NOT be resolvable by ID after rebuild")
+}
