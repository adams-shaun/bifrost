+func TestDeleteUser_Success_AndEvictsFromCache(t *testing.T) {
+	h, cs, mgr := newUserHandler(t)
+	u := &configstoreTables.TableUser{ID: "u1", Name: "alice"}
+	require.NoError(t, cs.CreateUser(context.Background(), u))
+
+	ctx := userReqCtx("DELETE", "")
