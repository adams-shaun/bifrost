+func TestUpdateUser_RenameAndEmailChange(t *testing.T) {
+	h, cs, mgr := newUserHandler(t)
+	u := &configstoreTables.TableUser{ID: "u1", Name: "alice", Email: "alice@example.com"}
+	require.NoError(t, cs.CreateUser(context.Background(), u))
+
+	ctx := userReqCtx("PUT", `{"name":"alice-renamed","email":"alice2@example.com"}`)
+	ctx.SetUserValue("user_id", "u1")
+	h.updateUser(ctx)
+
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+	persisted, err := cs.GetUser(context.Background(), "u1")
+	require.NoError(t, err)
+	assert.Equal(t, "alice-renamed", persisted.Name)
+	assert.Equal(t, "alice2@example.com", persisted.Email)
+	// In-memory cache should be reloaded so the next governance check sees
+	// the new state without waiting for the periodic refresh.
+	require.Contains(t, mgr.reloaded, "u1")
+}
