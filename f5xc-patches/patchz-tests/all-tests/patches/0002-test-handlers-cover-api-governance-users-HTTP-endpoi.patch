+// =============================================================================
+// Full create → get → update → delete lifecycle, verified end-to-end via
+// the actual handlers
+// =============================================================================
+
+func TestUserHandler_FullLifecycle(t *testing.T) {
+	h, cs, mgr := newUserHandler(t)
+
+	// CREATE
+	createCtx := userReqCtx("POST", `{
+		"name": "lifecycle-user",
+		"email": "lifecycle@example.com",
+		"budget": {"max_limit": 50, "reset_duration": "1h"}
+	}`)
+	h.createUser(createCtx)
+	require.Equal(t, 200, createCtx.Response.StatusCode(), "body: %s", createCtx.Response.Body())
+	created := extractUserFromResponse(t, createCtx.Response.Body())
+	require.NotEmpty(t, created.ID)
+	require.Len(t, created.Budgets, 1)
+
+	// GET
+	getCtx := userReqCtx("GET", "")
+	getCtx.SetUserValue("user_id", created.ID)
+	h.getUser(getCtx)
+	require.Equal(t, 200, getCtx.Response.StatusCode())
+
+	// PUT (update email)
+	putCtx := userReqCtx("PUT", `{"email":"updated@example.com"}`)
+	putCtx.SetUserValue("user_id", created.ID)
+	h.updateUser(putCtx)
+	require.Equal(t, 200, putCtx.Response.StatusCode())
+	persisted, err := cs.GetUser(context.Background(), created.ID)
+	require.NoError(t, err)
+	assert.Equal(t, "updated@example.com", persisted.Email)
+	assert.Equal(t, "lifecycle-user", persisted.Name)
+	// Budget still attached.
+	require.Len(t, persisted.Budgets, 1)
+	assert.Equal(t, 50.0, persisted.Budgets[0].MaxLimit)
+
+	// DELETE
+	delCtx := userReqCtx("DELETE", "")
+	delCtx.SetUserValue("user_id", created.ID)
+	h.deleteUser(delCtx)
+	require.Equal(t, 200, delCtx.Response.StatusCode())
+	_, err = cs.GetUser(context.Background(), created.ID)
+	assert.Equal(t, configstore.ErrNotFound, err)
+
+	// Governance manager should have observed: reload (create), reload (PUT),
+	// remove (DELETE).
+	assert.GreaterOrEqual(t, len(mgr.reloaded), 2, "reload called on create and update")
+	assert.Contains(t, mgr.removed, created.ID)
+}
