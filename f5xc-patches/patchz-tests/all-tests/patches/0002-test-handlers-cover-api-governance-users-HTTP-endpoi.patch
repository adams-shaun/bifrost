+func TestCreateUser_Success_MinimalFields(t *testing.T) {
+	h, cs, mgr := newUserHandler(t)
+
+	ctx := userReqCtx("POST", `{"name":"alice","email":"alice@example.com"}`)
+	h.createUser(ctx)
+
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+	got := extractUserFromResponse(t, ctx.Response.Body())
+	assert.NotEmpty(t, got.ID, "server-generated UUID expected")
+	assert.Equal(t, "alice", got.Name)
+	assert.Equal(t, "alice@example.com", got.Email)
+	// User was persisted.
+	persisted, err := cs.GetUser(context.Background(), got.ID)
+	require.NoError(t, err)
+	assert.Equal(t, "alice", persisted.Name)
+	// Governance cache was warmed.
+	require.Len(t, mgr.reloaded, 1)
+	assert.Equal(t, got.ID, mgr.reloaded[0])
+}
+
