+// userTrackingGovernanceManager records ReloadUser/RemoveUser invocations
+// and returns the row from the supplied configStore so the handler's
+// happy-path can stuff the loaded user into the response.
+type userTrackingGovernanceManager struct {
+	GovernanceManager
+	cs        *userTestConfigStore
+	reloaded  []string
+	removed   []string
+	reloadErr error
+	removeErr error
+}
+
+func (m *userTrackingGovernanceManager) ReloadUser(ctx context.Context, id string) (*configstoreTables.TableUser, error) {
+	m.reloaded = append(m.reloaded, id)
+	if m.reloadErr != nil {
+		return nil, m.reloadErr
+	}
+	return m.cs.GetUser(ctx, id)
+}
+
+func (m *userTrackingGovernanceManager) RemoveUser(ctx context.Context, id string) error {
+	m.removed = append(m.removed, id)
+	return m.removeErr
+}
+
+func (m *userTrackingGovernanceManager) GetGovernanceData(ctx context.Context) *governance.GovernanceData {
+	return nil
+}
+
+// =============================================================================
+// Helpers
+// =============================================================================
+
+func newUserHandler(t *testing.T) (*GovernanceHandler, *userTestConfigStore, *userTrackingGovernanceManager) {
+	t.Helper()
+	SetLogger(&mockLogger{})
+	cs := newUserTestConfigStore(t)
+	mgr := &userTrackingGovernanceManager{cs: cs}
+	h, err := NewGovernanceHandler(mgr, cs)
+	require.NoError(t, err)
+	return h, cs, mgr
+}
+
+func userReqCtx(method, body string) *fasthttp.RequestCtx {
+	ctx := &fasthttp.RequestCtx{}
+	ctx.Request.Header.SetMethod(method)
+	ctx.Request.Header.SetContentType("application/json")
+	ctx.Request.SetBody([]byte(body))
+	return ctx
+}
+
+// extractUserFromResponse pulls the `user` object out of a wrapped success
+// response: {"message": "...", "user": {...}}.
+func extractUserFromResponse(t *testing.T, body []byte) configstoreTables.TableUser {
+	t.Helper()
+	var wrap struct {
+		Message string                       `json:"message"`
+		User    configstoreTables.TableUser  `json:"user"`
+	}
+	require.NoError(t, json.Unmarshal(body, &wrap))
+	return wrap.User
+}
