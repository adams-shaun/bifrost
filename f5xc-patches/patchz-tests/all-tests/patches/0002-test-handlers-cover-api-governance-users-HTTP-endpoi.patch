+func TestCreateUser_WithBudget_BudgetLinkedToUser(t *testing.T) {
+	h, cs, _ := newUserHandler(t)
+
+	ctx := userReqCtx("POST", `{
+		"name": "bob",
+		"email": "bob@example.com",
+		"budget": {
+			"max_limit": 500.0,
+			"reset_duration": "1h"
+		}
+	}`)
+	h.createUser(ctx)
+	require.Equal(t, 200, ctx.Response.StatusCode(), "body: %s", ctx.Response.Body())
+
+	got := extractUserFromResponse(t, ctx.Response.Body())
+	persisted, err := cs.GetUser(context.Background(), got.ID)
+	require.NoError(t, err)
+	require.Len(t, persisted.Budgets, 1, "budget should be created and linked")
+	assert.Equal(t, 500.0, persisted.Budgets[0].MaxLimit)
+	assert.Equal(t, "1h", persisted.Budgets[0].ResetDuration)
+	require.NotNil(t, persisted.Budgets[0].UserID)
+	assert.Equal(t, got.ID, *persisted.Budgets[0].UserID, "budget FK points back to the user")
+}
