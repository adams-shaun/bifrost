+// =============================================================================
+// HTTP handler tests for /api/governance/users endpoints (patch1/user-support).
+//
+// These exercise createUser (POST), getUser (GET), updateUser (PUT),
+// deleteUser (DELETE), and getUsers (LIST) by driving the handler with a
+// real in-memory SQLite-backed ConfigStore mock and a tracking
+// GovernanceManager mock.
+//
+// The ConfigStore mock embeds the configstore.ConfigStore interface so
+// unimplemented methods panic loudly — keeps the surface honest without
+// stubbing every method.
+// =============================================================================
+
+type userTestConfigStore struct {
+	configstore.ConfigStore
+	db *gorm.DB
+}
+
+func newUserTestConfigStore(t *testing.T) *userTestConfigStore {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{
+		Logger: gormlogger.Default.LogMode(gormlogger.Silent),
+	})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(1)
+	sqlDB.SetMaxIdleConns(1)
+	require.NoError(t, db.AutoMigrate(
+		&configstoreTables.TableUser{},
+		&configstoreTables.TableTeam{},
+		&configstoreTables.TableBudget{},
+		&configstoreTables.TableRateLimit{},
+		&configstoreTables.TableVirtualKey{},
+	))
+	return &userTestConfigStore{db: db}
+}
+
+func (s *userTestConfigStore) ExecuteTransaction(_ context.Context, fn func(*gorm.DB) error) error {
+	// Use a background context for the transaction itself: the fasthttp.RequestCtx
+	// supplied by the handler does not have its Done() channel wired up in test
+	// scaffolding, and database/sql will panic if it dereferences ctx.Done()
+	// during BeginTx.
+	return s.db.Transaction(fn)
+}
+
+func (s *userTestConfigStore) CreateUser(ctx context.Context, user *configstoreTables.TableUser, tx ...*gorm.DB) error {
+	db := s.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	if err := db.Session(&gorm.Session{}).Create(user).Error; err != nil {
+		// Mirror the real RDB store's UNIQUE-violation translation so the
+		// handler's errors.Is(err, ErrAlreadyExists) branch is exercised.
+		if strings.Contains(err.Error(), "UNIQUE constraint failed") {
+			return configstore.ErrAlreadyExists
+		}
+		return err
+	}
+	return nil
+}
+
+func (s *userTestConfigStore) UpdateUser(ctx context.Context, user *configstoreTables.TableUser, tx ...*gorm.DB) error {
+	db := s.db
+	if len(tx) > 0 && tx[0] != nil {
+		db = tx[0]
+	}
+	return db.Session(&gorm.Session{}).Save(user).Error
+}
+
+func (s *userTestConfigStore) GetUser(ctx context.Context, id string) (*configstoreTables.TableUser, error) {
+	var u configstoreTables.TableUser
+	if err := s.db.Session(&gorm.Session{}).
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Where("id = ?", id).
+		First(&u).Error; err != nil {
+		if err == gorm.ErrRecordNotFound {
+			return nil, configstore.ErrNotFound
+		}
+		return nil, err
+	}
+	if err := s.db.Session(&gorm.Session{}).
+		Model(&configstoreTables.TableVirtualKey{}).
+		Where("user_id = ?", id).
+		Count(&u.VirtualKeyCount).Error; err != nil {
+		return nil, err
+	}
+	return &u, nil
+}
+
+func (s *userTestConfigStore) GetUsers(ctx context.Context) ([]configstoreTables.TableUser, error) {
+	var out []configstoreTables.TableUser
+	err := s.db.Session(&gorm.Session{}).
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Order("created_at ASC").
+		Find(&out).Error
+	return out, err
+}
+
+func (s *userTestConfigStore) GetUsersPaginated(ctx context.Context, params configstore.UsersQueryParams) ([]configstoreTables.TableUser, int64, error) {
+	q := s.db.Session(&gorm.Session{}).Model(&configstoreTables.TableUser{})
+	if params.Search != "" {
+		ss := "%" + strings.ToLower(params.Search) + "%"
+		q = q.Where("LOWER(name) LIKE ? OR LOWER(email) LIKE ?", ss, ss)
+	}
+	if params.TeamID != "" {
+		q = q.Where("team_id = ?", params.TeamID)
+	}
+	var total int64
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, err
+	}
+	limit := params.Limit
+	if limit <= 0 {
+		limit = 50
+	}
+	var out []configstoreTables.TableUser
+	if err := q.Preload("Team").Preload("Budgets").Preload("RateLimit").
+		Order("created_at DESC").
+		Limit(limit).Offset(params.Offset).
+		Find(&out).Error; err != nil {
+		return nil, 0, err
+	}
+	return out, total, nil
+}
+
+func (s *userTestConfigStore) DeleteUser(ctx context.Context, id string) error {
+	return s.db.Session(&gorm.Session{}).Transaction(func(tx *gorm.DB) error {
+		var u configstoreTables.TableUser
+		if err := tx.Where("id = ?", id).First(&u).Error; err != nil {
+			if err == gorm.ErrRecordNotFound {
+				return configstore.ErrNotFound
+			}
+			return err
+		}
+		if err := tx.Where("user_id = ?", id).Delete(&configstoreTables.TableBudget{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Delete(&configstoreTables.TableUser{}, "id = ?", id).Error; err != nil {
+			return err
+		}
+		if u.RateLimitID != nil {
+			if err := tx.Delete(&configstoreTables.TableRateLimit{}, "id = ?", *u.RateLimitID).Error; err != nil {
+				return err
+			}
+		}
+		return tx.Model(&configstoreTables.TableVirtualKey{}).
+			Where("user_id = ?", id).
+			Update("user_id", nil).Error
+	})
+}
+
