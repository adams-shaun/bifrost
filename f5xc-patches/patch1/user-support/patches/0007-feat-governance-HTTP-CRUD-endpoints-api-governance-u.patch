+// getUser handles GET /api/governance/users/{user_id} — fetch a single user.
+func (h *GovernanceHandler) getUser(ctx *fasthttp.RequestCtx) {
+	userID := ctx.UserValue("user_id").(string)
+	user, err := h.configStore.GetUser(ctx, userID)
+	if err != nil {
+		if errors.Is(err, configstore.ErrNotFound) {
+			SendError(ctx, 404, "User not found")
+			return
+		}
+		SendError(ctx, 500, "Failed to retrieve user")
+		return
+	}
+	SendJSON(ctx, map[string]interface{}{
+		"user": user,
+	})
+}
+
+// updateUser handles PUT /api/governance/users/{user_id} — update fields.
+func (h *GovernanceHandler) updateUser(ctx *fasthttp.RequestCtx) {
+	userID := ctx.UserValue("user_id").(string)
+	var req UpdateUserRequest
+	if err := json.Unmarshal(ctx.PostBody(), &req); err != nil {
+		SendError(ctx, 400, "Invalid JSON")
+		return
+	}
+	user, err := h.configStore.GetUser(ctx, userID)
+	if err != nil {
+		if errors.Is(err, configstore.ErrNotFound) {
+			SendError(ctx, 404, "User not found")
+			return
+		}
+		SendError(ctx, 500, "Failed to retrieve user")
+		return
+	}
+	// Validate team membership change up front: there is no FK constraint on
+	// users.team_id, so without this check a non-existent team_id would be
+	// silently stored. Empty string is allowed and clears the team binding.
+	if req.TeamID != nil && *req.TeamID != "" {
+		if _, err := h.configStore.GetTeam(ctx, *req.TeamID); err != nil {
+			if errors.Is(err, configstore.ErrNotFound) {
+				SendError(ctx, 400, fmt.Sprintf("Team not found: %s", *req.TeamID))
+				return
+			}
+			logger.Error("failed to verify team: %v", err)
+			SendError(ctx, 500, "failed to verify team")
+			return
+		}
+	}
+	if err := h.configStore.ExecuteTransaction(ctx, func(tx *gorm.DB) error {
+		// Track rate-limit ID to delete after updating the user (to avoid FK ordering issues).
+		var rateLimitIDToDelete string
+		if req.Name != nil {
+			user.Name = *req.Name
+		}
+		if req.Email != nil {
+			user.Email = *req.Email
+		}
+		if req.ExternalID != nil {
+			user.ExternalID = *req.ExternalID
+		}
+		if req.TeamID != nil {
+			if *req.TeamID == "" {
+				user.TeamID = nil
+			} else {
+				user.TeamID = req.TeamID
+			}
+		}
+		// Apply budget — User has at most one budget (createUser only ever
+		// creates a single one). An empty body removes the existing budget.
+		if req.Budget != nil {
+			if isBudgetRemovalRequest(req.Budget) {
+				for _, existing := range user.Budgets {
+					if err := h.configStore.DeleteBudget(ctx, existing.ID, tx); err != nil {
+						return fmt.Errorf("failed to delete user budget: %w", err)
+					}
+				}
+				user.Budgets = nil
+			} else {
+				if req.Budget.MaxLimit == nil || req.Budget.ResetDuration == nil {
+					return &badRequestError{err: fmt.Errorf("budget requires both max_limit and reset_duration")}
+				}
+				if len(user.Budgets) > 0 {
+					existing := user.Budgets[0]
+					existing.MaxLimit = *req.Budget.MaxLimit
+					existing.ResetDuration = *req.Budget.ResetDuration
+					if err := validateBudget(&existing); err != nil {
+						return &badRequestError{err: fmt.Errorf("invalid budget: %w", err)}
+					}
+					if err := h.configStore.UpdateBudget(ctx, &existing, tx); err != nil {
+						return err
+					}
+					user.Budgets = []configstoreTables.TableBudget{existing}
+				} else {
+					budget := configstoreTables.TableBudget{
+						ID:            uuid.NewString(),
+						MaxLimit:      *req.Budget.MaxLimit,
+						ResetDuration: *req.Budget.ResetDuration,
+						LastReset:     budgetLastReset(false, *req.Budget.ResetDuration),
+						CurrentUsage:  0,
+						UserID:        &user.ID,
+					}
+					if err := validateBudget(&budget); err != nil {
+						return &badRequestError{err: fmt.Errorf("invalid budget: %w", err)}
+					}
+					if err := h.configStore.CreateBudget(ctx, &budget, tx); err != nil {
+						return err
+					}
+					user.Budgets = []configstoreTables.TableBudget{budget}
+				}
+			}
+		}
+		// Apply rate limit — mirror updateTeam: empty body removes, partial
+		// body updates an existing row in place, otherwise create a new one.
+		if req.RateLimit != nil {
+			if isRateLimitRemovalRequest(req.RateLimit) {
+				if user.RateLimitID != nil {
+					rateLimitIDToDelete = *user.RateLimitID
+					user.RateLimitID = nil
+					user.RateLimit = nil
+				}
+			} else if user.RateLimitID != nil {
+				rl := configstoreTables.TableRateLimit{}
+				if err := tx.First(&rl, "id = ?", *user.RateLimitID).Error; err != nil {
+					return err
+				}
+				rl.TokenMaxLimit = req.RateLimit.TokenMaxLimit
+				rl.TokenResetDuration = req.RateLimit.TokenResetDuration
+				rl.RequestMaxLimit = req.RateLimit.RequestMaxLimit
+				rl.RequestResetDuration = req.RateLimit.RequestResetDuration
+				if err := validateRateLimit(&rl); err != nil {
+					return &badRequestError{err: fmt.Errorf("invalid rate limit: %w", err)}
+				}
+				if err := h.configStore.UpdateRateLimit(ctx, &rl, tx); err != nil {
+					return err
+				}
+				user.RateLimit = &rl
+			} else {
+				rl := configstoreTables.TableRateLimit{
+					ID:                   uuid.NewString(),
+					TokenMaxLimit:        req.RateLimit.TokenMaxLimit,
+					TokenResetDuration:   req.RateLimit.TokenResetDuration,
+					RequestMaxLimit:      req.RateLimit.RequestMaxLimit,
+					RequestResetDuration: req.RateLimit.RequestResetDuration,
+					TokenLastReset:       time.Now(),
+					RequestLastReset:     time.Now(),
+				}
+				if err := validateRateLimit(&rl); err != nil {
+					return &badRequestError{err: fmt.Errorf("invalid rate limit: %w", err)}
+				}
+				if err := h.configStore.CreateRateLimit(ctx, &rl, tx); err != nil {
+					return err
+				}
+				user.RateLimitID = &rl.ID
+				user.RateLimit = &rl
+			}
+		}
+		if err := h.configStore.UpdateUser(ctx, user, tx); err != nil {
+			return err
+		}
+		// Now that user.RateLimitID has been nulled in DB, delete the orphan row.
+		if rateLimitIDToDelete != "" {
+			if err := tx.Delete(&configstoreTables.TableRateLimit{}, "id = ?", rateLimitIDToDelete).Error; err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		var badReqErr *badRequestError
+		if errors.As(err, &badReqErr) {
+			SendError(ctx, 400, err.Error())
+			return
+		}
+		if errors.Is(err, configstore.ErrAlreadyExists) {
+			SendError(ctx, 409, err.Error())
+			return
+		}
+		logger.Error("failed to update user: %v", err)
+		SendError(ctx, 500, "failed to update user")
+		return
+	}
+	preloaded, err := h.governanceManager.ReloadUser(ctx, userID)
+	if err != nil {
+		preloaded = user
+	}
+	SendJSON(ctx, map[string]interface{}{
+		"message": "User updated successfully",
+		"user":    preloaded,
+	})
+}
+
+// deleteUser handles DELETE /api/governance/users/{user_id} — delete a user.
+func (h *GovernanceHandler) deleteUser(ctx *fasthttp.RequestCtx) {
+	userID := ctx.UserValue("user_id").(string)
+	if err := h.configStore.DeleteUser(ctx, userID); err != nil {
+		if errors.Is(err, configstore.ErrNotFound) {
+			SendError(ctx, 404, "User not found")
+			return
+		}
+		SendError(ctx, 500, "Failed to delete user")
+		return
+	}
+	if err := h.governanceManager.RemoveUser(ctx, userID); err != nil {
+		logger.Error("failed to evict user from in-memory store: %v", err)
+	}
+	SendJSON(ctx, map[string]interface{}{
+		"message": "User deleted successfully",
+	})
+}
