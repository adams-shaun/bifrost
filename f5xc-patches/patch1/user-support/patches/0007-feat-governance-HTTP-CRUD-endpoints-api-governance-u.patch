+// ReloadUser reloads a user from the database into the in-memory store.
+func (s *BifrostHTTPServer) ReloadUser(ctx context.Context, id string) (*tables.TableUser, error) {
+	preloadedUser, err := s.Config.ConfigStore.GetUser(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	governancePlugin, err := s.getGovernancePlugin()
+	if err != nil {
+		return nil, err
+	}
+	governancePlugin.GetGovernanceStore().CreateUserInMemory(ctx, preloadedUser)
+	return preloadedUser, nil
+}
+
+// RemoveUser removes a user from the in-memory store.
+func (s *BifrostHTTPServer) RemoveUser(ctx context.Context, id string) error {
+	governancePlugin, err := s.getGovernancePlugin()
+	if err != nil {
+		return err
+	}
+	governancePlugin.GetGovernanceStore().DeleteUserInMemory(ctx, id)
+	return nil
+}
