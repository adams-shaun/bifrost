+// getUsers handles GET /api/governance/users — list users, paginated/filtered.
+func (h *GovernanceHandler) getUsers(ctx *fasthttp.RequestCtx) {
+	limitStr := string(ctx.QueryArgs().Peek("limit"))
+	offsetStr := string(ctx.QueryArgs().Peek("offset"))
+	search := string(ctx.QueryArgs().Peek("search"))
+	teamID := string(ctx.QueryArgs().Peek("team_id"))
+
+	if limitStr != "" || offsetStr != "" || search != "" || teamID != "" {
+		limit, _ := strconv.Atoi(limitStr)
+		offset, _ := strconv.Atoi(offsetStr)
+		limit, offset = ClampPaginationParams(limit, offset)
+		users, totalCount, err := h.configStore.GetUsersPaginated(ctx, configstore.UsersQueryParams{
+			Limit:  limit,
+			Offset: offset,
+			Search: search,
+			TeamID: teamID,
+		})
+		if err != nil {
+			logger.Error("failed to retrieve users: %v", err)
+			SendError(ctx, 500, "failed to retrieve users")
+			return
+		}
+		SendJSON(ctx, map[string]interface{}{
+			"users":       users,
+			"count":       len(users),
+			"total_count": totalCount,
+			"limit":       limit,
+			"offset":      offset,
+		})
+		return
+	}
+
+	users, err := h.configStore.GetUsers(ctx)
+	if err != nil {
+		logger.Error("failed to retrieve users: %v", err)
+		SendError(ctx, 500, "failed to retrieve users")
+		return
+	}
+	// Non-paginated path: report limit=0 to signal "no limit was applied"
+	// instead of len(users), which would falsely look like a paginated reply.
+	SendJSON(ctx, map[string]interface{}{
+		"users":       users,
+		"count":       len(users),
+		"total_count": len(users),
+		"limit":       0,
+		"offset":      0,
+	})
+}
+
+// createUser handles POST /api/governance/users — create a new user.
+func (h *GovernanceHandler) createUser(ctx *fasthttp.RequestCtx) {
+	var req CreateUserRequest
+	if err := json.Unmarshal(ctx.PostBody(), &req); err != nil {
+		SendError(ctx, 400, "Invalid JSON")
+		return
+	}
+	if req.Name == "" {
+		SendError(ctx, 400, "User name is required")
+		return
+	}
+	// Pre-validate rate limit before opening the transaction so callers get
+	// 400 instead of having to discover the validation failure as a 500.
+	if req.RateLimit != nil {
+		rl := configstoreTables.TableRateLimit{
+			TokenMaxLimit:        req.RateLimit.TokenMaxLimit,
+			TokenResetDuration:   req.RateLimit.TokenResetDuration,
+			RequestMaxLimit:      req.RateLimit.RequestMaxLimit,
+			RequestResetDuration: req.RateLimit.RequestResetDuration,
+		}
+		if err := validateRateLimit(&rl); err != nil {
+			SendError(ctx, 400, fmt.Sprintf("Invalid rate limit: %s", err.Error()))
+			return
+		}
+	}
+	// Reject dangling TeamID up front: there is no FK constraint on the
+	// column, so without this check a non-existent team_id would be silently
+	// stored.
+	if req.TeamID != nil && *req.TeamID != "" {
+		if _, err := h.configStore.GetTeam(ctx, *req.TeamID); err != nil {
+			if errors.Is(err, configstore.ErrNotFound) {
+				SendError(ctx, 400, fmt.Sprintf("Team not found: %s", *req.TeamID))
+				return
+			}
+			logger.Error("failed to verify team: %v", err)
+			SendError(ctx, 500, "failed to verify team")
+			return
+		}
+	}
+	var user configstoreTables.TableUser
+	if err := h.configStore.ExecuteTransaction(ctx, func(tx *gorm.DB) error {
+		user = configstoreTables.TableUser{
+			ID:         uuid.NewString(),
+			Name:       req.Name,
+			Email:      req.Email,
+			ExternalID: req.ExternalID,
+			TeamID:     req.TeamID,
+		}
+		if req.RateLimit != nil {
+			rl := configstoreTables.TableRateLimit{
+				ID:                   uuid.NewString(),
+				TokenMaxLimit:        req.RateLimit.TokenMaxLimit,
+				TokenResetDuration:   req.RateLimit.TokenResetDuration,
+				RequestMaxLimit:      req.RateLimit.RequestMaxLimit,
+				RequestResetDuration: req.RateLimit.RequestResetDuration,
+				TokenLastReset:       time.Now(),
+				RequestLastReset:     time.Now(),
+			}
+			if err := h.configStore.CreateRateLimit(ctx, &rl, tx); err != nil {
+				return err
+			}
+			user.RateLimitID = &rl.ID
+		}
+		if err := h.configStore.CreateUser(ctx, &user, tx); err != nil {
+			return err
+		}
+		if req.Budget != nil {
+			budget := configstoreTables.TableBudget{
+				ID:            uuid.NewString(),
+				MaxLimit:      req.Budget.MaxLimit,
+				ResetDuration: req.Budget.ResetDuration,
+				LastReset:     budgetLastReset(false, req.Budget.ResetDuration),
+				CurrentUsage:  0,
+				UserID:        &user.ID,
+			}
+			if err := validateBudget(&budget); err != nil {
+				return &badRequestError{err: fmt.Errorf("invalid budget: %w", err)}
+			}
+			if err := h.configStore.CreateBudget(ctx, &budget, tx); err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		var badReqErr *badRequestError
+		if errors.As(err, &badReqErr) {
+			SendError(ctx, 400, err.Error())
+			return
+		}
+		if errors.Is(err, configstore.ErrAlreadyExists) {
+			SendError(ctx, 409, "User already exists")
+			return
+		}
+		logger.Error("failed to create user: %v", err)
+		SendError(ctx, 500, "failed to create user")
+		return
+	}
+	preloaded, err := h.governanceManager.ReloadUser(ctx, user.ID)
+	if err != nil {
+		logger.Error("failed to reload user: %v", err)
+		preloaded = &user
+	}
+	SendJSON(ctx, map[string]interface{}{
+		"message": "User created successfully",
+		"user":    preloaded,
+	})
+}
