+// migrationAddGovernanceUsersTable creates the governance_users table.
+// Idempotent: skipped if the table already exists.
+func migrationAddGovernanceUsersTable(ctx context.Context, db *gorm.DB) error {
+	m := migrator.New(db, migrator.DefaultOptions, []*migrator.Migration{{
+		ID: "add_governance_users_table",
+		Migrate: func(tx *gorm.DB) error {
+			tx = tx.WithContext(ctx)
+			mig := tx.Migrator()
+			if !mig.HasTable(&tables.TableUser{}) {
+				if err := mig.CreateTable(&tables.TableUser{}); err != nil {
+					return fmt.Errorf("failed to create governance_users table: %w", err)
+				}
+			}
+			return nil
+		},
+		Rollback: func(tx *gorm.DB) error {
+			tx = tx.WithContext(ctx)
+			mig := tx.Migrator()
+			if mig.HasTable(&tables.TableUser{}) {
+				if err := mig.DropTable(&tables.TableUser{}); err != nil {
+					return err
+				}
+			}
+			return nil
+		},
+	}})
+	if err := m.Migrate(); err != nil {
+		return fmt.Errorf("error running add_governance_users_table migration: %s", err.Error())
+	}
+	return nil
+}
+
+// migrationAddVirtualKeyUserIDColumn adds the optional user_id FK column to
+// governance_virtual_keys, allowing a VK to be pinned to a user (alongside
+// the existing team / customer / access-profile owners).
+func migrationAddVirtualKeyUserIDColumn(ctx context.Context, db *gorm.DB) error {
+	m := migrator.New(db, migrator.DefaultOptions, []*migrator.Migration{{
+		ID: "add_virtual_key_user_id_column",
+		Migrate: func(tx *gorm.DB) error {
+			tx = tx.WithContext(ctx)
+			mig := tx.Migrator()
+			if !mig.HasColumn(&tables.TableVirtualKey{}, "user_id") {
+				if err := mig.AddColumn(&tables.TableVirtualKey{}, "user_id"); err != nil {
+					return fmt.Errorf("failed to add user_id column to governance_virtual_keys: %w", err)
+				}
+			}
+			// AddColumn does not honor the `index` struct tag — every GetUser
+			// runs a per-call VK count WHERE user_id = ? and DeleteUser scans
+			// to null user_id on matching VKs, so an unindexed column would
+			// regress hot-path queries at tenant scale.
+			if !mig.HasIndex(&tables.TableVirtualKey{}, "idx_governance_virtual_keys_user_id") {
+				if err := mig.CreateIndex(&tables.TableVirtualKey{}, "UserID"); err != nil {
+					return fmt.Errorf("failed to create index on governance_virtual_keys.user_id: %w", err)
+				}
+			}
+			return nil
+		},
+		Rollback: func(tx *gorm.DB) error {
+			tx = tx.WithContext(ctx)
+			mig := tx.Migrator()
+			if mig.HasIndex(&tables.TableVirtualKey{}, "idx_governance_virtual_keys_user_id") {
+				if err := mig.DropIndex(&tables.TableVirtualKey{}, "idx_governance_virtual_keys_user_id"); err != nil {
+					return err
+				}
+			}
+			if mig.HasColumn(&tables.TableVirtualKey{}, "user_id") {
+				if err := mig.DropColumn(&tables.TableVirtualKey{}, "user_id"); err != nil {
+					return err
+				}
+			}
+			return nil
+		},
+	}})
+	if err := m.Migrate(); err != nil {
+		return fmt.Errorf("error running add_virtual_key_user_id_column migration: %s", err.Error())
+	}
+	return nil
+}
+
+// migrationAddBudgetUserIDColumn adds the optional user_id FK column to
+// governance_budgets, allowing a budget to be owned by a user.
+func migrationAddBudgetUserIDColumn(ctx context.Context, db *gorm.DB) error {
+	m := migrator.New(db, migrator.DefaultOptions, []*migrator.Migration{{
+		ID: "add_budget_user_id_column",
+		Migrate: func(tx *gorm.DB) error {
+			tx = tx.WithContext(ctx)
+			mig := tx.Migrator()
+			if !mig.HasColumn(&tables.TableBudget{}, "user_id") {
+				if err := mig.AddColumn(&tables.TableBudget{}, "user_id"); err != nil {
+					return fmt.Errorf("failed to add user_id column to governance_budgets: %w", err)
+				}
+			}
+			// AddColumn does not honor the `index` struct tag — user-budget
+			// lookups and the DeleteUser cascade scan on this column, so leave
+			// it unindexed regresses the hot path.
+			if !mig.HasIndex(&tables.TableBudget{}, "idx_governance_budgets_user_id") {
+				if err := mig.CreateIndex(&tables.TableBudget{}, "UserID"); err != nil {
+					return fmt.Errorf("failed to create index on governance_budgets.user_id: %w", err)
+				}
+			}
+			return nil
+		},
+		Rollback: func(tx *gorm.DB) error {
+			tx = tx.WithContext(ctx)
+			mig := tx.Migrator()
+			if mig.HasIndex(&tables.TableBudget{}, "idx_governance_budgets_user_id") {
+				if err := mig.DropIndex(&tables.TableBudget{}, "idx_governance_budgets_user_id"); err != nil {
+					return err
+				}
+			}
+			if mig.HasColumn(&tables.TableBudget{}, "user_id") {
+				if err := mig.DropColumn(&tables.TableBudget{}, "user_id"); err != nil {
+					return err
+				}
+			}
+			return nil
+		},
+	}})
+	if err := m.Migrate(); err != nil {
+		return fmt.Errorf("error running add_budget_user_id_column migration: %s", err.Error())
+	}
+	return nil
+}
