From 6f961b5694a4daa1793988273c5b0807329f79da Mon Sep 17 00:00:00 2001
From: sadams <s.adams@f5.com>
Date: Mon, 8 Jun 2026 20:37:30 +0000
Subject: [PATCH] feat(governance): fill Users in GetGovernanceData snapshot

GetGovernanceData declared a Users field but never populated it, so the
aggregate snapshot was always blind to users even though patch1 populates the
gs.users cache on reload. Range gs.users into the lightweight UserGovernance
view (RateLimitID + BudgetIDs), mirroring GetUserGovernance, and fill the
return literal. Unblocks config reconciliation built on the snapshot.

Ref: https://jira.f5net.com/browse/XC-24346
---
 plugins/governance/store.go | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/plugins/governance/store.go b/plugins/governance/store.go
index d55e4a5dc..88e8e2b29 100644
--- a/plugins/governance/store.go
+++ b/plugins/governance/store.go
@@ -798,10 +798,31 @@ func (gs *LocalGovernanceStore) GetGovernanceData(ctx context.Context) *Governan
 	sort.Slice(providersList, func(i, j int) bool {
 		return providersList[i].CreatedAt.Before(providersList[j].CreatedAt)
 	})
+	// Users: derive the lightweight UserGovernance view from the gs.users cache,
+	// mirroring GetUserGovernance. Without this the snapshot's Users map is always
+	// nil, so aggregate consumers (e.g. config reconciliation) are blind to users
+	// even though the cache is populated on reload.
+	users := make(map[string]*UserGovernance)
+	gs.users.Range(func(key, value interface{}) bool {
+		user, ok := value.(*configstoreTables.TableUser)
+		if !ok || user == nil {
+			return true // continue
+		}
+		g := &UserGovernance{RateLimitID: user.RateLimitID}
+		if len(user.Budgets) > 0 {
+			g.BudgetIDs = make([]string, 0, len(user.Budgets))
+			for _, b := range user.Budgets {
+				g.BudgetIDs = append(g.BudgetIDs, b.ID)
+			}
+		}
+		users[key.(string)] = g
+		return true // continue iteration
+	})
 	return &GovernanceData{
 		VirtualKeys:  virtualKeys,
 		Teams:        teams,
 		Customers:    customers,
+		Users:        users,
 		Budgets:      budgets,
 		RateLimits:   rateLimits,
 		RoutingRules: routingRules,
