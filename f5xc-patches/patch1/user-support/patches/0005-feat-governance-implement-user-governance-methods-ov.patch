From 3a465e765c7ee0d674913834d256409539dc847a Mon Sep 17 00:00:00 2001
From: Sanju Abraham <s.abraham@f5.com>
Date: Thu, 28 May 2026 00:28:31 -0700
Subject: [PATCH 5/8] feat(governance): implement user governance methods over
 cached *TableUser
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Promotes the OSS user-governance stubs from no-ops to real implementations
that read from gs.users (populated by the reload path):

- GetUserGovernance: returns a *UserGovernance view derived from the
  cached user (first budget + RateLimitID).
- CheckUserBudget: walks user.Budgets, hot-loads via gs.LoadBudget, and
  delegates to gs.CheckBudget. Mirrors CheckTeamBudget exactly.
- CheckUserRateLimit: loads user.RateLimit via gs.LoadRateLimit and
  delegates to gs.CheckRateLimit. Mirrors CheckTeamRateLimit.
- UpdateUserBudgetUsageInMemory: bumps every budget owned by the user
  via gs.BumpBudgetUsage.
- UpdateUserRateLimitUsageInMemory: bumps the user's rate-limit counters
  via gs.BumpRateLimitUsage.

Adds team-parallel concrete methods (not on the GovernanceStore
interface) used by reload + HTTP-API:

- CreateUserInMemory(ctx, user *TableUser)
- UpdateUserInMemory(ctx, user *TableUser)
- DeleteUserInMemory(ctx, userID string)

The existing Create/Update/DeleteUserGovernanceInMemory(userID, budget,
rateLimit) methods are kept as no-ops to preserve the GovernanceStore
interface contract — they were designed for an enterprise-driven
"set bindings on existing user" path. OSS callers should use the new
team-style methods instead.
---
 plugins/governance/store.go | 161 ++++++++++++++++++++++++++++++------
 1 file changed, 135 insertions(+), 26 deletions(-)

diff --git a/plugins/governance/store.go b/plugins/governance/store.go
index ae1e0b4df..9f635d0f8 100644
--- a/plugins/governance/store.go
+++ b/plugins/governance/store.go
@@ -74,10 +74,13 @@ type BusinessUnitGovernance struct {
 	RateLimitID *string
 }
 
-// UserGovernance holds governance data for a user (enterprise-only)
+// UserGovernance holds the lightweight governance view for a user.
+// BudgetIDs exposes every owned budget (a user may have multiple budgets at
+// different reset durations). CheckUserBudget is the canonical multi-budget
+// enforcement path; this view is intended for consumers that need IDs only.
 type UserGovernance struct {
-	BudgetID    *string `json:"budget_id,omitempty"`
-	RateLimitID *string `json:"rate_limit_id,omitempty"`
+	BudgetIDs   []string `json:"budget_ids,omitempty"`
+	RateLimitID *string  `json:"rate_limit_id,omitempty"`
 }
 
 // BudgetAndRateLimitStatus represents the current budget and rate limit usage state
@@ -1176,10 +1179,34 @@ func (gs *LocalGovernanceStore) CheckCustomerRateLimit(ctx context.Context, cust
 	return gs.CheckRateLimit(ctx, entityWiseRateLimits, tokensBaselines, requestsBaselines)
 }
 
-// CheckUserBudget checks if user's budget allows the request (enterprise-only)
-// Community build: silent no-op so user-governance absence never silently denies requests.
+// CheckUserBudget checks if user's budget allows the request.
+// Walks every budget owned by the user. Rejects via gs.CheckBudget if any one is exhausted.
 func (gs *LocalGovernanceStore) CheckUserBudget(ctx context.Context, userID string, request *EvaluationRequest, baselines map[string]float64) (Decision, error) {
-	return DecisionAllow, nil
+	if userID == "" {
+		return DecisionAllow, nil
+	}
+	if baselines == nil {
+		baselines = map[string]float64{}
+	}
+	userValue, exists := gs.users.Load(userID)
+	if !exists || userValue == nil {
+		return DecisionAllow, nil
+	}
+	user, ok := userValue.(*configstoreTables.TableUser)
+	if !ok || len(user.Budgets) == 0 {
+		return DecisionAllow, nil
+	}
+	list := make([]*configstoreTables.TableBudget, 0, len(user.Budgets))
+	for _, b := range user.Budgets {
+		if hot := gs.LoadBudget(ctx, b.ID); hot != nil {
+			list = append(list, hot)
+		}
+	}
+	if len(list) == 0 {
+		return DecisionAllow, nil
+	}
+	key := fmt.Sprintf("User:%s", userID)
+	return gs.CheckBudget(ctx, EntityWiseBudgets{key: list}, baselines)
 }
 
 // CheckModelRateLimit checks model-level rate limits and returns evaluation result if violated
@@ -1225,10 +1252,32 @@ func (gs *LocalGovernanceStore) CheckModelRateLimit(ctx context.Context, request
 	return gs.CheckRateLimit(ctx, entityWiseRateLimits, tokensBaselines, requestsBaselines)
 }
 
-// CheckUserRateLimit checks if user's rate limit allows the request (enterprise-only)
-// Community build: silent no-op so user-governance absence never silently denies requests.
+// CheckUserRateLimit checks if user's rate limit allows the request.
 func (gs *LocalGovernanceStore) CheckUserRateLimit(ctx context.Context, userID string, request *EvaluationRequest, tokensBaselines map[string]int64, requestsBaselines map[string]int64) (Decision, error) {
-	return DecisionAllow, nil
+	if userID == "" {
+		return DecisionAllow, nil
+	}
+	if tokensBaselines == nil {
+		tokensBaselines = map[string]int64{}
+	}
+	if requestsBaselines == nil {
+		requestsBaselines = map[string]int64{}
+	}
+	userValue, exists := gs.users.Load(userID)
+	if !exists || userValue == nil {
+		return DecisionAllow, nil
+	}
+	user, ok := userValue.(*configstoreTables.TableUser)
+	if !ok || user.RateLimitID == nil {
+		return DecisionAllow, nil
+	}
+	userRateLimit := gs.LoadRateLimit(ctx, *user.RateLimitID)
+	if userRateLimit == nil {
+		return DecisionAllow, nil
+	}
+	key := fmt.Sprintf("User:%s", userID)
+	entityWiseRateLimits := EntityWiseRateLimits{key: {userRateLimit}}
+	return gs.CheckRateLimit(ctx, entityWiseRateLimits, tokensBaselines, requestsBaselines)
 }
 
 // CheckVirtualKeyRateLimit checks a virtual key  rate limit and returns evaluation result if violated (true if violated, false if not)
@@ -1303,9 +1352,24 @@ func (gs *LocalGovernanceStore) UpdateProviderAndModelBudgetUsageInMemory(ctx co
 	return nil
 }
 
-// UpdateUserBudgetUsageInMemory updates user's budget usage in memory (enterprise-only)
-// Community build: silent no-op to avoid per-request error spam when a userID is set.
+// UpdateUserBudgetUsageInMemory bumps every budget owned by the user by `cost`.
 func (gs *LocalGovernanceStore) UpdateUserBudgetUsageInMemory(ctx context.Context, userID string, cost float64) error {
+	if userID == "" {
+		return nil
+	}
+	userValue, exists := gs.users.Load(userID)
+	if !exists || userValue == nil {
+		return nil
+	}
+	user, ok := userValue.(*configstoreTables.TableUser)
+	if !ok || len(user.Budgets) == 0 {
+		return nil
+	}
+	for _, b := range user.Budgets {
+		if err := gs.BumpBudgetUsage(ctx, b.ID, cost); err != nil {
+			return err
+		}
+	}
 	return nil
 }
 
@@ -1362,10 +1426,20 @@ func (gs *LocalGovernanceStore) UpdateVirtualKeyRateLimitUsageInMemory(ctx conte
 	return nil
 }
 
-// UpdateUserRateLimitUsageInMemory updates user's rate limit usage in memory (enterprise-only)
-// Community build: silent no-op to avoid per-request error spam when a userID is set.
+// UpdateUserRateLimitUsageInMemory bumps the rate-limit counters attached to the user.
 func (gs *LocalGovernanceStore) UpdateUserRateLimitUsageInMemory(ctx context.Context, userID string, tokensUsed int64, shouldUpdateTokens bool, shouldUpdateRequests bool) error {
-	return nil
+	if userID == "" {
+		return nil
+	}
+	userValue, exists := gs.users.Load(userID)
+	if !exists || userValue == nil {
+		return nil
+	}
+	user, ok := userValue.(*configstoreTables.TableUser)
+	if !ok || user.RateLimitID == nil {
+		return nil
+	}
+	return gs.BumpRateLimitUsage(ctx, *user.RateLimitID, tokensUsed, shouldUpdateTokens, shouldUpdateRequests)
 }
 
 // ResetExpiredBudgetsInMemory checks and resets budgets that have exceeded their reset duration.
@@ -2874,28 +2948,63 @@ func (gs *LocalGovernanceStore) DeleteCustomerInMemory(ctx context.Context, cust
 	gs.customers.Delete(customerID)
 }
 
-// GetUserGovernance retrieves user governance data by user ID (enterprise-only, lock-free)
+// GetUserGovernance retrieves the lightweight UserGovernance view (BudgetID, RateLimitID)
+// for a user, derived from the cached *TableUser. Returns false if no such user.
 func (gs *LocalGovernanceStore) GetUserGovernance(ctx context.Context, userID string) (*UserGovernance, bool) {
-	// User governance is part of enterprise
-	return nil, false
+	userValue, exists := gs.users.Load(userID)
+	if !exists || userValue == nil {
+		return nil, false
+	}
+	user, ok := userValue.(*configstoreTables.TableUser)
+	if !ok {
+		return nil, false
+	}
+	g := &UserGovernance{RateLimitID: user.RateLimitID}
+	if len(user.Budgets) > 0 {
+		g.BudgetIDs = make([]string, 0, len(user.Budgets))
+		for _, b := range user.Budgets {
+			g.BudgetIDs = append(g.BudgetIDs, b.ID)
+		}
+	}
+	return g, true
+}
+
+// CreateUserInMemory stores a fully-loaded *TableUser (with preloaded Budgets,
+// RateLimit, Team) into the in-memory cache. Mirrors CreateTeamInMemory. Used
+// by the reload path and HTTP user-CRUD handlers to keep gs.users in sync.
+func (gs *LocalGovernanceStore) CreateUserInMemory(ctx context.Context, user *configstoreTables.TableUser) {
+	if user == nil {
+		return
+	}
+	gs.users.Store(user.ID, user)
+}
+
+// UpdateUserInMemory replaces the cached *TableUser. Mirrors UpdateTeamInMemory.
+func (gs *LocalGovernanceStore) UpdateUserInMemory(ctx context.Context, user *configstoreTables.TableUser) {
+	if user == nil {
+		return
+	}
+	gs.users.Store(user.ID, user)
+}
+
+// DeleteUserInMemory removes the cached *TableUser.
+func (gs *LocalGovernanceStore) DeleteUserInMemory(ctx context.Context, userID string) {
+	gs.users.Delete(userID)
 }
 
-// CreateUserGovernanceInMemory adds user governance data to the in-memory store (enterprise-only)
+// CreateUserGovernanceInMemory remains for interface compatibility with the
+// enterprise "set bindings on existing user" path. OSS code uses
+// CreateUserInMemory directly; this is a no-op in the OSS build.
 func (gs *LocalGovernanceStore) CreateUserGovernanceInMemory(ctx context.Context, userID string, budget *configstoreTables.TableBudget, rateLimit *configstoreTables.TableRateLimit) {
-	// NoOp
-	// Available in enterprise
 }
 
-// UpdateUserGovernanceInMemory updates user governance data in the in-memory store (enterprise-only)
+// UpdateUserGovernanceInMemory — see CreateUserGovernanceInMemory.
 func (gs *LocalGovernanceStore) UpdateUserGovernanceInMemory(ctx context.Context, userID string, budget *configstoreTables.TableBudget, rateLimit *configstoreTables.TableRateLimit) {
-	// NoOp
-	// Available in enterprise
 }
 
-// DeleteUserGovernanceInMemory removes user governance data from the in-memory store (enterprise-only)
+// DeleteUserGovernanceInMemory — see CreateUserGovernanceInMemory. OSS callers
+// should use DeleteUserInMemory.
 func (gs *LocalGovernanceStore) DeleteUserGovernanceInMemory(ctx context.Context, userID string) {
-	// NoOp
-	// Available in enterprise
 }
 
 // UpdateModelConfigInMemory adds or updates a model config in the in-memory store (lock-free)
