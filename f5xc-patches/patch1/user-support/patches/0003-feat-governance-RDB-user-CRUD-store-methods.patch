From: Sanju Abraham <s.abraham@f5.com>
Date: Thu, 28 May 2026 00:00:23 -0700
Subject: [PATCH 3/8] feat(governance): RDB user CRUD store methods

Adds CreateUser/GetUser/UpdateUser/DeleteUser/GetUsersPaginated to
RDBConfigStore. Mirrors the existing team CRUD logic in rdb.go using
the current variadic `tx ...*gorm.DB` signature, parseGormError
wrapping, and dbForUpdate semantics.

UsersQueryParams supports pagination, search by name/email
(case-insensitive substring), and filter by TeamID; the User CRUD
interface declarations slot between Team CRUD and Customer CRUD
in store.go's ConfigStore interface.
---
 framework/configstore/rdb.go   | 158 +++++++++++++++++++++++++++++++++
 framework/configstore/store.go |  17 ++++
 2 files changed, 175 insertions(+)

diff --git a/framework/configstore/rdb.go b/framework/configstore/rdb.go
index dc95f5f39..fddaeb93f 100644
--- a/framework/configstore/rdb.go
+++ b/framework/configstore/rdb.go
@@ -5156,3 +5156,161 @@ func (s *RDBConfigStore) DeleteOrphanedOauthUserTokens(ctx context.Context, olde
 	}
 	return result.RowsAffected, nil
 }
+
+// CreateUser creates a new user in the database.
+func (s *RDBConfigStore) CreateUser(ctx context.Context, user *tables.TableUser, tx ...*gorm.DB) error {
+	var txDB *gorm.DB
+	if len(tx) > 0 {
+		txDB = tx[0]
+	} else {
+		txDB = s.DB()
+	}
+	if err := txDB.WithContext(ctx).Create(user).Error; err != nil {
+		return s.parseGormError(err)
+	}
+	return nil
+}
+
+// GetUser retrieves a user by ID, preloading team, budgets, rate limit, and a
+// computed virtual-key count.
+func (s *RDBConfigStore) GetUser(ctx context.Context, id string) (*tables.TableUser, error) {
+	var user tables.TableUser
+	if err := s.DB().WithContext(ctx).
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Where("id = ?", id).
+		First(&user).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, ErrNotFound
+		}
+		return nil, err
+	}
+	if err := s.DB().WithContext(ctx).
+		Model(&tables.TableVirtualKey{}).
+		Where("user_id = ?", id).
+		Count(&user.VirtualKeyCount).Error; err != nil {
+		return nil, err
+	}
+	return &user, nil
+}
+
+// GetUsersPaginated retrieves users with pagination, filtering, and search support.
+func (s *RDBConfigStore) GetUsersPaginated(ctx context.Context, params UsersQueryParams) ([]tables.TableUser, int64, error) {
+	baseQuery := s.DB().WithContext(ctx).Model(&tables.TableUser{})
+
+	if params.TeamID != "" {
+		baseQuery = baseQuery.Where("team_id = ?", params.TeamID)
+	}
+	if params.Search != "" {
+		search := "%" + strings.ToLower(params.Search) + "%"
+		baseQuery = baseQuery.Where("LOWER(name) LIKE ? OR LOWER(email) LIKE ?", search, search)
+	}
+
+	var totalCount int64
+	if err := baseQuery.Count(&totalCount).Error; err != nil {
+		return nil, 0, err
+	}
+
+	// Whitelist the OrderField against TableUser's known sortable columns.
+	// params.OrderField is caller-controlled; interpolating it raw into the
+	// ORDER BY clause would be a SQL-identifier injection vector.
+	allowedOrderFields := map[string]bool{
+		"created_at":  true,
+		"updated_at":  true,
+		"name":        true,
+		"email":       true,
+		"external_id": true,
+		"team_id":     true,
+	}
+	order := "created_at DESC"
+	if params.OrderField != "" && allowedOrderFields[params.OrderField] {
+		dir := "ASC"
+		if strings.EqualFold(params.OrderDir, "desc") {
+			dir = "DESC"
+		}
+		order = fmt.Sprintf("%s %s", params.OrderField, dir)
+	}
+
+	limit := params.Limit
+	if limit <= 0 || limit > 200 {
+		limit = 50
+	}
+	offset := params.Offset
+	if offset < 0 {
+		offset = 0
+	}
+
+	var users []tables.TableUser
+	if err := baseQuery.
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Order(order).
+		Limit(limit).
+		Offset(offset).
+		Find(&users).Error; err != nil {
+		return nil, 0, err
+	}
+	return users, totalCount, nil
+}
+
+// UpdateUser replaces the user row. The caller is expected to have read the
+// existing row, applied changes, and passed the result in.
+func (s *RDBConfigStore) UpdateUser(ctx context.Context, user *tables.TableUser, tx ...*gorm.DB) error {
+	var txDB *gorm.DB
+	if len(tx) > 0 {
+		txDB = tx[0]
+	} else {
+		txDB = s.DB()
+	}
+	if err := txDB.WithContext(ctx).Save(user).Error; err != nil {
+		return s.parseGormError(err)
+	}
+	return nil
+}
+
+// DeleteUser removes a user and all governance state owned by it. The
+// AddColumn migration that introduced governance_budgets.user_id did not
+// install an OnDelete:CASCADE FK constraint (the GORM struct tag is
+// informational for the migration only), so budgets must be deleted
+// explicitly here. VKs that referenced this user have their user_id nulled
+// out; the user's rate-limit row (if any) is removed separately.
+func (s *RDBConfigStore) DeleteUser(ctx context.Context, id string) error {
+	if err := s.DB().WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		var user tables.TableUser
+		if err := dbForUpdate(tx.WithContext(ctx)).Where("id = ?", id).First(&user).Error; err != nil {
+			if errors.Is(err, gorm.ErrRecordNotFound) {
+				return ErrNotFound
+			}
+			return err
+		}
+		rateLimitID := user.RateLimitID
+		// Delete budgets owned by this user. No FK constraint exists in the
+		// schema, so DB-side cascade would silently no-op.
+		if err := tx.WithContext(ctx).Delete(&tables.TableBudget{}, "user_id = ?", id).Error; err != nil {
+			return err
+		}
+		if err := tx.WithContext(ctx).
+			Model(&tables.TableVirtualKey{}).
+			Where("user_id = ?", id).
+			Update("user_id", nil).Error; err != nil {
+			return err
+		}
+		if err := tx.WithContext(ctx).Delete(&tables.TableUser{}, "id = ?", id).Error; err != nil {
+			return err
+		}
+		if rateLimitID != nil {
+			if err := tx.WithContext(ctx).Delete(&tables.TableRateLimit{}, "id = ?", *rateLimitID).Error; err != nil {
+				return err
+			}
+		}
+		return nil
+	}); err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return ErrNotFound
+		}
+		return err
+	}
+	return nil
+}
