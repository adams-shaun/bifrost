-	if len(virtualKeys) == 0 && len(teams) == 0 && len(customers) == 0 && len(budgets) == 0 && len(rateLimits) == 0 && len(modelConfigs) == 0 && len(providers) == 0 && len(governanceConfigs) == 0 && len(routingRules) == 0 && len(pricingOverrides) == 0 {
+	if len(virtualKeys) == 0 && len(teams) == 0 && len(users) == 0 && len(customers) == 0 && len(budgets) == 0 && len(rateLimits) == 0 && len(modelConfigs) == 0 && len(providers) == 0 && len(governanceConfigs) == 0 && len(routingRules) == 0 && len(pricingOverrides) == 0 {
 		return nil, nil
 	}
 	var authConfig *AuthConfig
@@ -4220,6 +4224,7 @@ func (s *RDBConfigStore) GetGovernanceConfig(ctx context.Context) (*GovernanceCo
 	return &GovernanceConfig{
 		VirtualKeys:      virtualKeys,
 		Teams:            teams,
+		Users:            users,
 		Customers:        customers,
 		Budgets:          budgets,
 		RateLimits:       rateLimits,
@@ -5314,3 +5319,19 @@ func (s *RDBConfigStore) DeleteUser(ctx context.Context, id string) error {
 	}
 	return nil
 }
+
+// GetUsers retrieves all users from the database with their relationships
+// (team, budgets, rate limit) preloaded. Used by the governance plugin's
+// cold reload path.
+func (s *RDBConfigStore) GetUsers(ctx context.Context) ([]tables.TableUser, error) {
+	var users []tables.TableUser
+	if err := s.DB().WithContext(ctx).
+		Preload("Team").
+		Preload("Budgets").
+		Preload("RateLimit").
+		Order("created_at ASC").
+		Find(&users).Error; err != nil {
+		return nil, err
+	}
+	return users, nil
+}
