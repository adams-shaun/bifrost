From 02a50db429935b5b4a911b16f3c1657f1d6d903e Mon Sep 17 00:00:00 2001
From: Shaun Adams <s.adams@f5.com>
Date: Fri, 5 Jun 2026 00:57:56 -0600
Subject: [PATCH] feat(governance): disable FK constraint creation on migrate

Sets DisableForeignKeyConstraintWhenMigrating on the postgres and sqlite
configstore connections. patch1 gives TableVirtualKey an FK to
governance_users, but that table is created by a later-numbered migration,
so a fresh-DB boot fails with: relation "governance_users" does not exist
(SQLSTATE 42P01). Governance is enforced in-app, so DB-level FKs are not
needed.
---
 framework/configstore/postgres.go | 7 +++++++
 framework/configstore/sqlite.go   | 4 ++++
 2 files changed, 11 insertions(+)

diff --git a/framework/configstore/postgres.go b/framework/configstore/postgres.go
index ef6ba0eb1..c851f17d3 100644
--- a/framework/configstore/postgres.go
+++ b/framework/configstore/postgres.go
@@ -34,6 +34,13 @@ func buildPostgresDSN(config *PostgresConfig) string {
 func openPostresConnection(dsn string, logger schemas.Logger) (*gorm.DB, error) {
 	return gorm.Open(postgres.New(postgres.Config{DSN: dsn}), &gorm.Config{
 		Logger: newGormLogger(logger),
+		// Governance is enforced in-app, not via DB foreign keys. Disabling
+		// constraint creation on migrate avoids ordering hazards when a model
+		// gains an FK to a table created by a later-numbered migration (e.g.
+		// TableVirtualKey.User -> governance_users, where the users table is
+		// added after the initial schema). Without this, a fresh-DB boot fails
+		// with: relation "governance_users" does not exist.
+		DisableForeignKeyConstraintWhenMigrating: true,
 	})
 }
 
diff --git a/framework/configstore/sqlite.go b/framework/configstore/sqlite.go
index 9482801d0..64091c4c3 100644
--- a/framework/configstore/sqlite.go
+++ b/framework/configstore/sqlite.go
@@ -29,6 +29,10 @@ func newSqliteConfigStore(ctx context.Context, config *SQLiteConfig, logger sche
 	logger.Debug("opening DB with dsn: %s", dsn)
 	db, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{
 		Logger: newGormLogger(logger),
+		// Governance is enforced in-app, not via DB foreign keys; disable
+		// constraint creation on migrate to avoid cross-migration FK ordering
+		// hazards (see postgres.go for the governance_users case).
+		DisableForeignKeyConstraintWhenMigrating: true,
 	})
 
 	if err != nil {
