From e86b0a7d28c3d7a3921ce97087a362aa88b95fd3 Mon Sep 17 00:00:00 2001
From: Sanju Abraham <s.abraham@f5.com>
Date: Wed, 27 May 2026 23:57:25 -0700
Subject: [PATCH 1/8] feat(governance): add TableUser as first-class governance
 entity

Adds governance_users table. Mirrors TableTeam shape with the addition
of Email and ExternalID (IdP sub-claim), and an optional TeamID FK so
users can belong to a team.

This patch only adds the type definition. Migrations and store wiring
are in subsequent patches.
---
 framework/configstore/tables/user.go | 104 +++++++++++++++++++++++++++
 1 file changed, 104 insertions(+)
 create mode 100644 framework/configstore/tables/user.go

diff --git a/framework/configstore/tables/user.go b/framework/configstore/tables/user.go
new file mode 100644
index 000000000..52cd469cb
--- /dev/null
+++ b/framework/configstore/tables/user.go
@@ -0,0 +1,104 @@
+package tables
+
+import (
+	"encoding/json"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+// TableUser represents a user entity with budget, rate limit, and optional
+// team association. Users are governance peers of teams and customers — a
+// virtual key may be pinned to a user, and user-level budgets/rate-limits
+// are evaluated independently of team and customer limits.
+type TableUser struct {
+	ID          string  `gorm:"primaryKey;type:varchar(255)" json:"id"`
+	Name        string  `gorm:"type:varchar(255);not null;uniqueIndex" json:"name"`
+	Email       string  `gorm:"type:varchar(255);index" json:"email,omitempty"`
+	ExternalID  string  `gorm:"type:varchar(255);index" json:"external_id,omitempty"` // IdP sub-claim or SCIM external ID
+	TeamID      *string `gorm:"type:varchar(255);index" json:"team_id,omitempty"`      // A user can belong to at most one team
+	RateLimitID *string `gorm:"type:varchar(255);index" json:"rate_limit_id,omitempty"`
+
+	// Relationships
+	Team        *TableTeam        `gorm:"foreignKey:TeamID" json:"team,omitempty"`
+	Budgets     []TableBudget     `gorm:"foreignKey:UserID;constraint:OnDelete:CASCADE" json:"budgets,omitempty"` // Multiple budgets with different reset intervals
+	RateLimit   *TableRateLimit   `gorm:"foreignKey:RateLimitID" json:"rate_limit,omitempty"`
+	VirtualKeys []TableVirtualKey `gorm:"foreignKey:UserID" json:"virtual_keys,omitempty"`
+
+	// Computed (not a DB column) — populated via correlated subquery in query layer, hence no migration
+	VirtualKeyCount int64 `gorm:"->;-:migration" json:"virtual_key_count"`
+
+	Profile       *string        `gorm:"type:text" json:"-"`
+	ParsedProfile map[string]any `gorm:"-" json:"profile"`
+
+	Config       *string        `gorm:"type:text" json:"-"`
+	ParsedConfig map[string]any `gorm:"-" json:"config"`
+
+	Claims       *string        `gorm:"type:text" json:"-"`
+	ParsedClaims map[string]any `gorm:"-" json:"claims"`
+
+	// Config hash is used to detect the changes synced from config.json file.
+	// Every time we sync the config.json file, we update the config hash.
+	ConfigHash string `gorm:"type:varchar(255);null" json:"config_hash"`
+
+	CreatedAt time.Time `gorm:"index;not null" json:"created_at"`
+	UpdatedAt time.Time `gorm:"index;not null" json:"updated_at"`
+}
+
+// TableName sets the table name for the user model
+func (TableUser) TableName() string { return "governance_users" }
+
+// BeforeSave hook for TableUser to serialize JSON fields
+func (u *TableUser) BeforeSave(tx *gorm.DB) error {
+	if u.ParsedProfile != nil {
+		data, err := json.Marshal(u.ParsedProfile)
+		if err != nil {
+			return err
+		}
+		s := string(data)
+		u.Profile = &s
+	} else {
+		u.Profile = nil
+	}
+	if u.ParsedConfig != nil {
+		data, err := json.Marshal(u.ParsedConfig)
+		if err != nil {
+			return err
+		}
+		s := string(data)
+		u.Config = &s
+	} else {
+		u.Config = nil
+	}
+	if u.ParsedClaims != nil {
+		data, err := json.Marshal(u.ParsedClaims)
+		if err != nil {
+			return err
+		}
+		s := string(data)
+		u.Claims = &s
+	} else {
+		u.Claims = nil
+	}
+	return nil
+}
+
+// AfterFind hook for TableUser to deserialize JSON fields
+func (u *TableUser) AfterFind(tx *gorm.DB) error {
+	if u.Profile != nil {
+		if err := json.Unmarshal([]byte(*u.Profile), &u.ParsedProfile); err != nil {
+			return err
+		}
+	}
+	if u.Config != nil {
+		if err := json.Unmarshal([]byte(*u.Config), &u.ParsedConfig); err != nil {
+			return err
+		}
+	}
+	if u.Claims != nil {
+		if err := json.Unmarshal([]byte(*u.Claims), &u.ParsedClaims); err != nil {
+			return err
+		}
+	}
+	return nil
+}
