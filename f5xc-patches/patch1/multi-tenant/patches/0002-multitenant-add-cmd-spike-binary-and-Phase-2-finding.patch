+// Command spike exercises the multitenant.Manager against a small number of
+// fake tenants and reports cold-start latency, steady-state memory cost per
+// tenant, and LRU eviction behavior.
+//
+// This is NOT a benchmark. Numbers are indicative; don't quote them as SLAs.
+// Run with:
+//
+//	cd multitenant && go run ./cmd/spike
+//
+// What the spike measures:
+//
+//  1. Cold-start latency: time from Acquire(tid) to a usable Handle, including
+//     the bifrost.Init call (worker goroutines, MCP manager, provider clients).
+//  2. Steady-state memory: heap delta after N tenants are warm, divided by N.
+//     This is the per-tenant residency cost.
+//  3. LRU eviction: with MaxActiveRuntimes=K, acquiring K+1 tenants must evict
+//     the LRU; we verify the eviction happens and measure its latency.
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"runtime"
+	"time"
+
+	bifrost "github.com/maximhq/bifrost/core"
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/maximhq/bifrost/multitenant"
+)
+
+// makeStaticAccount returns a per-tenant Account configured with a single
+// provider (OpenAI) using a fake key. The provider is intentionally throttled
+// to small concurrency/buffer so the spike models a tuned multi-tenant
+// deployment rather than the default-everything ceiling.
+func makeStaticAccount(tid multitenant.TenantID) *multitenant.StaticAccount {
+	acct := multitenant.NewStaticAccount(tid)
+	cfg := &schemas.ProviderConfig{
+		NetworkConfig: schemas.DefaultNetworkConfig,
+		ConcurrencyAndBufferSize: schemas.ConcurrencyAndBufferSize{
+			Concurrency: 4,
+			BufferSize:  16,
+		},
+	}
+	keys := []schemas.Key{{
+		ID:     fmt.Sprintf("k-%s-1", tid),
+		Name:   "fake",
+		Value:  *schemas.NewEnvVar(fmt.Sprintf("fake-key-for-%s", tid)),
+		Models: schemas.WhiteList{"*"},
+		Weight: 1.0,
+	}}
+	acct.AddProvider(schemas.OpenAI, keys, cfg)
+	return acct
+}
+
+// loader is the TenantLoader the Manager calls on first Acquire of a tenant.
+// Production impl will load from Postgres; here it builds in-process.
+func loader(_ context.Context, tid multitenant.TenantID) (schemas.BifrostConfig, error) {
+	return schemas.BifrostConfig{
+		Account:         makeStaticAccount(tid),
+		InitialPoolSize: 32, // tiny pool — multi-tenant deployments tune this down
+		Logger:          bifrost.NewDefaultLogger(schemas.LogLevelWarn),
+	}, nil
+}
+
+// heapBytes returns current resident heap size after a GC cycle so the
+// measurement is comparable across snapshots.
+func heapBytes() uint64 {
+	runtime.GC()
+	runtime.GC()
+	var m runtime.MemStats
+	runtime.ReadMemStats(&m)
+	return m.HeapAlloc
+}
+
+// goroutines is a coarse proxy for "how many workers does each tenant spawn?"
+func goroutines() int { return runtime.NumGoroutine() }
+
+func human(b uint64) string {
+	const k = 1024
+	switch {
+	case b >= k*k*k:
+		return fmt.Sprintf("%.2f GiB", float64(b)/float64(k*k*k))
+	case b >= k*k:
+		return fmt.Sprintf("%.2f MiB", float64(b)/float64(k*k))
+	case b >= k:
+		return fmt.Sprintf("%.2f KiB", float64(b)/float64(k))
+	}
+	return fmt.Sprintf("%d B", b)
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintf(os.Stderr, "spike: %v\n", err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	const (
+		warmCount        = 5 // how many tenants to load for steady-state measurement
+		maxActive        = 3 // small cap so we observe eviction
+		evictionTrigger  = 4 // > maxActive
+		coldStartSamples = 5 // samples for cold-start latency
+	)
+
+	resolver := multitenant.NewMemoryVKResolver(map[string]multitenant.TenantID{
+		"sk-bf-acme":   "acme",
+		"sk-bf-globex": "globex",
+		"sk-bf-initech": "initech",
+		"sk-bf-umbrella": "umbrella",
+		"sk-bf-stark":  "stark",
+	})
+	cached := multitenant.NewCachedVKResolver(resolver, 60*time.Second)
+
+	mgr, err := multitenant.NewManager(ctx, multitenant.ManagerConfig{
+		Loader:            loader,
+		MaxActiveRuntimes: maxActive,
+		Logger:            bifrost.NewDefaultLogger(schemas.LogLevelWarn),
+	})
+	if err != nil {
+		return fmt.Errorf("NewManager: %w", err)
+	}
+
+	fmt.Println("=== Bifrost multi-tenant spike ===")
+	fmt.Printf("warmCount=%d  maxActive=%d  provider concurrency=4 buffer=16  pool=32\n\n",
+		warmCount, maxActive)
+
+	// Section 1: Cold-start latency over N distinct tenants.
+	// Each Acquire is a first-touch (no cache), so we capture worst-case Init.
+	fmt.Println("[1] Cold-start latency (Acquire → bifrost.Init)")
+	baselineHeap := heapBytes()
+	baselineGo := goroutines()
+	fmt.Printf("    baseline heap: %s  goroutines: %d\n", human(baselineHeap), baselineGo)
+
+	// Release each handle immediately so the LRU can evict on the next Acquire.
+	// We want to measure cold-start, not block on eviction drain.
+	for i := 0; i < coldStartSamples; i++ {
+		tid := multitenant.TenantID(fmt.Sprintf("cold-%02d", i))
+		t0 := time.Now()
+		h, err := mgr.Acquire(ctx, tid)
+		dt := time.Since(t0)
+		if err != nil {
+			return fmt.Errorf("Acquire(%s): %w", tid, err)
+		}
+		fmt.Printf("    tenant=%s  acquire=%v  active=%d\n", tid, dt, mgr.ActiveRuntimes())
+		h.Release()
+	}
+	// Tear them all down so they don't pollute the steady-state measurement.
+	for i := 0; i < coldStartSamples; i++ {
+		mgr.Evict(multitenant.TenantID(fmt.Sprintf("cold-%02d", i)))
+	}
+
+	// Section 2: Steady-state memory cost per tenant.
+	fmt.Println("\n[2] Steady-state memory per tenant")
+	preLoadHeap := heapBytes()
+	preLoadGo := goroutines()
+	fmt.Printf("    pre-load heap: %s  goroutines: %d\n", human(preLoadHeap), preLoadGo)
+
+	// Loading warmCount tenants will exceed maxActive=3, so we observe eviction
+	// on every Acquire past the third. Hold handles to keep them resident.
+	tenantsForLoad := []multitenant.TenantID{"acme", "globex", "initech"}
+	var heldHandles []*multitenant.Handle
+	for _, tid := range tenantsForLoad {
+		h, err := mgr.Acquire(ctx, tid)
+		if err != nil {
+			return fmt.Errorf("Acquire(%s): %w", tid, err)
+		}
+		heldHandles = append(heldHandles, h)
+	}
+
+	postLoadHeap := heapBytes()
+	postLoadGo := goroutines()
+	deltaHeap := int64(postLoadHeap) - int64(preLoadHeap)
+	deltaGo := postLoadGo - preLoadGo
+	perTenantHeap := deltaHeap / int64(len(tenantsForLoad))
+	perTenantGo := deltaGo / len(tenantsForLoad)
+	fmt.Printf("    post-load heap: %s  goroutines: %d  (held %d tenants)\n",
+		human(postLoadHeap), postLoadGo, len(tenantsForLoad))
+	fmt.Printf("    delta heap: %s  delta goroutines: %d\n", human(uint64(deltaHeap)), deltaGo)
+	fmt.Printf("    per-tenant heap (avg): %s\n", human(uint64(perTenantHeap)))
+	fmt.Printf("    per-tenant goroutines (avg): %d\n", perTenantGo)
+
+	// Section 3: LRU eviction trigger.
+	fmt.Println("\n[3] LRU eviction (load tenant #4 with cap=3)")
+	// Release the oldest held handle so it becomes evictable.
+	heldHandles[0].Release()
+	heldHandles = heldHandles[1:]
+	fourth := multitenant.TenantID("umbrella")
+	t0 := time.Now()
+	h4, err := mgr.Acquire(ctx, fourth)
+	dt := time.Since(t0)
+	if err != nil {
+		return fmt.Errorf("Acquire(umbrella): %w", err)
+	}
+	heldHandles = append(heldHandles, h4)
+	fmt.Printf("    acquired umbrella in %v  active=%d (expected %d)\n",
+		dt, mgr.ActiveRuntimes(), maxActive)
+
+	// Section 4: VK→tenant resolver overhead (cached vs uncached).
+	fmt.Println("\n[4] VK resolver overhead")
+	vk := "sk-bf-acme"
+	// Warm the cache.
+	if _, err := cached.ResolveVK(ctx, vk); err != nil {
+		return fmt.Errorf("warm resolve: %w", err)
+	}
+	const resolverIters = 100_000
+	t0 = time.Now()
+	for i := 0; i < resolverIters; i++ {
+		if _, err := cached.ResolveVK(ctx, vk); err != nil {
+			return fmt.Errorf("cached resolve: %w", err)
+		}
+	}
+	cachedAvg := time.Since(t0) / resolverIters
+	t0 = time.Now()
+	for i := 0; i < resolverIters; i++ {
+		if _, err := resolver.ResolveVK(ctx, vk); err != nil {
+			return fmt.Errorf("uncached resolve: %w", err)
+		}
+	}
+	uncachedAvg := time.Since(t0) / resolverIters
+	fmt.Printf("    cached:   %v / lookup  (%d iters)\n", cachedAvg, resolverIters)
+	fmt.Printf("    uncached: %v / lookup  (%d iters)\n", uncachedAvg, resolverIters)
+
+	// Section 5: Graceful shutdown.
+	fmt.Println("\n[5] Graceful shutdown")
+	for _, h := range heldHandles {
+		h.Release()
+	}
+	t0 = time.Now()
+	if err := mgr.Shutdown(ctx); err != nil {
+		return fmt.Errorf("Shutdown: %w", err)
+	}
+	fmt.Printf("    Shutdown took %v  active=%d\n", time.Since(t0), mgr.ActiveRuntimes())
+
+	finalHeap := heapBytes()
+	finalGo := goroutines()
+	fmt.Printf("    final heap: %s  goroutines: %d  (baseline %s / %d)\n",
+		human(finalHeap), finalGo, human(baselineHeap), baselineGo)
+
+	return nil
+}
