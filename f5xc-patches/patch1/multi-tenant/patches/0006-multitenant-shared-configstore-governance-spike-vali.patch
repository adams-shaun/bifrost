+// Command spike-shared measures per-tenant cost when the governance plugin
+// is constructed per-tenant but shares a single configstore (Postgres/SQLite)
+// across all tenants — the realistic Phase 1 design.
+//
+// This is a stripped-down variant of cmd/spike: it skips the multi-section
+// flow so the heap measurement is uncontaminated by prior sections' tear-down
+// residue. Run with:
+//
+//	cd multitenant && go run ./cmd/spike-shared
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"time"
+
+	bifrost "github.com/maximhq/bifrost/core"
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/maximhq/bifrost/framework/configstore"
+	"github.com/maximhq/bifrost/multitenant"
+	"github.com/maximhq/bifrost/plugins/governance"
+)
+
+func heapBytes() uint64 {
+	runtime.GC()
+	runtime.GC()
+	var m runtime.MemStats
+	runtime.ReadMemStats(&m)
+	return m.HeapAlloc
+}
+
+func human(b uint64) string {
+	const k = 1024
+	switch {
+	case b >= k*k*k:
+		return fmt.Sprintf("%.2f GiB", float64(b)/float64(k*k*k))
+	case b >= k*k:
+		return fmt.Sprintf("%.2f MiB", float64(b)/float64(k*k))
+	case b >= k:
+		return fmt.Sprintf("%.2f KiB", float64(b)/float64(k))
+	}
+	return fmt.Sprintf("%d B", b)
+}
+
+func makeAccount(tid multitenant.TenantID) *multitenant.StaticAccount {
+	a := multitenant.NewStaticAccount(tid)
+	a.AddProvider(schemas.OpenAI,
+		[]schemas.Key{{
+			ID:     fmt.Sprintf("k-%s", tid),
+			Value:  *schemas.NewEnvVar(fmt.Sprintf("fake-%s", tid)),
+			Models: schemas.WhiteList{"*"},
+			Weight: 1.0,
+		}},
+		&schemas.ProviderConfig{
+			NetworkConfig: schemas.DefaultNetworkConfig,
+			ConcurrencyAndBufferSize: schemas.ConcurrencyAndBufferSize{
+				Concurrency: 4,
+				BufferSize:  16,
+			},
+		},
+	)
+	return a
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintf(os.Stderr, "spike-shared: %v\n", err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	logger := bifrost.NewDefaultLogger(schemas.LogLevelWarn)
+
+	dir, err := os.MkdirTemp("", "bf-spike-shared-*")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(dir)
+
+	// One ConfigStore for all tenants. Migrations run exactly once.
+	sharedStore, err := configstore.NewConfigStore(ctx, &configstore.Config{
+		Enabled: true,
+		Type:    configstore.ConfigStoreTypeSQLite,
+		Config:  &configstore.SQLiteConfig{Path: filepath.Join(dir, "shared.db")},
+	}, logger)
+	if err != nil {
+		return fmt.Errorf("shared configstore: %w", err)
+	}
+	defer sharedStore.Close(ctx)
+
+	loader := func(ctx context.Context, tid multitenant.TenantID) (schemas.BifrostConfig, error) {
+		plug, err := governance.Init(ctx, nil, logger, sharedStore, nil, nil, nil, nil)
+		if err != nil {
+			return schemas.BifrostConfig{}, err
+		}
+		return schemas.BifrostConfig{
+			Account:         makeAccount(tid),
+			InitialPoolSize: 32,
+			Logger:          logger,
+			LLMPlugins:      []schemas.LLMPlugin{plug},
+		}, nil
+	}
+
+	mgr, err := multitenant.NewManager(ctx, multitenant.ManagerConfig{
+		Loader:            loader,
+		MaxActiveRuntimes: 5,
+		Logger:            logger,
+	})
+	if err != nil {
+		return err
+	}
+
+	fmt.Println("=== Bifrost shared-configstore spike (governance + shared SQLite) ===")
+	preHeap := heapBytes()
+	preGo := runtime.NumGoroutine()
+	fmt.Printf("baseline heap: %s  goroutines: %d\n\n", human(preHeap), preGo)
+
+	tenants := []multitenant.TenantID{"alpha", "beta", "gamma", "delta", "epsilon"}
+	var handles []*multitenant.Handle
+	var coldFirst time.Duration
+	var coldRest time.Duration
+	for i, tid := range tenants {
+		t0 := time.Now()
+		h, err := mgr.Acquire(ctx, tid)
+		dt := time.Since(t0)
+		if err != nil {
+			return fmt.Errorf("Acquire(%s): %w", tid, err)
+		}
+		if i == 0 {
+			coldFirst = dt
+		} else {
+			coldRest += dt
+		}
+		fmt.Printf("tenant=%s  acquire=%v  active=%d\n", tid, dt, mgr.ActiveRuntimes())
+		handles = append(handles, h)
+	}
+	coldRestAvg := coldRest / time.Duration(len(tenants)-1)
+
+	postHeap := heapBytes()
+	postGo := runtime.NumGoroutine()
+	deltaHeap := int64(postHeap) - int64(preHeap)
+	deltaGo := postGo - preGo
+
+	fmt.Printf("\npost-load heap: %s  goroutines: %d  (held %d tenants)\n",
+		human(postHeap), postGo, len(handles))
+	fmt.Printf("delta heap: %s  delta goroutines: %d\n", human(uint64(deltaHeap)), deltaGo)
+	fmt.Printf("\ncold-start[0] (with migration): %v\n", coldFirst)
+	fmt.Printf("cold-start[1..N] avg:           %v\n", coldRestAvg)
+	fmt.Printf("\nper-tenant heap (avg of %d):    %s\n",
+		len(tenants), human(uint64(deltaHeap)/uint64(len(tenants))))
+	fmt.Printf("per-tenant heap (avg of N-1, subtracting shared overhead from first): %s\n",
+		human(uint64(deltaHeap-int64(coldFirst.Nanoseconds()/1000000))/uint64(len(tenants)-1)))
+	fmt.Printf("per-tenant goroutines (avg):    %d\n", deltaGo/len(tenants))
+
+	for _, h := range handles {
+		h.Release()
+	}
+	return mgr.Shutdown(ctx)
+}
