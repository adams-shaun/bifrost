+// spikeDataDir holds the per-tenant SQLite files created by loaderWithGovernance.
+// The directory is cleaned up at the end of the spike run. Each tenant gets its
+// own file — this models the maximum-isolation case (per-tenant DB) so we can
+// observe the FD + connection-pool cost. A shared-DB-with-tenant-id-scoping
+// design (likely what production will use) is cheaper than this measurement.
+var spikeDataDir string
+
+func ensureSpikeDataDir() error {
+	if spikeDataDir != "" {
+		return nil
+	}
+	d, err := os.MkdirTemp("", "bf-spike-*")
+	if err != nil {
+		return err
+	}
+	spikeDataDir = d
+	return nil
+}
+
+// loaderWithGovernance constructs a per-tenant governance plugin backed by a
+// per-tenant SQLite configstore. This is the heaviest plugin in the OSS bundle:
+// it runs schema migrations on first init, opens a GORM connection pool, holds
+// in-memory caches for VKs/customers/teams/budgets/rate-limits, and registers
+// background goroutines for budget resets.
+func loaderWithGovernance(ctx context.Context, tid multitenant.TenantID) (schemas.BifrostConfig, error) {
+	logger := bifrost.NewDefaultLogger(schemas.LogLevelWarn)
+	if err := ensureSpikeDataDir(); err != nil {
+		return schemas.BifrostConfig{}, fmt.Errorf("data dir: %w", err)
+	}
+	dbPath := filepath.Join(spikeDataDir, fmt.Sprintf("%s.db", tid))
+
+	store, err := configstore.NewConfigStore(ctx, &configstore.Config{
+		Enabled: true,
+		Type:    configstore.ConfigStoreTypeSQLite,
+		Config:  &configstore.SQLiteConfig{Path: dbPath},
+	}, logger)
+	if err != nil {
+		return schemas.BifrostConfig{}, fmt.Errorf("configstore.NewConfigStore for %s: %w", tid, err)
+	}
+
+	plug, err := governance.Init(
+		ctx,
+		nil,    // governance Config (uses defaults)
+		logger, // schemas.Logger
+		store,  // configstore.ConfigStore (persistent path; nil governanceConfig is OK here)
+		nil,    // *GovernanceConfig — ignored when configStore != nil
+		nil,    // *modelcatalog.ModelCatalog
+		nil,    // *mcpcatalog.MCPCatalog
+		nil,    // InMemoryStore
+	)
+	if err != nil {
+		return schemas.BifrostConfig{}, fmt.Errorf("governance.Init for %s: %w", tid, err)
+	}
+	return schemas.BifrostConfig{
+		Account:         makeStaticAccount(tid),
+		InitialPoolSize: 32,
+		Logger:          logger,
+		LLMPlugins:      []schemas.LLMPlugin{plug},
+	}, nil
+}
+
 // heapBytes returns current resident heap size after a GC cycle so the
 // measurement is comparable across snapshots.
 func heapBytes() uint64 {
@@ -302,16 +366,75 @@ func run() error {
 	fmt.Printf("    per-tenant goroutines (avg): %d\n", perTGo6)
 	fmt.Printf("    cold-start avg=%v  max=%v\n", plugColdSum/time.Duration(len(pluginTenants)), plugColdMax)
 
+	// Section 7: Steady-state cost WITH governance plugin (SQLite per tenant).
+	// Heaviest single plugin in the OSS bundle. We measure: cold-start (includes
+	// SQLite open + schema migration + GORM pool init), per-tenant heap, and
+	// per-tenant goroutines (governance starts background reset workers).
+	fmt.Println("\n[7] Steady-state memory per tenant — with governance plugin (SQLite)")
+	for _, h := range heldHandles {
+		h.Release()
+	}
+	heldHandles = heldHandles[:0]
+	if err := mgr2.Shutdown(ctx); err != nil {
+		return fmt.Errorf("Shutdown before governance pass: %w", err)
+	}
+	preHeap7 := heapBytes()
+	preGo7 := goroutines()
+	fmt.Printf("    pre-governance heap: %s  goroutines: %d\n", human(preHeap7), preGo7)
+
+	mgr3, err := multitenant.NewManager(ctx, multitenant.ManagerConfig{
+		Loader:            loaderWithGovernance,
+		MaxActiveRuntimes: maxActive,
+		Logger:            bifrost.NewDefaultLogger(schemas.LogLevelWarn),
+	})
+	if err != nil {
+		return fmt.Errorf("NewManager (with governance): %w", err)
+	}
+	defer func() {
+		if spikeDataDir != "" {
+			_ = os.RemoveAll(spikeDataDir)
+		}
+	}()
+
+	govTenants := []multitenant.TenantID{"g-alpha", "g-beta", "g-gamma"}
+	govColdMax := time.Duration(0)
+	govColdSum := time.Duration(0)
+	for _, tid := range govTenants {
+		t0 := time.Now()
+		h, err := mgr3.Acquire(ctx, tid)
+		dt := time.Since(t0)
+		if err != nil {
+			return fmt.Errorf("Acquire(%s) with governance: %w", tid, err)
+		}
+		govColdSum += dt
+		if dt > govColdMax {
+			govColdMax = dt
+		}
+		heldHandles = append(heldHandles, h)
+	}
+	postHeap7 := heapBytes()
+	postGo7 := goroutines()
+	dHeap7 := int64(postHeap7) - int64(preHeap7)
+	dGo7 := postGo7 - preGo7
+	perTHeap7 := dHeap7 / int64(len(govTenants))
+	perTGo7 := dGo7 / len(govTenants)
+	fmt.Printf("    post-governance heap: %s  goroutines: %d  (held %d)\n",
+		human(postHeap7), postGo7, len(govTenants))
+	fmt.Printf("    delta heap: %s  delta goroutines: %d\n", human(uint64(dHeap7)), dGo7)
+	fmt.Printf("    per-tenant heap (avg):       %s\n", human(uint64(perTHeap7)))
+	fmt.Printf("    per-tenant goroutines (avg): %d\n", perTGo7)
+	fmt.Printf("    cold-start avg=%v  max=%v\n", govColdSum/time.Duration(len(govTenants)), govColdMax)
+
 	// Section 5: Graceful shutdown.
 	fmt.Println("\n[5] Graceful shutdown")
 	for _, h := range heldHandles {
 		h.Release()
 	}
 	t0 = time.Now()
-	if err := mgr2.Shutdown(ctx); err != nil {
+	if err := mgr3.Shutdown(ctx); err != nil {
 		return fmt.Errorf("Shutdown: %w", err)
 	}
-	fmt.Printf("    Shutdown took %v  active=%d\n", time.Since(t0), mgr2.ActiveRuntimes())
+	fmt.Printf("    Shutdown took %v  active=%d\n", time.Since(t0), mgr3.ActiveRuntimes())
 
 	finalHeap := heapBytes()
 	finalGo := goroutines()
