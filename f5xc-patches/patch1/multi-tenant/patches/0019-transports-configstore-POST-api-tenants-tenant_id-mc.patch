+	def, err := store.GetMCPConfigByTenant(ctx, tables.DefaultTenantID)
+	require.NoError(t, err)
+	if def != nil {
+		assert.Empty(t, def.ClientConfigs, "default tenant must not see acme's MCP client")
+	}
+}
