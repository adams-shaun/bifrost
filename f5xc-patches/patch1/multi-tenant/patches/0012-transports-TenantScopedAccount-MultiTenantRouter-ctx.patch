index c4a3f93f6..2e854bc6e 100644
--- a/transports/bifrost-http/lib/account.go
+++ b/transports/bifrost-http/lib/account.go
@@ -7,6 +7,7 @@ import (
 	"fmt"
 
 	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/maximhq/bifrost/framework/configstore"
 )
 
 // BaseAccount implements the Account interface for Bifrost.
@@ -103,3 +104,108 @@ func (baseAccount *BaseAccount) GetConfigForProvider(providerKey schemas.ModelPr
