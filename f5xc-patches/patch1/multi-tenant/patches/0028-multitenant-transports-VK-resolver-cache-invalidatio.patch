diff --git a/multitenant/manager_test.go b/multitenant/manager_test.go
index 82f7385b0..5989d3f96 100644
--- a/multitenant/manager_test.go
+++ b/multitenant/manager_test.go
@@ -313,3 +313,84 @@ func TestNewManager_RejectsMissingLoader(t *testing.T) {
 		t.Fatalf("got %v want ErrLoaderRequired", err)
 	}
 }
+
+// countingResolver tallies ResolveVK calls so the invalidate tests can
+// prove a cache miss happens (or doesn't) without time.Sleep games.
+type countingResolver struct {
+	mapping map[string]TenantID
+	calls   int
+}
+
+func (r *countingResolver) ResolveVK(_ context.Context, vk string) (TenantID, error) {
+	r.calls++
+	tid, ok := r.mapping[vk]
+	if !ok {
+		return "", ErrUnknownVK
+	}
+	return tid, nil
+}
+
+func TestCachedVKResolver_InvalidateDropsCachedEntry(t *testing.T) {
+	backing := &countingResolver{mapping: map[string]TenantID{"sk-a": "alpha"}}
+	cached := NewCachedVKResolver(backing, 5*time.Minute)
+
+	// First call -> miss.
+	if _, err := cached.ResolveVK(context.Background(), "sk-a"); err != nil {
+		t.Fatal(err)
+	}
+	if backing.calls != 1 {
+		t.Fatalf("first ResolveVK should hit backing once; got %d", backing.calls)
+	}
+	// Second call -> hit, no new backing call.
+	if _, err := cached.ResolveVK(context.Background(), "sk-a"); err != nil {
+		t.Fatal(err)
+	}
+	if backing.calls != 1 {
+		t.Fatalf("second ResolveVK should hit cache; backing calls=%d want 1", backing.calls)
+	}
+
+	// Invalidate -> next call refetches.
+	cached.Invalidate("sk-a")
+	if _, err := cached.ResolveVK(context.Background(), "sk-a"); err != nil {
+		t.Fatal(err)
+	}
+	if backing.calls != 2 {
+		t.Fatalf("after Invalidate next ResolveVK should refetch; backing calls=%d want 2", backing.calls)
+	}
+}
+
+func TestCachedVKResolver_InvalidateEmpty_NoOp(t *testing.T) {
+	backing := &countingResolver{mapping: map[string]TenantID{"sk-a": "alpha"}}
+	cached := NewCachedVKResolver(backing, 5*time.Minute)
+
+	if _, err := cached.ResolveVK(context.Background(), "sk-a"); err != nil {
+		t.Fatal(err)
+	}
+	cached.Invalidate("")
+	// Still a hit.
+	if _, err := cached.ResolveVK(context.Background(), "sk-a"); err != nil {
+		t.Fatal(err)
+	}
+	if backing.calls != 1 {
+		t.Fatalf("empty Invalidate should be a no-op; backing calls=%d want 1", backing.calls)
+	}
+}
+
+func TestCachedVKResolver_InvalidateAll_DropsEverything(t *testing.T) {
+	backing := &countingResolver{mapping: map[string]TenantID{"sk-a": "alpha", "sk-b": "beta"}}
+	cached := NewCachedVKResolver(backing, 5*time.Minute)
+
+	for _, vk := range []string{"sk-a", "sk-b"} {
+		if _, err := cached.ResolveVK(context.Background(), vk); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if cached.CacheSize() != 2 {
+		t.Fatalf("CacheSize after two warm calls should be 2; got %d", cached.CacheSize())
+	}
+
+	cached.InvalidateAll()
+	if cached.CacheSize() != 0 {
+		t.Fatalf("CacheSize after InvalidateAll should be 0; got %d", cached.CacheSize())
+	}
+}
diff --git a/multitenant/resolver.go b/multitenant/resolver.go
index 1efa6d85f..32905b6d6 100644
--- a/multitenant/resolver.go
+++ b/multitenant/resolver.go
@@ -109,3 +109,32 @@ func (r *CachedVKResolver) CacheSize() int {
 	defer r.mu.RUnlock()
 	return len(r.cache)
 }
+
+// Invalidate drops a single VK from the cache. Same-process admin
+// mutations (VK create/update/delete) call this so the resolver picks
+// the new state up on the very next request rather than waiting for
+// the TTL. Idempotent: invalidating an absent VK is a no-op.
+//
+// In multi-replica deployments the OTHER replicas' caches still TTL
+// out the stale value within 60s; cross-replica invalidation is the
+// "versioned-invalidation header / LISTEN/NOTIFY" follow-on.
+func (r *CachedVKResolver) Invalidate(vk string) {
+	if vk == "" {
+		return
+	}
+	h := hashVK(vk)
+	r.mu.Lock()
+	delete(r.cache, h)
+	r.mu.Unlock()
+}
+
+// InvalidateAll drops every cached entry. Useful when a downstream
+// catastrophic event invalidates the entire VK<->tenant mapping (e.g.
+// a DB restore) and finer-grained signals aren't available.
+func (r *CachedVKResolver) InvalidateAll() {
+	r.mu.Lock()
+	for k := range r.cache {
+		delete(r.cache, k)
+	}
+	r.mu.Unlock()
+}
