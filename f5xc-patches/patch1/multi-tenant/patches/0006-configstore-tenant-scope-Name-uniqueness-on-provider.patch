diff --git a/framework/configstore/migrations.go b/framework/configstore/migrations.go
index 48d39f96e..e9055e713 100644
--- a/framework/configstore/migrations.go
+++ b/framework/configstore/migrations.go
@@ -805,6 +805,9 @@ func triggerMigrations(ctx context.Context, db *gorm.DB) error {
 	if err := migrationAddTenantIDToProviderConfigTables(ctx, db); err != nil {
 		return err
 	}
