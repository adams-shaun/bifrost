From e65f9b79e130fab56fecb1a7aa60d52740ef7c96 Mon Sep 17 00:00:00 2001
From: Sanju Abraham <s.abraham@f5.com>
Date: Fri, 29 May 2026 09:11:02 -0700
Subject: [PATCH 2/2] feat(governance): periodic refresh worker to close
 enforcement drift

Adds a 60s ticker in the existing tracker goroutine that calls
GovernanceStore.RefreshAllFromDB. For each in-memory budget /
rate-limit row, refresh pulls the DB-authoritative current_usage and
rebases the in-memory CurrentUsage to (DB value + locally-pending
delta), preserving any bump that landed between the last dump and the
refresh.

Pair with patch 0001:
  - Dump (10s): pushes this pod's delta to DB via UPDATE col = col + ?.
  - Refresh (60s): pulls cluster total from DB into in-memory counters.

The two together bound each pod's enforcement view to at-most
refreshInterval behind cluster reality instead of the multiplicative
drift (effective limit = N * max_limit) of purely local enforcement on
N pods.
---
 plugins/governance/store.go   | 156 ++++++++++++++++++++++++++++++++++
 plugins/governance/tracker.go |  50 +++++++----
 2 files changed, 190 insertions(+), 16 deletions(-)

diff --git a/plugins/governance/store.go b/plugins/governance/store.go
index 17ecb6cba..d1b780ea3 100644
--- a/plugins/governance/store.go
+++ b/plugins/governance/store.go
@@ -142,6 +142,10 @@ type GovernanceStore interface {
 	// Dump operations — DB-side increments, no gossip baselines needed.
 	DumpRateLimits(ctx context.Context) error
 	DumpBudgets(ctx context.Context) error
+	// RefreshAllFromDB rebases in-memory counters from the cluster total in
+	// the DB; called on a coarser cadence than the dump loop so dumps push
+	// each pod's contribution up and refresh pulls the cluster total back.
+	RefreshAllFromDB(ctx context.Context) error
 	// In-memory CRUD operations
 	CreateVirtualKeyInMemory(ctx context.Context, vk *configstoreTables.TableVirtualKey)
 	UpdateVirtualKeyInMemory(ctx context.Context, vk *configstoreTables.TableVirtualKey, budgetBaselines map[string]float64, rateLimitTokensBaselines map[string]int64, rateLimitRequestsBaselines map[string]int64)
@@ -1948,6 +1952,158 @@ func (gs *LocalGovernanceStore) DumpBudgets(ctx context.Context) error {
 	return nil
 }
 
+// RefreshAllFromDB pulls current_usage for every budget and rate-limit row
+// from the database and rebases the in-memory counters so this pod's view
+// of the cluster total includes peer pods' recently-dumped contributions.
+// Locally-pending deltas (CurrentUsage - LastDBUsages*) are preserved on
+// top of the freshly-read DB value, so a request that just bumped an
+// in-memory counter is not lost across a refresh.
+//
+// Pair with the delta-based dump (DumpRateLimits / DumpBudgets):
+//   - Dump: this-pod-delta → DB increment (push our share up).
+//   - Refresh: DB total → in-memory CurrentUsage + preserved local pending
+//     (pull cluster total down).
+//
+// The two together leave each pod's enforcement view at-most-one-refresh-
+// interval behind cluster reality, instead of the multiplicative drift
+// (effective limit = N × max) that comes from purely local enforcement.
+func (gs *LocalGovernanceStore) RefreshAllFromDB(ctx context.Context) error {
+	if gs.configStore == nil {
+		return nil
+	}
+	// TODO(scale): full-table SELECT every refresh cycle is fine at current
+	// row counts. At large deployments, paginate or filter by updated_at.
+	budgets, err := gs.configStore.GetBudgets(ctx)
+	if err != nil {
+		return fmt.Errorf("refresh: failed to load budgets: %w", err)
+	}
+	for i := range budgets {
+		b := &budgets[i]
+		gs.refreshBudgetFromDB(b.ID, b.CurrentUsage, b.LastReset)
+	}
+	rateLimits, err := gs.configStore.GetRateLimits(ctx)
+	if err != nil {
+		return fmt.Errorf("refresh: failed to load rate limits: %w", err)
+	}
+	for i := range rateLimits {
+		rl := &rateLimits[i]
+		gs.refreshRateLimitFromDB(rl.ID, rl.TokenCurrentUsage, rl.RequestCurrentUsage, rl.TokenLastReset, rl.RequestLastReset)
+	}
+	return nil
+}
+
+// refreshBudgetFromDB rebases one budget against the DB-authoritative
+// CurrentUsage. Preserves local pending (CurrentUsage - LastDB, floored at
+// 0) so a Bump that races our refresh isn't dropped, and adopts the DB's
+// LastReset if it's strictly newer so a peer-driven period rollover
+// propagates without our inline reset re-zeroing on the next Bump.
+func (gs *LocalGovernanceStore) refreshBudgetFromDB(budgetID string, dbValue float64, dbLastReset time.Time) {
+	gs.LastDBUsagesBudgetsMu.Lock()
+	defer gs.LastDBUsagesBudgetsMu.Unlock()
+	for {
+		raw, exists := gs.budgets.Load(budgetID)
+		if !exists || raw == nil {
+			// Not in local store — clean up any stale baseline rather than
+			// resurrecting it. (Either never loaded here, or just deleted.)
+			delete(gs.LastDBUsagesBudgets, budgetID)
+			return
+		}
+		old, ok := raw.(*configstoreTables.TableBudget)
+		if !ok || old == nil {
+			return
+		}
+		// Reset-race guard: local LastReset strictly newer than DB means a
+		// peer hasn't reset the DB row yet; pulling dbValue in would
+		// re-inflate this pod's just-zeroed counter.
+		if old.LastReset.After(dbLastReset) {
+			return
+		}
+		oldLastDB := gs.LastDBUsagesBudgets[budgetID]
+		pending := old.CurrentUsage - oldLastDB
+		if pending < 0 {
+			// Local reset moved CurrentUsage below baseline; treat as no
+			// pending and let the new period start from the DB total.
+			pending = 0
+		}
+		clone := *old
+		clone.CurrentUsage = dbValue + pending
+		if dbLastReset.After(old.LastReset) {
+			clone.LastReset = dbLastReset
+		}
+		if gs.budgets.CompareAndSwap(budgetID, raw, &clone) {
+			gs.LastDBUsagesBudgets[budgetID] = dbValue
+			return
+		}
+	}
+}
+
+// refreshRateLimitFromDB rebases one rate-limit row against the DB-
+// authoritative Token/RequestCurrentUsage. Same pending-preservation +
+// newer-LastReset-wins semantics as refreshBudgetFromDB; the token and
+// request counters move in a single CAS so callers never observe a torn
+// half-refreshed snapshot.
+func (gs *LocalGovernanceStore) refreshRateLimitFromDB(rateLimitID string, dbTokenUsage int64, dbRequestUsage int64, dbTokenLastReset time.Time, dbRequestLastReset time.Time) {
+	// Canonical lock order across the file: tokens-then-requests. Mirrors
+	// DumpRateLimits and ResetExpiredRateLimitsInMemory.
+	gs.LastDBUsagesRateLimitsTokensMu.Lock()
+	gs.LastDBUsagesRateLimitsRequestsMu.Lock()
+	defer gs.LastDBUsagesRateLimitsRequestsMu.Unlock()
+	defer gs.LastDBUsagesRateLimitsTokensMu.Unlock()
+	for {
+		raw, exists := gs.rateLimits.Load(rateLimitID)
+		if !exists || raw == nil {
+			delete(gs.LastDBUsagesTokensRateLimits, rateLimitID)
+			delete(gs.LastDBUsagesRequestsRateLimits, rateLimitID)
+			return
+		}
+		old, ok := raw.(*configstoreTables.TableRateLimit)
+		if !ok || old == nil {
+			return
+		}
+		// Per-counter reset-race guard: if our local LastReset is strictly
+		// newer than the DB's, the cluster hasn't yet reset the row — pulling
+		// dbValue back in would re-inflate the locally-reset counter. Hold
+		// the local value until a peer resets the DB row.
+		tokenStale := old.TokenLastReset.After(dbTokenLastReset)
+		requestStale := old.RequestLastReset.After(dbRequestLastReset)
+		if tokenStale && requestStale {
+			return
+		}
+		oldTokenLastDB := gs.LastDBUsagesTokensRateLimits[rateLimitID]
+		oldRequestLastDB := gs.LastDBUsagesRequestsRateLimits[rateLimitID]
+		tokenPending := old.TokenCurrentUsage - oldTokenLastDB
+		if tokenPending < 0 {
+			tokenPending = 0
+		}
+		requestPending := old.RequestCurrentUsage - oldRequestLastDB
+		if requestPending < 0 {
+			requestPending = 0
+		}
+		clone := *old
+		if !tokenStale {
+			clone.TokenCurrentUsage = dbTokenUsage + tokenPending
+			if dbTokenLastReset.After(old.TokenLastReset) {
+				clone.TokenLastReset = dbTokenLastReset
+			}
+		}
+		if !requestStale {
+			clone.RequestCurrentUsage = dbRequestUsage + requestPending
+			if dbRequestLastReset.After(old.RequestLastReset) {
+				clone.RequestLastReset = dbRequestLastReset
+			}
+		}
+		if gs.rateLimits.CompareAndSwap(rateLimitID, raw, &clone) {
+			if !tokenStale {
+				gs.LastDBUsagesTokensRateLimits[rateLimitID] = dbTokenUsage
+			}
+			if !requestStale {
+				gs.LastDBUsagesRequestsRateLimits[rateLimitID] = dbRequestUsage
+			}
+			return
+		}
+	}
+}
+
 // DATABASE METHODS
 
 // loadFromDatabase loads all governance data from the database into memory
diff --git a/plugins/governance/tracker.go b/plugins/governance/tracker.go
index ecc1b0451..79b7a3060 100644
--- a/plugins/governance/tracker.go
+++ b/plugins/governance/tracker.go
@@ -41,12 +41,19 @@ type UsageTracker struct {
 	trackerCtx    context.Context
 	trackerCancel context.CancelFunc
 	resetTicker   *time.Ticker
+	refreshTicker *time.Ticker
 	done          chan struct{}
 	wg            sync.WaitGroup
 }
 
 const (
 	workerInterval = 10 * time.Second
+	// refreshInterval controls how often each pod pulls cluster totals back
+	// from the DB into its in-memory counters. Longer than workerInterval
+	// because the refresh is the heavier of the two (full SELECT of all
+	// budgets + rate limits) and only needs to close the enforcement-drift
+	// gap; the delta dump already keeps the on-disk total correct.
+	refreshInterval = 60 * time.Second
 )
 
 // NewUsageTracker creates a new usage tracker for the hierarchical budget system
@@ -144,13 +151,17 @@ func (t *UsageTracker) UpdateUsage(ctx context.Context, update *UsageUpdate) {
 
 // startWorkers starts all background workers for business logic
 func (t *UsageTracker) startWorkers(ctx context.Context) {
-	// Counter reset manager (business logic)
 	t.resetTicker = time.NewTicker(workerInterval)
+	t.refreshTicker = time.NewTicker(refreshInterval)
 	t.wg.Add(1)
 	go t.resetWorker(ctx)
 }
 
-// resetWorker manages periodic resets of rate limit and usage counters
+// resetWorker manages periodic resets of rate limit and usage counters AND
+// the periodic refresh of in-memory counters from the database. Both ticks
+// share this single goroutine so they never interleave their LastDB
+// mutations with each other; concurrent request-path mutations on the
+// sync.Maps remain unaffected because they don't touch LastDBUsages*.
 func (t *UsageTracker) resetWorker(ctx context.Context) {
 	defer t.wg.Done()
 
@@ -159,6 +170,11 @@ func (t *UsageTracker) resetWorker(ctx context.Context) {
 		case <-t.resetTicker.C:
 			t.resetExpiredCounters(ctx)
 
+		case <-t.refreshTicker.C:
+			if err := t.store.RefreshAllFromDB(ctx); err != nil {
+				t.logger.Error("failed to refresh governance counters from DB: %v", err)
+			}
+
 		case <-t.done:
 			return
 		}
@@ -180,10 +196,10 @@ func (t *UsageTracker) resetExpiredCounters(ctx context.Context) {
 	}
 
 	// ==== PART 3: Dump all rate limits and budgets to database ====
-	if err := t.store.DumpRateLimits(ctx, nil, nil); err != nil {
+	if err := t.store.DumpRateLimits(ctx); err != nil {
 		t.logger.Error("failed to dump rate limits to database: %v", err)
 	}
-	if err := t.store.DumpBudgets(ctx, nil); err != nil {
+	if err := t.store.DumpBudgets(ctx); err != nil {
 		t.logger.Error("failed to dump budgets to database: %v", err)
 	}
 }
@@ -302,18 +318,10 @@ func (t *UsageTracker) PerformStartupResets(ctx context.Context) error {
 	return nil
 }
 
-// Cleanup stops all background workers and flushes pending operations
+// Cleanup stops all background workers and flushes pending operations.
+// Stop the resetWorker FIRST so the final flush below can't race it on
+// the LastDBUsages* mutexes (avoids ABBA hang on shutdown).
 func (t *UsageTracker) Cleanup() error {
-	// Final flush of in-memory deltas to DB before shutdown. Without this,
-	// any deltas accumulated since the last `workerInterval` tick are lost.
-	if err := t.store.DumpBudgets(context.Background(), nil); err != nil {
-		t.logger.Error("final budget dump on shutdown failed: %v", err)
-	}
-	if err := t.store.DumpRateLimits(context.Background(), nil, nil); err != nil {
-		t.logger.Error("final rate-limit dump on shutdown failed: %v", err)
-	}
-
-	// Stop background workers
 	if t.trackerCancel != nil {
 		t.trackerCancel()
 	}
@@ -321,9 +329,19 @@ func (t *UsageTracker) Cleanup() error {
 	if t.resetTicker != nil {
 		t.resetTicker.Stop()
 	}
-	// Wait for workers to finish
+	if t.refreshTicker != nil {
+		t.refreshTicker.Stop()
+	}
 	t.wg.Wait()
 
+	// Workers stopped; safe to flush any remaining in-memory deltas.
+	if err := t.store.DumpBudgets(context.Background()); err != nil {
+		t.logger.Error("final budget dump on shutdown failed: %v", err)
+	}
+	if err := t.store.DumpRateLimits(context.Background()); err != nil {
+		t.logger.Error("final rate-limit dump on shutdown failed: %v", err)
+	}
+
 	t.logger.Debug("usage tracker cleanup completed")
 	return nil
 }
