 plugins/governance/utils.go | 63 +++++++++++++++++++++++++++----------
 1 file changed, 46 insertions(+), 17 deletions(-)

diff --git a/plugins/governance/utils.go b/plugins/governance/utils.go
index 260cb62e6..6617d9634 100644
--- a/plugins/governance/utils.go
+++ b/plugins/governance/utils.go
@@ -10,49 +10,78 @@ import (
 	"github.com/valyala/fasthttp"
 )
 
-// ParseVirtualKeyFromFastHTTPRequest parses the virtual key from FastHTTP request headers.
+// VKIDHeader names the trusted virtual-key ID header. The ingress Envoy
+// MUST strip any client-supplied value and re-inject after JWT/OAuth
+// validation; this code path does no secret check on the ID path.
+const VKIDHeader = "X-Bifrost-VK-ID"
+
+// ParseVirtualKeyFromFastHTTPRequest parses VK identity from a FastHTTP
+// request. Two paths:
+//
+//	vkID    != ""  → trusted ID injected by Envoy (X-Bifrost-VK-ID header)
+//	vkValue != nil → plaintext sk-bf-... value the client supplied
+//
+// At most one is set. The ID path takes precedence; when it is present the
+// value-based headers are not consulted.
+//
 // Parameters:
 //   - req: The FastHTTP request containing headers to parse
 //
 // Returns:
-//   - *string: The virtual key if found, nil otherwise
-func ParseVirtualKeyFromFastHTTPRequest(req *fasthttp.RequestCtx) *string {
+//   - vkValue: The virtual key plaintext value if found, nil otherwise
+//   - vkID:    The trusted X-Bifrost-VK-ID header value if present
+func ParseVirtualKeyFromFastHTTPRequest(req *fasthttp.RequestCtx) (vkValue *string, vkID string) {
+	if id := string(req.Request.Header.Peek(VKIDHeader)); id != "" {
+		return nil, id
+	}
 	vkHeader := string(req.Request.Header.Peek("x-bf-vk"))
 	if vkHeader != "" && strings.HasPrefix(strings.ToLower(vkHeader), VirtualKeyPrefix) {
-		return bifrost.Ptr(vkHeader)
+		return bifrost.Ptr(vkHeader), ""
 	}
 	authHeader := string(req.Request.Header.Peek("Authorization"))
 	if authHeader != "" {
 		if strings.HasPrefix(strings.ToLower(authHeader), "bearer ") {
 			authHeaderValue := strings.TrimSpace(authHeader[7:]) // Remove "Bearer " prefix
 			if authHeaderValue != "" && strings.HasPrefix(strings.ToLower(authHeaderValue), VirtualKeyPrefix) {
-				return bifrost.Ptr(authHeaderValue)
+				return bifrost.Ptr(authHeaderValue), ""
 			}
 		}
 	}
 	xAPIKey := string(req.Request.Header.Peek("x-api-key"))
 	if xAPIKey != "" && strings.HasPrefix(strings.ToLower(xAPIKey), VirtualKeyPrefix) {
-		return bifrost.Ptr(xAPIKey)
+		return bifrost.Ptr(xAPIKey), ""
 	}
 	xGoogleAPIKey := string(req.Request.Header.Peek("x-goog-api-key"))
 	if xGoogleAPIKey != "" && strings.HasPrefix(strings.ToLower(xGoogleAPIKey), VirtualKeyPrefix) {
-		return bifrost.Ptr(xGoogleAPIKey)
+		return bifrost.Ptr(xGoogleAPIKey), ""
 	}
-	return nil
+	return nil, ""
 }
 
-// parseVirtualKeyFromHTTPRequest parses the virtual key from HTTP request headers.
