 	// Budget crud.
 	// UpsertBudgetConfig preserves in-memory CurrentUsage/LastReset on replacement —
 	// use it for every config publish (fresh load or admin edit) so a concurrent
diff --git a/transports/bifrost-http/handlers/governance.go b/transports/bifrost-http/handlers/governance.go
index 26a561e18..9970c76be 100644
--- a/transports/bifrost-http/handlers/governance.go
+++ b/transports/bifrost-http/handlers/governance.go
@@ -4307,10 +4307,13 @@ func validateRoutingFallbacks(fallbacks []string) error {
 func (h *GovernanceHandler) getVirtualKeyQuota(ctx *fasthttp.RequestCtx) {
 	// Extract virtual key using the same logic as the inference path (lib/ctx.go):
 	// x-bf-vk accepts any value; other headers require the sk-bf- prefix.
+	// This self-service endpoint is keyed by the sk-bf-... plaintext value
+	// only. The trusted ID path (X-Bifrost-VK-ID) is for the inference
+	// pipeline; skipping it here keeps the existing quota semantics.
 	var vkValue string
 	if v := string(ctx.Request.Header.Peek("x-bf-vk")); v != "" {
 		vkValue = v
-	} else if v := governance.ParseVirtualKeyFromFastHTTPRequest(ctx); v != nil {
+	} else if v, _ := governance.ParseVirtualKeyFromFastHTTPRequest(ctx); v != nil {
 		vkValue = *v
 	}
 	if vkValue == "" {
