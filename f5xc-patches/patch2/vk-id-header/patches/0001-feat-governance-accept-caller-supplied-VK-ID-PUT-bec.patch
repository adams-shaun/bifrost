From e9c49e6b3af313782392b84cfb9dd581cf617691 Mon Sep 17 00:00:00 2001
From: Sanju Abraham <s.abraham@f5.com>
Date: Thu, 28 May 2026 00:40:15 -0700
Subject: [PATCH 1/4] feat(governance): accept caller-supplied VK ID; PUT
 becomes upsert
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

(rebased — applies cleanly on top of user-support)
---
 .../bifrost-http/handlers/governance.go       | 60 ++++++++++++++++++-
 1 file changed, 58 insertions(+), 2 deletions(-)

diff --git a/transports/bifrost-http/handlers/governance.go b/transports/bifrost-http/handlers/governance.go
index ab683f9b9..26a561e18 100644
--- a/transports/bifrost-http/handlers/governance.go
+++ b/transports/bifrost-http/handlers/governance.go
@@ -3,6 +3,7 @@
 package handlers
 
 import (
+	"bytes"
 	"context"
 	"encoding/json"
 	"errors"
@@ -79,6 +80,12 @@ func NewGovernanceHandler(manager GovernanceManager, configStore configstore.Con
 
 // CreateVirtualKeyRequest represents the request body for creating a virtual key
 type CreateVirtualKeyRequest struct {
+	// ID is an optional caller-supplied virtual key ID. When set, the server
+	// stores the VK with this ID instead of generating a random UUID. This
+	// supports F5XC's deterministic VK ID derivation
+	// (sha256(tenantID:namespace[:userID])[:16]) used by the X-Bifrost-VK-ID
+	// header resolution path. When empty, a UUID is generated as before.
+	ID              string `json:"id,omitempty"`
 	Name            string `json:"name" validate:"required"`
 	Description     string `json:"description,omitempty"`
 	ProviderConfigs []struct {
@@ -410,7 +417,9 @@ func (h *GovernanceHandler) RegisterRoutes(r *router.Router, middlewares ...sche
 	r.POST("/api/governance/virtual-keys", lib.ChainMiddlewares(h.createVirtualKey, middlewares...))
 	r.POST("/api/governance/virtual-keys/rotate", lib.ChainMiddlewares(h.rotateVirtualKeys, middlewares...))
 	r.GET("/api/governance/virtual-keys/{vk_id}", lib.ChainMiddlewares(h.getVirtualKey, middlewares...))
-	r.PUT("/api/governance/virtual-keys/{vk_id}", lib.ChainMiddlewares(h.updateVirtualKey, middlewares...))
+	// PUT is upsert (create-or-update) — F5XC's reconcile loop calls PUT
+	// with a deterministic vk_id for every change.
+	r.PUT("/api/governance/virtual-keys/{vk_id}", lib.ChainMiddlewares(h.upsertVirtualKey, middlewares...))
 	r.POST("/api/governance/virtual-keys/{vk_id}/rotate", lib.ChainMiddlewares(h.rotateVirtualKey, middlewares...))
 	r.DELETE("/api/governance/virtual-keys/{vk_id}", lib.ChainMiddlewares(h.deleteVirtualKey, middlewares...))
 
@@ -656,10 +665,18 @@ func (h *GovernanceHandler) createVirtualKey(ctx *fasthttp.RequestCtx) {
 			return
 		}
 	}
+	// URL vk_id (set by upsertVirtualKey via ctx override) wins over req.ID,
+	// which wins over a generated UUID.
+	vkID := req.ID
+	if override, ok := ctx.UserValue(upsertVKIDOverride).(string); ok && override != "" {
+		vkID = override
+	} else if vkID == "" {
+		vkID = uuid.NewString()
+	}
 	var vk configstoreTables.TableVirtualKey
 	if err := h.configStore.ExecuteTransaction(ctx, func(tx *gorm.DB) error {
 		vk = configstoreTables.TableVirtualKey{
-			ID:              uuid.NewString(),
+			ID:              vkID,
 			Name:            req.Name,
 			Value:           governance.GenerateVirtualKey(),
 			Description:     req.Description,
@@ -1567,6 +1584,45 @@ func (h *GovernanceHandler) rotateVirtualKeyByID(ctx context.Context, vkID strin
 	return preloadedVk, nil
 }
 
+// upsertVKIDOverride carries the URL vk_id from upsertVirtualKey into
+// createVirtualKey so the create branch avoids a body round-trip.
+const upsertVKIDOverride = "upsert_vk_id_override"
+
+// upsertVirtualKey handles PUT /api/governance/virtual-keys/{vk_id} as
+// create-or-update. Create branch forwards the URL vk_id via ctx override;
+// update branch decodes with DisallowUnknownFields so Create-shaped bodies
+// on existing VKs 400 instead of silently dropping fields.
+func (h *GovernanceHandler) upsertVirtualKey(ctx *fasthttp.RequestCtx) {
+	vkID := ctx.UserValue("vk_id").(string)
+	if vkID == "" {
+		SendError(ctx, 400, "vk_id is required")
+		return
+	}
+
+	existing, err := h.configStore.GetVirtualKey(ctx, vkID)
+	if err != nil && !errors.Is(err, configstore.ErrNotFound) {
+		SendError(ctx, 500, "Failed to check virtual key existence")
+		return
+	}
+
+	if existing == nil {
+		ctx.SetUserValue(upsertVKIDOverride, vkID)
+		h.createVirtualKey(ctx)
+		return
+	}
+
+	if len(ctx.PostBody()) > 0 {
+		var probe UpdateVirtualKeyRequest
+		dec := json.NewDecoder(bytes.NewReader(ctx.PostBody()))
+		dec.DisallowUnknownFields()
+		if err := dec.Decode(&probe); err != nil {
+			SendError(ctx, 400, fmt.Sprintf("Invalid update body: %s", err.Error()))
+			return
+		}
+	}
+	h.updateVirtualKey(ctx)
+}
+
 // rotateVirtualKey handles POST /api/governance/virtual-keys/{vk_id}/rotate - Rotate only the virtual key value
 func (h *GovernanceHandler) rotateVirtualKey(ctx *fasthttp.RequestCtx) {
 	vkID := ctx.UserValue("vk_id").(string)
