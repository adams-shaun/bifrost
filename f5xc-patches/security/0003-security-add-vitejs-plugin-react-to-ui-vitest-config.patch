From 8d36c23d10e1974df9987069099e649c7aefff2d Mon Sep 17 00:00:00 2001
From: Shaun Adams <s.adams@f5.com>
Date: Wed, 3 Jun 2026 23:33:19 +0000
Subject: [PATCH] security: add @vitejs/plugin-react to ui vitest config
 (CVE-2026-47429 companion)

The vitest 4.1.0 bump (security/0002, CVE-2026-47429 9.8) is the patched
version, but vitest 4.1.x honors tsconfig "jsx": "preserve" and stops
transforming JSX in the test pipeline, so vite's import-analysis fails to parse
.tsx files imported by tests (ui/app/workspace/logs/views/columns.tsx). That
silently broke the UI vitest suite. Wiring the existing @vitejs/plugin-react
devDependency into vitest.config.ts restores the JSX transform.

Ref: https://jira.f5net.com/browse/XC-23532
---
 ui/vitest.config.ts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/ui/vitest.config.ts b/ui/vitest.config.ts
index 90d06efd4..c57ab0d4d 100644
--- a/ui/vitest.config.ts
+++ b/ui/vitest.config.ts
@@ -1,7 +1,13 @@
 import { defineConfig } from "vitest/config";
+import react from "@vitejs/plugin-react";
 import path from "path";
 
 export default defineConfig({
+	// Companion to the vitest 4.1.0 security bump (CVE-2026-47429, security/0002):
+	// vitest 4.1.x honors tsconfig `jsx: "preserve"` and leaves JSX untransformed,
+	// so vite's import-analysis fails on .tsx test imports (e.g. columns.test.ts).
+	// The react plugin restores JSX transform for the test pipeline.
+	plugins: [react()],
 	resolve: {
 		alias: {
 			"@": path.resolve(__dirname, "."),
-- 
2.43.0

