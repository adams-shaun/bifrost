From b445309941b68737069530c91447cd446e87bd88 Mon Sep 17 00:00:00 2001
From: Shaun Adams <s.adams@f5.com>
Date: Wed, 3 Jun 2026 23:46:48 +0000
Subject: [PATCH] security: pin flatted 3.4.0 -> 3.4.2 in
 tests/integrations/typescript (CVE-2026-33228)

flatted 3.4.0 (pulled transitively by @vitest/ui) is vulnerable to prototype
pollution via parse() (CVE-2026-33228, CVSS 9.8). The Mend/vuln-scan reads
node_modules/.../flatted/package.json from the base tree, so the fix lands in
the base package.json/lock as an npm override forcing flatted to 3.4.2 (the
patched release); this dedupes the nested @vitest/ui copy to 3.4.2.

Ref: https://jira.f5net.com/browse/XC-23532
---
 tests/integrations/typescript/package-lock.json | 7 -------
 tests/integrations/typescript/package.json      | 3 ++-
 2 files changed, 2 insertions(+), 8 deletions(-)

diff --git a/tests/integrations/typescript/package-lock.json b/tests/integrations/typescript/package-lock.json
index 81306ed6b..be587a07e 100644
--- a/tests/integrations/typescript/package-lock.json
+++ b/tests/integrations/typescript/package-lock.json
@@ -3319,13 +3319,6 @@
         "vitest": "4.1.0"
       }
     },
-    "node_modules/@vitest/ui/node_modules/flatted": {
-      "version": "3.4.0",
-      "resolved": "https://registry.npmjs.org/flatted/-/flatted-3.4.0.tgz",
-      "integrity": "sha512-kC6Bb+ooptOIvWj5B63EQWkF0FEnNjV2ZNkLMLZRDDduIiWeFF4iKnslwhiWxjAdbg4NzTNo6h0qLuvFrcx+Sw==",
-      "dev": true,
-      "license": "ISC"
-    },
     "node_modules/@vitest/utils": {
       "version": "4.1.0",
       "resolved": "https://registry.npmjs.org/@vitest/utils/-/utils-4.1.0.tgz",
diff --git a/tests/integrations/typescript/package.json b/tests/integrations/typescript/package.json
index 9038b81cc..c94bcc117 100644
--- a/tests/integrations/typescript/package.json
+++ b/tests/integrations/typescript/package.json
@@ -41,6 +41,7 @@
   },
   "overrides": {
     "uuid": "^14.0.0",
-    "fast-xml-parser": "^5.3.5"
+    "fast-xml-parser": "^5.3.5",
+    "flatted": "3.4.2"
   }
 }
-- 
