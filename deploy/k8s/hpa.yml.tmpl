# HorizontalPodAutoscaler for bifrost-aigw.
# Scales the single-replica deployment based on CPU/memory utilization.
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ default "bifrost-aigw" .bifrost_aigw_app_name }}
  namespace: {{ if .bifrost_aigw_namespace }}{{ .bifrost_aigw_namespace }}{{ else }}{{ if .namespace }}{{ .namespace }}{{ else }}ves-system{{ end }}{{ end }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ default "bifrost-aigw" .bifrost_aigw_app_name }}
  # Min/max replica bounds — defaults to 1-5
  minReplicas: 1
  maxReplicas: 2
  metrics:
    # Scale on CPU utilization — target 70% average across pods
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
    # Scale on memory utilization — target 80% average across pods
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80
  behavior:
    # Conservative scale-down to avoid thrashing during traffic spikes
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
      - type: Pods
        value: 1
        periodSeconds: 60

# vim: syntax=yaml
